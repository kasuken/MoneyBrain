{
  "DetailedErrors": false,
  "CacheSettings": {
    "Provider": "Redis",
    "Redis": {
      "ConnectionString": "${REDIS_CONNECTION_STRING}",
      "Database": 0,
      "InstanceName": "MoneyBrain",
      "SslEnabled": true,
      "ConnectTimeout": 5000,
      "SyncTimeout": 5000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Licensing": {
    "Enabled": true
  }
}
