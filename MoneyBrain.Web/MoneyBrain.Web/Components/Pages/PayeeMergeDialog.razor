@using MoneyBrain.Web.Application.Transactions.PayeeNormalization
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudText Class="mb-4">
            @((MarkupString)string.Format(L["PayeeDlg_MergeConfirm"], $"<strong>{TargetPayee?.Payee.Name}</strong>"))
        </MudText>

        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["PayeeDlg_PayeesToMerge"]</MudText>
        <MudList T="string" Dense>
            @foreach (var source in SourcePayees)
            {
                <MudListItem @key="source.Payee.Id" T="string">
                    <MudText>
                        @source.Payee.Name
                        <MudText Typo="Typo.caption" Inline>
                            (@string.Format(L["PayeeDlg_TransactionCount"], source.TransactionCount))
                        </MudText>
                    </MudText>
                </MudListItem>
            }
        </MudList>

        <MudAlert Severity="Severity.Info" Class="mt-4">
            @((MarkupString)string.Format(L["PayeeDlg_MergeInfo"], $"<strong>{TargetPayee?.Payee.Name}</strong>"))
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Confirm">@L["Btn_Merge"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public PayeeWithUsage? TargetPayee { get; set; }
    [Parameter] public List<PayeeWithUsage> SourcePayees { get; set; } = new();

    private void Confirm()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
