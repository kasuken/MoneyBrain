@page "/settings"
@using Microsoft.AspNetCore.Authorization
@using MoneyBrain.Web.Application.Settings

@attribute [Authorize]
@inject IUserSettingsService SettingsService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Settings | MoneyBrain</PageTitle>

<div class="mb-page mb-animate-in">
    <div class="mb-section-header">
        <div>
            <h1 class="mb-title">Settings</h1>
            <p class="mb-subtitle">Manage your preferences and display options</p>
        </div>
    </div>

    <div style="max-width: 600px;">
        <div class="mb-card">
            @if (_loading)
            {
                <SettingsLoader />
            }
            else
            {
                <MudForm @ref="_form" @bind-IsValid="@_formValid">
                    <MudStack Spacing="4">
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--mb-text-secondary); font-weight: 600;">
                                DISPLAY PREFERENCES
                            </MudText>
                        </div>
                        
                        <MudSelect T="string" 
                                   Label="Currency" 
                                   @bind-Value="_currencyCode"
                                   Required="true"
                                   RequiredError="Currency is required"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   HelperText="Used for displaying monetary values">
                            @foreach (var currency in _currencies)
                            {
                                <MudSelectItem T="string" Value="@currency.Code">
                                    @currency.Code - @currency.Name (@currency.Symbol)
                                </MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string"
                                   Label="Timezone"
                                   @bind-Value="_timeZoneId"
                                   Required="true"
                                   RequiredError="Timezone is required"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   HelperText="Used for displaying dates and times">
                            @foreach (var tz in _timeZones)
                            {
                                <MudSelectItem T="string" Value="@tz.Id">
                                    @tz.DisplayName
                                </MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string"
                                   Label="Date Format"
                                   @bind-Value="_dateFormat"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   HelperText="How dates are displayed throughout the app">
                            <MudSelectItem T="string" Value="@("yyyy-MM-dd")">2026-01-25 (ISO)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("MM/dd/yyyy")">01/25/2026 (US)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("dd/MM/yyyy")">25/01/2026 (EU)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("dd.MM.yyyy")">25.01.2026</MudSelectItem>
                        </MudSelect>

                        <MudDivider Class="my-2" />

                        <MudButton Variant="Variant.Filled"
                                   Class="mb-btn-primary"
                                   OnClick="SaveAsync"
                                   Disabled="@(!_formValid || _saving)"
                                   FullWidth="false">
                            @if (_saving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                            }
                            Save Changes
                        </MudButton>
                    </MudStack>
                </MudForm>
            }
        </div>

        <div class="mb-card mt-4">
            <MudStack Spacing="4">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--mb-text-secondary); font-weight: 600;">
                        DATA MANAGEMENT
                    </MudText>
                </div>
                
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    <MudText Typo="Typo.body2">
                        Erasing all data will permanently delete all your accounts, transactions, budgets, categories, and settings. 
                        This action cannot be undone.
                    </MudText>
                </MudAlert>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteForever"
                           OnClick="ShowEraseDataConfirmation"
                           Disabled="@_erasing">
                    @if (_erasing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                    }
                    Erase All Data
                </MudButton>

                <MudDivider Class="my-2" />

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    <MudText Typo="Typo.body2">
                        Load demo data to explore MoneyBrain with realistic sample accounts, transactions, and budgets.
                        This will add data without affecting any existing records.
                    </MudText>
                </MudAlert>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlaylistAdd"
                           OnClick="LoadDemoDataAsync"
                           Disabled="@_loadingDemo">
                    @if (_loadingDemo)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                    }
                    Load Demo Data
                </MudButton>
            </MudStack>
        </div>
    </div>
    
    <HelpButton Title="Settings Help"
                Description="Configure your personal preferences for MoneyBrain. These settings affect how data is displayed throughout the application."
                Features="@(new[] { 
                    "Currency format and symbol customization",
                    "Date format preferences",
                    "Default account selection",
                    "Display preferences and themes"
                })"
                HowToUse="@(new[] {
                    "Update any setting values as needed",
                    "Click 'Save Changes' to apply your preferences",
                    "Changes take effect immediately across the app"
                })"
                Tips="@(new[] {
                    "Currency settings affect display only, not actual values",
                    "Choose date formats that match your region",
                    "Settings are saved per user account"
                })" />
</div>

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _erasing;
    private bool _loadingDemo;
    private bool _formValid;
    private MudForm? _form;

    private string _currencyCode = "USD";
    private string _timeZoneId = TimeZoneInfo.Local.Id;
    private string _dateFormat = "yyyy-MM-dd";

    private IReadOnlyList<CurrencyInfo> _currencies = [];
    private IReadOnlyList<TimeZoneInfo> _timeZones = [];

    protected override async Task OnInitializedAsync()
    {
        _currencies = SettingsService.GetAvailableCurrencies();
        _timeZones = SettingsService.GetAvailableTimeZones();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            var settings = await SettingsService.GetSettingsAsync(userId);
            if (settings != null)
            {
                _currencyCode = settings.CurrencyCode;
                _timeZoneId = settings.TimeZoneId;
                _dateFormat = settings.DateFormat;
            }
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_form is null) return;

        await _form.Validate();
        if (!_formValid) return;

        _saving = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add("Unable to identify user", Severity.Error);
                return;
            }

            await SettingsService.SaveSettingsAsync(userId, _currencyCode, _timeZoneId, _dateFormat);
            Snackbar.Add("Settings saved successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving settings: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ShowEraseDataConfirmation()
    {
        // First confirmation
        var firstResult = await DialogService.ShowMessageBox(
            "Erase All Data?",
            "Are you sure you want to erase ALL your data? This includes accounts, transactions, budgets, categories, and settings. This action cannot be undone.",
            yesText: "Yes, continue",
            cancelText: "Cancel");

        if (firstResult != true)
            return;

        // Second confirmation - more explicit
        var secondResult = await DialogService.ShowMessageBox(
            "Final Confirmation",
            (MarkupString)"<strong>This is your last chance to cancel.</strong><br/><br/>All your financial data will be permanently deleted. You will need to set up MoneyBrain from scratch.<br/><br/>Are you absolutely sure?",
            yesText: "Yes, erase everything",
            cancelText: "No, keep my data");

        if (secondResult != true)
            return;

        await EraseAllDataAsync();
    }

    private async Task EraseAllDataAsync()
    {
        _erasing = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add("Unable to identify user", Severity.Error);
                return;
            }

            await SettingsService.EraseAllUserDataAsync(userId);
            Snackbar.Add("All data has been erased successfully", Severity.Success);

            // Reset local state
            _currencyCode = "USD";
            _timeZoneId = TimeZoneInfo.Local.Id;
            _dateFormat = "yyyy-MM-dd";

            // Redirect to homepage with full refresh to reset UI state
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error erasing data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _erasing = false;
        }
    }

    private async Task LoadDemoDataAsync()
    {
        var result = await DialogService.ShowMessageBox(
            "Load Demo Data?",
            "This will add sample accounts, transactions, categories, and budgets to help you explore MoneyBrain. Your existing data will not be affected.",
            yesText: "Load Demo Data",
            cancelText: "Cancel");

        if (result != true)
            return;

        _loadingDemo = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add("Unable to identify user", Severity.Error);
                return;
            }

            await SettingsService.LoadDemoDataAsync(userId);
            Snackbar.Add("Demo data loaded successfully! Check your accounts and transactions.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading demo data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingDemo = false;
        }
    }
}
