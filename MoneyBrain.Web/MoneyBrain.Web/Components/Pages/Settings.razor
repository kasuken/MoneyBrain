@page "/settings"
@using Microsoft.AspNetCore.Authorization
@using MoneyBrain.Web.Application.Settings
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Resources

@attribute [Authorize]
@inject IUserSettingsService SettingsService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Settings_PageTitle"] | MoneyBrain</PageTitle>

<div class="mb-page mb-animate-in">
    <div class="mb-section-header">
        <div>
            <h1 class="mb-title">@L["Settings_Title"]</h1>
            <p class="mb-subtitle">@L["Settings_Subtitle"]</p>
        </div>
    </div>

    <div style="max-width: 600px;">
        <div class="mb-card">
            @if (_loading)
            {
                <SettingsLoader />
            }
            else
            {
                <MudForm @ref="_form" @bind-IsValid="@_formValid">
                    <MudStack Spacing="4">
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--mb-text-secondary); font-weight: 600;">
                                @L["Settings_DisplayPreferences"]
                            </MudText>
                        </div>
                        
                        <MudSelect T="string" 
                                   Label="@L["Settings_Currency"]" 
                                   @bind-Value="_currencyCode"
                                   Required="true"
                                   RequiredError="@L["Val_CurrencyRequired"]"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   HelperText="@L["Settings_CurrencyHelper"]">
                            @foreach (var currency in _currencies)
                            {
                                <MudSelectItem T="string" Value="@currency.Code">
                                    @currency.Code - @currency.Name (@currency.Symbol)
                                </MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string"
                                   Label="@L["Settings_Timezone"]"
                                   @bind-Value="_timeZoneId"
                                   Required="true"
                                   RequiredError="@L["Val_TimezoneRequired"]"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   HelperText="@L["Settings_TimezoneHelper"]">
                            @foreach (var tz in _timeZones)
                            {
                                <MudSelectItem T="string" Value="@tz.Id">
                                    @tz.DisplayName
                                </MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string"
                                   Label="@L["Settings_DateFormat"]"
                                   @bind-Value="_dateFormat"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   HelperText="@L["Settings_DateFormatHelper"]">
                            <MudSelectItem T="string" Value="@("yyyy-MM-dd")">2026-01-25 (ISO)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("MM/dd/yyyy")">01/25/2026 (US)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("dd/MM/yyyy")">25/01/2026 (EU)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("dd.MM.yyyy")">25.01.2026</MudSelectItem>
                        </MudSelect>

                         <MudDivider Class="my-2" />

                        <div>
                            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--mb-text-secondary); font-weight: 600;">
                                @L["Settings_TipsInsights"]
                            </MudText>
                        </div>

                        <MudCheckBox T="bool" 
                                     @bind-Checked="_showTipsAndInsights" 
                                     Label="@L["Settings_ShowTipsAndInsights"]" 
                                     Color="Color.Primary" />
                        
                        <MudCheckBox T="bool" 
                                     @bind-Checked="_showEducationalTips" 
                                     Label="@L["Settings_ShowEducationalTips"]" 
                                     Color="Color.Primary"
                                     Disabled="@(!_showTipsAndInsights)" />
                        
                        <MudCheckBox T="bool" 
                                     @bind-Checked="_showSpendingInsights" 
                                     Label="@L["Settings_ShowSpendingInsights"]" 
                                     Color="Color.Primary"
                                     Disabled="@(!_showTipsAndInsights)" />
                        
                        <MudCheckBox T="bool" 
                                     @bind-Checked="_showBehavioralInsights" 
                                     Label="@L["Settings_ShowBehavioralInsights"]" 
                                     Color="Color.Primary"
                                     Disabled="@(!_showTipsAndInsights)" />

                        <MudDivider Class="my-2" />

                        <MudButton Variant="Variant.Filled"
                                   Class="mb-btn-primary"
                                   OnClick="SaveAsync"
                                   Disabled="@(!_formValid || _saving)"
                                   FullWidth="false">
                            @if (_saving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                            }
                            @L["Settings_SaveChanges"]
                        </MudButton>
                    </MudStack>
                </MudForm>
            }
        </div>

        <div class="mb-card mt-4">
            <MudStack Spacing="4">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--mb-text-secondary); font-weight: 600;">
                        @L["Settings_DataManagement"]
                    </MudText>
                </div>
                
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    <MudText Typo="Typo.body2">
                        @L["Settings_EraseWarning"]
                    </MudText>
                </MudAlert>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteForever"
                           OnClick="ShowEraseDataConfirmation"
                           Disabled="@_erasing">
                    @if (_erasing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                    }
                    @L["Settings_EraseAllData"]
                </MudButton>

                <MudDivider Class="my-2" />

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    <MudText Typo="Typo.body2">
                        @L["Settings_DemoDataInfo"]
                    </MudText>
                </MudAlert>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlaylistAdd"
                           OnClick="LoadDemoDataAsync"
                           Disabled="@_loadingDemo">
                    @if (_loadingDemo)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                    }
                    @L["Settings_LoadDemoData"]
                </MudButton>
            </MudStack>
        </div>
    </div>
    
    <HelpButton Title="@L["Settings_HelpTitle"]"
                Description="@L["Settings_HelpDescription"]"
                Features="@(new[] { 
                    L["Settings_HelpFeature1"].Value,
                    L["Settings_HelpFeature2"].Value,
                    L["Settings_HelpFeature3"].Value,
                    L["Settings_HelpFeature4"].Value
                })"
                HowToUse="@(new[] {
                    L["Settings_HelpHowTo1"].Value,
                    L["Settings_HelpHowTo2"].Value,
                    L["Settings_HelpHowTo3"].Value
                })"
                Tips="@(new[] {
                    L["Settings_HelpTip1"].Value,
                    L["Settings_HelpTip2"].Value,
                    L["Settings_HelpTip3"].Value
                })" />
</div>

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _erasing;
    private bool _loadingDemo;
    private bool _formValid;
    private MudForm? _form;

    private string _currencyCode = "USD";
    private string _timeZoneId = TimeZoneInfo.Local.Id;
    private string _dateFormat = "yyyy-MM-dd";
    private bool _showTipsAndInsights = true;
    private bool _showEducationalTips = true;
    private bool _showSpendingInsights = true;
    private bool _showBehavioralInsights = true;

    private IReadOnlyList<CurrencyInfo> _currencies = [];
    private IReadOnlyList<TimeZoneInfo> _timeZones = [];

    protected override async Task OnInitializedAsync()
    {
        _currencies = SettingsService.GetAvailableCurrencies();
        _timeZones = SettingsService.GetAvailableTimeZones();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            var settings = await SettingsService.GetSettingsAsync(userId);
            if (settings != null)
            {
                _currencyCode = settings.CurrencyCode;
                _timeZoneId = settings.TimeZoneId;
                _dateFormat = settings.DateFormat;
                _showTipsAndInsights = settings.ShowTipsAndInsights;
                _showEducationalTips = settings.ShowEducationalTips;
                _showSpendingInsights = settings.ShowSpendingInsights;
                _showBehavioralInsights = settings.ShowBehavioralInsights;
            }
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_form is null) return;

        await _form.Validate();
        if (!_formValid) return;

        _saving = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add(L["Msg_UnableToIdentifyUser"], Severity.Error);
                return;
            }

            await SettingsService.SaveSettingsAsync(userId, _currencyCode, _timeZoneId, _dateFormat);
            await SettingsService.UpdateTipsPreferencesAsync(
                userId,
                _showTipsAndInsights,
                _showEducationalTips,
                _showSpendingInsights,
                _showBehavioralInsights);
            Snackbar.Add(L["Settings_SavedSuccess"], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Msg_ErrorSavingSettings", ex.Message], Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ShowEraseDataConfirmation()
    {
        // First confirmation
        var firstResult = await DialogService.ShowMessageBox(
            L["Settings_EraseConfirmTitle"],
            L["Settings_EraseConfirmMessage"],
            yesText: L["Settings_YesContinue"],
            cancelText: L["Btn_Cancel"]);

        if (firstResult != true)
            return;

        // Second confirmation - more explicit
        var secondResult = await DialogService.ShowMessageBox(
            L["Settings_FinalConfirmTitle"],
            (MarkupString)L["Settings_FinalConfirmMessage"].Value,
            yesText: L["Settings_YesEraseEverything"],
            cancelText: L["Settings_NoKeepData"]);

        if (secondResult != true)
            return;

        await EraseAllDataAsync();
    }

    private async Task EraseAllDataAsync()
    {
        _erasing = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add(L["Msg_UnableToIdentifyUser"], Severity.Error);
                return;
            }

            await SettingsService.EraseAllUserDataAsync(userId);
            Snackbar.Add(L["Settings_DataErasedSuccess"], Severity.Success);

            // Reset local state
            _currencyCode = "USD";
            _timeZoneId = TimeZoneInfo.Local.Id;
            _dateFormat = "yyyy-MM-dd";

            // Redirect to homepage with full refresh to reset UI state
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Msg_ErrorErasingData", ex.Message], Severity.Error);
        }
        finally
        {
            _erasing = false;
        }
    }

    private async Task LoadDemoDataAsync()
    {
        var result = await DialogService.ShowMessageBox(
            L["Settings_LoadDemoConfirmTitle"],
            L["Settings_LoadDemoConfirmMessage"],
            yesText: L["Settings_LoadDemoData"],
            cancelText: L["Btn_Cancel"]);

        if (result != true)
            return;

        _loadingDemo = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add(L["Msg_UnableToIdentifyUser"], Severity.Error);
                return;
            }

            await SettingsService.LoadDemoDataAsync(userId);
            Snackbar.Add(L["Settings_DemoDataLoaded"], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Msg_ErrorLoadingDemoData", ex.Message], Severity.Error);
        }
        finally
        {
            _loadingDemo = false;
        }
    }
}
