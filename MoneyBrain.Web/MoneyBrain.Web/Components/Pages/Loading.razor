@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Loading - MoneyBrain</PageTitle>

<div class="loading-container">
    <div class="loading-content">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        <MudText Typo="Typo.h6" Class="mt-4">Loading MoneyBrain...</MudText>
    </div>
</div>

<style>
    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        width: 100%;
    }

    .loading-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Non-blocking mobile detection and redirect
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(100); // Small delay to ensure JS is ready
                    
                    // Check if mobile using JS
                    var isMobile = await JSRuntime.InvokeAsync<bool>("eval", "window.innerWidth <= 768");
                    
                    await InvokeAsync(() =>
                    {
                        if (isMobile)
                        {
                            NavigationManager.NavigateTo("/mobile/overview", forceLoad: false);
                        }
                        else
                        {
                            NavigationManager.NavigateTo("/dashboard", forceLoad: false);
                        }
                    });
                }
                catch (Exception)
                {
                    // On error, default to dashboard
                    await InvokeAsync(() =>
                    {
                        NavigationManager.NavigateTo("/dashboard", forceLoad: false);
                    });
                }
            });
        }
    }
}
