@page "/cashflow"
@using Microsoft.AspNetCore.Authorization
@using MoneyBrain.Web.Application.Reporting.Cashflow
@using MoneyBrain.Web.Application.Reporting.CsvExport
@using System.Globalization
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Resources
@using MoneyBrain.Web.Application.Settings
@inject ICashflowService CashflowService
@inject IUserSettingsService SettingsService
@inject ICsvExportService CsvExportService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SharedResource> L
@inject ICurrencyFormattingService CurrencyFormattingService
@attribute [Authorize]

<PageTitle>@L["Cashflow_PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="mr-2" />
        @L["Cashflow_Header"]
    </MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudDatePicker Label="@L["Lbl_StartDate"]" 
                              @bind-Date="_startDate" 
                              MaxDate="DateTime.Today"
                              @bind-Date:after="LoadDataAsync" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker Label="@L["Lbl_EndDate"]" 
                              @bind-Date="_endDate" 
                              MaxDate="DateTime.Today"
                              @bind-Date:after="LoadDataAsync" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="ExportToCsv"
                           Disabled="@(_cashflowData == null || !_cashflowData.Any())"
                           FullWidth="true">
                    @L["Cashflow_ExportToCsv"]
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
    }
    else if (_cashflowData.Any())
    {
        <!-- Summary Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" md="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Color="Color.Success">@L["Cashflow_TotalIncome"]</MudText>
                        <MudText Typo="Typo.h4">@CurrencyFormattingService.FormatCurrency(_totalIncome, _userSettings?.CurrencyCode ?? "USD")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@_cashflowData.Count @L["Cashflow_Months"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Color="Color.Error">@L["Cashflow_TotalExpenses"]</MudText>
                        <MudText Typo="Typo.h4">@CurrencyFormattingService.FormatCurrency(_totalExpenses, _userSettings?.CurrencyCode ?? "USD")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@_cashflowData.Count @L["Cashflow_Months"]</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Color="@(_netCashflow >= 0 ? Color.Success : Color.Error)">
                            @L["Cashflow_NetCashflow"]
                        </MudText>
                        <MudText Typo="Typo.h4" Color="@(_netCashflow >= 0 ? Color.Success : Color.Error)">
                            @CurrencyFormattingService.FormatCurrency(_netCashflow, _userSettings?.CurrencyCode ?? "USD")
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @((_netCashflow >= 0 ? L["Cashflow_Positive"] : L["Cashflow_Negative"]))
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Monthly Cashflow Chart -->
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-4">@L["Cashflow_MonthlyTrend"]</MudText>
            <MudChart ChartType="ChartType.Bar"
                     ChartSeries="@_chartSeries"
                     XAxisLabels="@_chartLabels"
                     Width="100%"
                     Height="350px"
                     ChartOptions="@_chartOptions" />
        </MudPaper>

        <!-- Detailed Monthly Table -->
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">@L["Cashflow_MonthlyDetails"]</MudText>
            <MudTable Items="@_cashflowData" Hover="true" Dense="true" Striped="true">
                <HeaderContent>
                    <MudTh>@L["Col_Month"]</MudTh>
                    <MudTh Style="text-align: right">@L["Cashflow_Income"]</MudTh>
                    <MudTh Style="text-align: right">@L["Cashflow_Expenses"]</MudTh>
                    <MudTh Style="text-align: right">@L["Cashflow_NetCashflow"]</MudTh>
                    <MudTh Style="text-align: center">@L["Col_Transactions"]</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Col_Month"]">
                        @GetMonthName(context.Year, context.Month)
                    </MudTd>
                    <MudTd DataLabel="@L["Cashflow_Income"]" Style="text-align: right">
                        <MudText Color="Color.Success">@CurrencyFormattingService.FormatCurrency(context.TotalIncome, _userSettings?.CurrencyCode ?? "USD")</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["Cashflow_Expenses"]" Style="text-align: right">
                        <MudText Color="Color.Error">@CurrencyFormattingService.FormatCurrency(context.TotalExpenses, _userSettings?.CurrencyCode ?? "USD")</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["Cashflow_NetCashflow"]" Style="text-align: right">
                        <MudText Color="@(context.NetCashflow >= 0 ? Color.Success : Color.Error)">
                            @CurrencyFormattingService.FormatCurrency(context.NetCashflow, _userSettings?.CurrencyCode ?? "USD")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["Col_Transactions"]" Style="text-align: center">
                        @context.TransactionCount
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                      Size="Size.Small"
                                      OnClick="@(() => ToggleMonthDetails(context))"
                                      aria-label="Expand details" />
                    </MudTd>
                </RowTemplate>
                <ChildRowContent>
                    @if (_expandedMonth == context)
                    {
                        <MudTr>
                            <td colspan="6" style="padding: 0;">
                                <MudPaper Class="pa-4 ma-2" Elevation="0">
                                    <MudGrid>
                                        <!-- Income by Category -->
                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.subtitle1" Class="mb-2" Color="Color.Success">
                                                <strong>@L["Cashflow_IncomeByCategory"]</strong>
                                            </MudText>
                                            @if (context.IncomeByCategory.Any())
                                            {
                                                <MudSimpleTable Dense="true" Hover="true" Style="max-height: 300px; overflow-y: auto;">
                                                    <thead>
                                                        <tr>
                                                            <th>Category</th>
                                                            <th style="text-align: right">Amount</th>
                                                            <th style="text-align: right">%</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var cat in context.IncomeByCategory)
                                                        {
                                                            <tr @key="cat">
                                                                <td>
                                                                    @if (!string.IsNullOrEmpty(cat.CategoryGroupName))
                                                                    {
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@cat.CategoryGroupName</MudText>
                                                                        <br />
                                                                    }
                                                                    @cat.CategoryName
                                                                </td>
                                                                <td style="text-align: right">
                                                                    <MudText Color="Color.Success">@CurrencyFormattingService.FormatCurrency(cat.Amount, _userSettings?.CurrencyCode ?? "USD")</MudText>
                                                                </td>
                                                                <td style="text-align: right">@cat.Percentage.ToString("F1")%</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </MudSimpleTable>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Cashflow_NoIncomeThisMonth"]</MudText>
                                            }
                                        </MudItem>

                                        <!-- Expenses by Category -->
                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.subtitle1" Class="mb-2" Color="Color.Error">
                                                <strong>@L["Cashflow_ExpensesByCategory"]</strong>
                                            </MudText>
                                            @if (context.ExpensesByCategory.Any())
                                            {
                                                <MudSimpleTable Dense="true" Hover="true" Style="max-height: 300px; overflow-y: auto;">
                                                    <thead>
                                                        <tr>
                                                            <th>@L["Col_Category"]</th>
                                                            <th style="text-align: right">@L["Col_Amount"]</th>
                                                            <th style="text-align: right">%</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var cat in context.ExpensesByCategory)
                                                        {
                                                            <tr @key="cat">
                                                                <td>
                                                                    @if (!string.IsNullOrEmpty(cat.CategoryGroupName))
                                                                    {
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@cat.CategoryGroupName</MudText>
                                                                        <br />
                                                                    }
                                                                    @cat.CategoryName
                                                                </td>
                                                                <td style="text-align: right">
                                                                    <MudText Color="Color.Error">@CurrencyFormattingService.FormatCurrency(cat.Amount, _userSettings?.CurrencyCode ?? "USD")</MudText>
                                                                </td>
                                                                <td style="text-align: right">@cat.Percentage.ToString("F1")%</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </MudSimpleTable>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Cashflow_NoExpensesThisMonth"]</MudText>
                                            }
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </td>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            @L["Cashflow_NoDataMessage"]
        </MudAlert>
    }
    
    <HelpButton Title="@L["Cashflow_HelpTitle"]"
                Description="@L["Cashflow_HelpDescription"]"
                Features="@(new[] { 
                    L["Cashflow_HelpFeature1"].Value,
                    L["Cashflow_HelpFeature2"].Value,
                    L["Cashflow_HelpFeature3"].Value,
                    L["Cashflow_HelpFeature4"].Value,
                    L["Cashflow_HelpFeature5"].Value
                })"
                HowToUse="@(new[] {
                    L["Cashflow_HelpHowTo1"].Value,
                    L["Cashflow_HelpHowTo2"].Value,
                    L["Cashflow_HelpHowTo3"].Value,
                    L["Cashflow_HelpHowTo4"].Value,
                    L["Cashflow_HelpHowTo5"].Value
                })"
                Tips="@(new[] {
                    L["Cashflow_HelpTip1"].Value,
                    L["Cashflow_HelpTip2"].Value,
                    L["Cashflow_HelpTip3"].Value,
                    L["Cashflow_HelpTip4"].Value
                })" />
</MudContainer>

@code {
    private List<MonthlyCashflowDto> _cashflowData = [];
    private bool _loading = true;
    private DateTime? _startDate = DateTime.Today.AddMonths(-5);
    private DateTime? _endDate = DateTime.Today;
    private string _userId = string.Empty;
    private UserSettings? _userSettings;

    private decimal _totalIncome;
    private decimal _totalExpenses;
    private decimal _netCashflow;

    private MonthlyCashflowDto? _expandedMonth;

    // Chart data
    private List<ChartSeries> _chartSeries = [];
    private string[] _chartLabels = [];
    private ChartOptions _chartOptions = new()
    {
        YAxisTicks = 1000,
        MaxNumYAxisTicks = 10,
        YAxisFormat = "C0"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            if (!string.IsNullOrEmpty(_userId))
            {
                _userSettings = await SettingsService.GetSettingsAsync(_userId);
            }
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _loading = true;

        try
        {
            _cashflowData = await CashflowService.GetMonthlyCashflowAsync(
                _userId,
                _startDate,
                _endDate);

            // Calculate totals
            _totalIncome = _cashflowData.Sum(c => c.TotalIncome);
            _totalExpenses = _cashflowData.Sum(c => c.TotalExpenses);
            _netCashflow = _totalIncome - _totalExpenses;

            // Prepare chart data
            PrepareChartData();
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrepareChartData()
    {
        _chartLabels = _cashflowData
            .Select(c => $"{CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(c.Month)} {c.Year}")
            .ToArray();

        _chartSeries = new List<ChartSeries>
        {
            new ChartSeries
            {
                Name = L["Cashflow_Income"].Value,
                Data = _cashflowData.Select(c => (double)c.TotalIncome).ToArray()
            },
            new ChartSeries
            {
                Name = L["Cashflow_Expenses"].Value,
                Data = _cashflowData.Select(c => (double)c.TotalExpenses).ToArray()
            },
            new ChartSeries
            {
                Name = L["Cashflow_NetCashflow"].Value,
                Data = _cashflowData.Select(c => (double)c.NetCashflow).ToArray()
            }
        };
    }

    private string GetMonthName(int year, int month)
    {
        var date = new DateTime(year, month, 1);
        return date.ToString("MMMM yyyy");
    }

    private void ToggleMonthDetails(MonthlyCashflowDto month)
    {
        if (_expandedMonth == month)
        {
            _expandedMonth = null;
        }
        else
        {
            _expandedMonth = month;
        }
    }

    private async Task ExportToCsv()
    {
        if (_cashflowData == null || !_cashflowData.Any())
            return;

        var csvBytes = CsvExportService.ExportCashflowToCsv(_cashflowData);
        var fileName = $"cashflow_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
        var base64 = Convert.ToBase64String(csvBytes);
        
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64);
    }
}
