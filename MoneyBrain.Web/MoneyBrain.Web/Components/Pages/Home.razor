@page "/"
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

@attribute [ExcludeFromInteractiveRouting]

<PageTitle>MoneyBrain - Personal Finance Made Simple</PageTitle>

@* SEO Meta Tags *@
<HeadContent>
    <meta name="description" content="MoneyBrain is a lightweight, self-hosted personal finance app focused on correctness, predictability, and data ownership." />
    <meta name="keywords" content="personal finance, budgeting, money management, self-hosted, privacy" />
</HeadContent>

<!-- Hero Section -->
<section style="background: linear-gradient(135deg, #F7FAFC 0%, #EDF2F7 100%); padding: 6rem 2rem;">
    <div style="max-width: 1200px; margin: 0 auto; text-align: center;">
        <h1 style="font-size: 3.5rem; font-weight: 800; color: #1A202C; margin-bottom: 1.5rem; line-height: 1.1;">
            Take Control of Your<br />
            <span style="color: #1DB954;">Financial Future</span>
        </h1>
        <p style="font-size: 1.25rem; color: #718096; max-width: 600px; margin: 0 auto 2.5rem; line-height: 1.6;">
            MoneyBrain is a lightweight, self-hosted personal finance app focused on 
            correctness, predictability, and complete data ownership.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/Account/Register" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 1rem 2rem; background: #1DB954; color: white; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 1.1rem; transition: background 0.2s;">
                Get Started Free
            </a>
            <a href="/Account/Login" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 1rem 2rem; background: white; color: #1DB954; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 1.1rem; border: 2px solid #1DB954; transition: background 0.2s;">
                Sign In
            </a>
        </div>
    </div>
</section>

<!-- Features Section -->
<section style="padding: 5rem 2rem; background: white;">
    <div style="max-width: 1200px; margin: 0 auto;">
        <h2 style="font-size: 2.5rem; font-weight: 700; text-align: center; color: #1A202C; margin-bottom: 1rem;">
            Everything You Need
        </h2>
        <p style="text-align: center; color: #718096; max-width: 600px; margin: 0 auto 4rem; font-size: 1.1rem;">
            Powerful features designed to give you complete control over your finances.
        </p>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
            <div style="padding: 2rem; background: #F7FAFC; border-radius: 12px; border: 1px solid #E2E8F0;">
                <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #1DB954 0%, #169c46 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
                    <svg width="28" height="28" fill="white" viewBox="0 0 24 24"><path d="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
                </div>
                <h3 style="font-size: 1.25rem; font-weight: 700; color: #1A202C; margin-bottom: 0.75rem;">Multiple Accounts</h3>
                <p style="color: #718096; line-height: 1.6;">Track bank accounts, credit cards, cash, investments, and loans all in one place.</p>
            </div>
            
            <div style="padding: 2rem; background: #F7FAFC; border-radius: 12px; border: 1px solid #E2E8F0;">
                <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
                    <svg width="28" height="28" fill="white" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                </div>
                <h3 style="font-size: 1.25rem; font-weight: 700; color: #1A202C; margin-bottom: 0.75rem;">Detailed Reports</h3>
                <p style="color: #718096; line-height: 1.6;">Visualize your spending patterns with beautiful charts and insightful reports.</p>
            </div>
            
            <div style="padding: 2rem; background: #F7FAFC; border-radius: 12px; border: 1px solid #E2E8F0;">
                <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #4299E1 0%, #3182CE 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
                    <svg width="28" height="28" fill="white" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
                </div>
                <h3 style="font-size: 1.25rem; font-weight: 700; color: #1A202C; margin-bottom: 0.75rem;">100% Private</h3>
                <p style="color: #718096; line-height: 1.6;">Self-hosted and privacy-first. Your financial data never leaves your control.</p>
            </div>
            
            <div style="padding: 2rem; background: #F7FAFC; border-radius: 12px; border: 1px solid #E2E8F0;">
                <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #F6AD55 0%, #ED8936 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
                    <svg width="28" height="28" fill="white" viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
                </div>
                <h3 style="font-size: 1.25rem; font-weight: 700; color: #1A202C; margin-bottom: 0.75rem;">Smart Budgeting</h3>
                <p style="color: #718096; line-height: 1.6;">Envelope-style monthly budgets that help you plan and control spending.</p>
            </div>
            
            <div style="padding: 2rem; background: #F7FAFC; border-radius: 12px; border: 1px solid #E2E8F0;">
                <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #E53E3E 0%, #C53030 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
                    <svg width="28" height="28" fill="white" viewBox="0 0 24 24"><path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
                </div>
                <h3 style="font-size: 1.25rem; font-weight: 700; color: #1A202C; margin-bottom: 0.75rem;">Reconciliation</h3>
                <p style="color: #718096; line-height: 1.6;">Match your records with bank statements for perfect accuracy.</p>
            </div>
            
            <div style="padding: 2rem; background: #F7FAFC; border-radius: 12px; border: 1px solid #E2E8F0;">
                <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #38B2AC 0%, #319795 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
                    <svg width="28" height="28" fill="white" viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/></svg>
                </div>
                <h3 style="font-size: 1.25rem; font-weight: 700; color: #1A202C; margin-bottom: 0.75rem;">CSV Import/Export</h3>
                <p style="color: #718096; line-height: 1.6;">Easily import transactions from your bank or export for backup.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section style="padding: 5rem 2rem; background: linear-gradient(135deg, #1A202C 0%, #2D3748 100%);">
    <div style="max-width: 800px; margin: 0 auto; text-align: center;">
        <h2 style="font-size: 2.5rem; font-weight: 700; color: white; margin-bottom: 1rem;">
            Ready to Take Control?
        </h2>
        <p style="font-size: 1.1rem; color: #A0AEC0; margin-bottom: 2rem;">
            Join thousands of users who trust MoneyBrain for their personal finances.
        </p>
        <a href="/Account/Register" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 1rem 2.5rem; background: #1DB954; color: white; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 1.1rem;">
            Start Your Free Account
        </a>
    </div>
</section>

<!-- Footer -->
<footer style="padding: 3rem 2rem; background: #1A202C; border-top: 1px solid #2D3748;">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 32px; height: 32px; background: #1DB954; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700;">M</div>
            <span style="color: white; font-weight: 600;">MoneyBrain</span>
        </div>
        <p style="color: #718096; font-size: 0.875rem;">
            © 2026 MoneyBrain. Self-hosted personal finance.
        </p>
    </div>
</footer>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/dashboard", replace: true);
        }
    }
}