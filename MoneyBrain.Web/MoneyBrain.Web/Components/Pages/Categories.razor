@page "/categories"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using MoneyBrain.Web.Resources
@using System.Security.Claims

@attribute [Authorize]

@inject IStringLocalizer<SharedResource> L
@inject ICategoryService CategoryService
@inject IDialogService DialogService
@inject ISnackbar SnackbarService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrencyFormattingService CurrencyFormattingService

<PageTitle>@L["Nav_Categories"] | @L["App_MoneyBrain"]</PageTitle>

<div class="mb-page mb-animate-in">
    <!-- Header -->
    <div class="mb-section-header">
        <div>
            <h1 class="mb-title">@L["Nav_Categories"]</h1>
            <p class="mb-subtitle">@L["Cat_Subtitle"]</p>
        </div>
        <div class="d-flex gap-2">
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Secondary">
                <MudButton OnClick="@(() => SetViewMode("categories"))" 
                           Variant="@(_viewMode == "categories" ? Variant.Filled : Variant.Outlined)">
                    @L["Nav_Categories"]
                </MudButton>
                <MudButton OnClick="@(() => SetViewMode("budgets"))"
                           Variant="@(_viewMode == "budgets" ? Variant.Filled : Variant.Outlined)">
                    @L["Nav_Budgets"]
                </MudButton>
            </MudButtonGroup>
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OpenCreateGroupDialog">
                @L["Cat_NewGroup"]
            </MudButton>
            <MudButton Variant="Variant.Filled" 
                       Class="mb-btn-primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => OpenCreateCategoryDialog())">
                @L["Cat_NewCategory"]
            </MudButton>
        </div>
    </div>

    @if (_isLoading)
    {
        <CategoriesLoader />
    }
    else if (_viewMode == "budgets")
    {
        <!-- Budget View -->
        <MudPaper Class="pa-4 mb-4">
            <div class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h6">
                    @if (_showingDefaults)
                    {
                        <text>@L["Cat_DefaultMonthlyBudgets"]</text>
                    }
                    else
                    {
                        <text>@string.Format(L["Cat_MonthBudgets"], _selectedMonthName, _selectedYear)</text>
                    }
                </MudText>
                <div class="d-flex gap-2 align-center">
                    @if (!_showingDefaults)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" 
                                       Size="Size.Small"
                                       OnClick="@PreviousMonth"
                                       aria-label="@L["Accessibility_PreviousMonth"]" />
                        <MudButton Variant="Variant.Text" 
                                   Size="Size.Small"
                                   OnClick="@CurrentMonth">
                            @L["Time_Today"]
                        </MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" 
                                       Size="Size.Small"
                                       OnClick="@NextMonth"
                                       aria-label="@L["Accessibility_NextMonth"]" />
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
                    }
                    <MudButton Variant="@(_showingDefaults ? Variant.Filled : Variant.Outlined)" 
                               Size="Size.Small"
                               OnClick="@(() => ToggleDefaultView())">
                        @(_showingDefaults ? L["Cat_ViewingDefaults"] : L["Cat_ViewDefaults"])
                    </MudButton>
                </div>
            </div>
        </MudPaper>

        @if (_categoryGroups.Count == 0)
        {
            <div class="mb-empty-state">
                <MudIcon Icon="@Icons.Material.Outlined.Category" Class="mb-empty-state-icon" />
                <MudText Typo="Typo.h6" Class="mb-2">@L["Cat_NoCategoriesYet"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mb-text-muted);">
                    @L["Cat_CreateCategoriesFirstForBudgets"]
                </MudText>
            </div>
        }
        else
        {
            <MudStack Spacing="4">
                @foreach (var group in _categoryGroups.OrderBy(g => g.SortOrder).ThenBy(g => g.Name))
                {
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">@group.Name</MudText>

                        @if (group.Categories.Any(c => c.IsActive))
                        {
                            <MudTable Items="@group.Categories.Where(c => c.IsActive).OrderBy(c => c.SortOrder).ThenBy(c => c.Name)" 
                                      Dense="true" 
                                      Hover="true">
                                <HeaderContent>
                                    <MudTh>@L["Col_Category"]</MudTh>
                                    <MudTh Style="text-align: right;">@L["Cat_Budgeted"]</MudTh>
                                    <MudTh Style="text-align: right;">@L["Cat_Actual"]</MudTh>
       <MudTh Style="text-align: right;">@L["Dashboard_Remaining"]</MudTh>
                                    <MudTh>@L["Lbl_Notes"]</MudTh>
                                    <MudTh Style="text-align: right;">@L["Col_Actions"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.Name</MudTd>
                                    <MudTd Style="text-align: right;">
                                        @{
                                            var budget = _monthlyBudgets.FirstOrDefault(b => b.CategoryId == context.Id);
                                            var hasOverride = budget != null && !budget.IsDefault;
                                            
                                            if (budget != null)
                                            {
                                                <div class="d-flex align-center justify-end gap-1">
                                                    <MudText>@CurrencyFormattingService.FormatCurrency(budget.PlannedAmount, _userSettings?.CurrencyCode ?? "USD")</MudText>
                                                    @if (hasOverride)
                                                    {
                                                        <MudTooltip Text="@L["Cat_MonthSpecificOverride"]">
                                                            <MudIcon Icon="@Icons.Material.Filled.EditCalendar" Size="Size.Small" Color="Color.Warning" />
                                                        </MudTooltip>
                                                    }
                                                    @if (budget.AllowRollover)
                                                    {
                                                        <MudTooltip Text="@L["Cat_RolloverEnabled"]">
                                                            <MudIcon Icon="@Icons.Material.Filled.Repeat" Size="Size.Small" Color="Color.Info" />
                                                        </MudTooltip>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <MudText Style="color: var(--mb-text-muted);">—</MudText>
                                            }
                                        }
                                    </MudTd>
                                    <MudTd Style="text-align: right;">
                                        @{
                                            var actualSpent = _actualSpending.ContainsKey(context.Id) ? _actualSpending[context.Id] : 0m;
                                            var budget = _monthlyBudgets.FirstOrDefault(b => b.CategoryId == context.Id);
                                            
                                            if (budget != null)
                                            {
                                                var isOverspent = actualSpent > budget.PlannedAmount;
                                                
                                                <MudText Color="@(isOverspent ? Color.Error : Color.Default)">
                                                    @CurrencyFormattingService.FormatCurrency(actualSpent, _userSettings?.CurrencyCode ?? "USD")
                                                </MudText>
                                            }
                                            else
                                            {
                                                <MudText Style="color: var(--mb-text-muted);">—</MudText>
                                            }
                                        }
                                    </MudTd>
                                    <MudTd Style="text-align: right;">
                                        @{
                                            var actualSpent = _actualSpending.ContainsKey(context.Id) ? _actualSpending[context.Id] : 0m;
                                            var budget = _monthlyBudgets.FirstOrDefault(b => b.CategoryId == context.Id);
                                            
                                            if (budget != null)
                                            {
                                                var remaining = budget.PlannedAmount - actualSpent;
                                                var isOverspent = remaining < 0;
                                                var percentUsed = budget.PlannedAmount > 0 ? (actualSpent / budget.PlannedAmount) * 100 : 0;
                                                
                                                <div class="d-flex align-center justify-end gap-2">
                                                    <MudText Color="@(isOverspent ? Color.Error : remaining < budget.PlannedAmount * 0.1m ? Color.Warning : Color.Success)">
                                                        @CurrencyFormattingService.FormatCurrency(remaining, _userSettings?.CurrencyCode ?? "USD")
                                                    </MudText>
                                                    @if (isOverspent)
                                                    {
                                                        <MudTooltip Text="@string.Format(L["Cat_OverspentTooltip"], Math.Abs(remaining), percentUsed)">
                                                            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Error" />
                                                        </MudTooltip>
                                                    }
                                                    else if (percentUsed >= 90)
                                                    {
                                                        <MudTooltip Text="@string.Format(L["Cat_BudgetUsedTooltip"], percentUsed)">
                                                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Warning" />
                                                        </MudTooltip>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <MudText Style="color: var(--mb-text-muted);">—</MudText>
                                            }
                                        }
                                    </MudTd>
                                    <MudTd>
                                        @{
                                            var budget = _monthlyBudgets.FirstOrDefault(b => b.CategoryId == context.Id);
                                            var notesText = budget != null && !string.IsNullOrWhiteSpace(budget.Notes) ? budget.Notes : "—";
                                            <MudText Typo="Typo.body2" Style="color: var(--mb-text-muted);">
                                                @notesText
                                            </MudText>
                                        }
                                    </MudTd>
                                    <MudTd Style="text-align: right;">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                       Size="Size.Small"
                                                       OnClick="@(() => OpenBudgetDialog(context, _showingDefaults))" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Surface" Class="text-center py-3">
                                @L["Cat_NoCategoriesInGroup"]
                            </MudText>
                        }
                    </MudPaper>
                }
            </MudStack>
        }
    }
    else if (_categoryGroups.Count == 0)
    {
        <div class="mb-empty-state">
            <MudIcon Icon="@Icons.Material.Outlined.Category" Class="mb-empty-state-icon" />
            <MudText Typo="Typo.h6" Class="mb-2">@L["Cat_NoCategoryGroupsYet"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mb-text-muted);">
                @L["Cat_CreateGroupsDescription"]
            </MudText>
            <MudButton Variant="Variant.Filled" Class="mb-btn-primary" OnClick="@OpenCreateGroupDialog">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="me-2" />
                @L["Cat_CreateFirstGroup"]
            </MudButton>
        </div>
    }
    else
    {
        <MudStack Spacing="4">
            @foreach (var group in _categoryGroups.OrderBy(g => g.SortOrder).ThenBy(g => g.Name))
            {
                <MudPaper Class="pa-4">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Color="Color.Default" />
                            <MudText Typo="Typo.h6">@group.Name</MudText>
                            
                            @if (group.Type == CategoryType.Income)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.TrendingUp">
                                    @L["Cat_Income"]
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.ShoppingCart">
                                    @L["Cat_Expense"]
                                </MudChip>
                            }
                            
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                @string.Format(L["Cat_CategoryCount"], group.Categories.Count(c => c.IsActive))
                            </MudChip>
                        </div>
                        <div class="d-flex gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="@(() => OpenCreateCategoryDialog(group.Id))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                           Size="Size.Small"
                                           OnClick="@(() => OpenEditGroupDialog(group))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => DeleteGroup(group))" />
                        </div>
                    </div>

                    @if (group.Categories.Any(c => c.IsActive))
                    {
                        <MudList T="string" Dense="true" disablePadding="true">
                            @foreach (var category in group.Categories.Where(c => c.IsActive).OrderBy(c => c.SortOrder).ThenBy(c => c.Name))
                            {
                                <MudListItem T="string" Class="px-0">
                                    <div class="d-flex justify-space-between align-center w-100">
                                        <div class="d-flex align-center gap-2">
                                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Color="Color.Surface" />
                                            <MudText>@category.Name</MudText>
                                        </div>
                                        <div class="d-flex gap-1">
                                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                                                <MudMenuItem Icon="@Icons.Material.Filled.History" OnClick="@(() => OpenUsageHistoryDialog(category))">
                                                    @L["Cat_ViewUsageHistory"]
                                                </MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenRenameCategoryDialog(category))">
                                                    @L["Cat_Rename"]
                                                </MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.Merge" OnClick="@(() => OpenMergeCategoryDialog(category))">
                                                    @L["Cat_MergeIntoAnother"]
                                                </MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteCategory(category))">
                                                    <MudText Color="Color.Error">@L["Common_Delete"]</MudText>
                                                </MudMenuItem>
                                            </MudMenu>
                                        </div>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Surface" Class="text-center py-3">
                            @L["Cat_NoCategoriesClickToAdd"]
                        </MudText>
                    }
                </MudPaper>
            }
        </MudStack>
    }
    
    <HelpButton Title="@L["Cat_HelpTitle"]"
                Description="@L["Cat_HelpDescription"]"
                Features="@(new[] { 
                    L["Cat_HelpFeature1"].Value,
                    L["Cat_HelpFeature2"].Value,
                    L["Cat_HelpFeature3"].Value,
                    L["Cat_HelpFeature4"].Value,
                    L["Cat_HelpFeature5"].Value,
                    L["Cat_HelpFeature6"].Value
                })"
                HowToUse="@(new[] {
                    L["Cat_HelpHowTo1"].Value,
                    L["Cat_HelpHowTo2"].Value,
                    L["Cat_HelpHowTo3"].Value,
                    L["Cat_HelpHowTo4"].Value,
                    L["Cat_HelpHowTo5"].Value
                })"
                Tips="@(new[] {
                    L["Cat_HelpTip1"].Value,
                    L["Cat_HelpTip2"].Value,
                    L["Cat_HelpTip3"].Value,
                    L["Cat_HelpTip4"].Value,
                    L["Cat_HelpTip5"].Value
                })" />
</div>

@code {
    private List<CategoryGroup> _categoryGroups = [];
    private List<MonthlyBudget> _monthlyBudgets = [];
    private Dictionary<int, decimal> _actualSpending = new();
    private bool _isLoading = true;
    private string? _userId;
    private string _viewMode = "categories"; // "categories" or "budgets"
    private int _selectedYear = DateTime.UtcNow.Year;
    private int _selectedMonth = DateTime.UtcNow.Month;
    private string _selectedMonthName = string.Empty;
    private bool _showingDefaults = false;
    private UserSettings? _userSettings;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(_userId))
        {
            await LoadCategories();
            await LoadBudgets();
        }

        _selectedMonthName = new DateTime(_selectedYear, _selectedMonth, 1).ToString("MMMM");
        _isLoading = false;
    }

    private async Task LoadCategories()
    {
        if (string.IsNullOrWhiteSpace(_userId))
            return;

        _categoryGroups = await CategoryService.GetCategoryGroupsAsync(_userId, includeCategories: true);
        
        // Auto-seed default categories if user has none
        if (_categoryGroups.Count == 0)
        {
            await CategoryService.SeedDefaultCategoriesAsync(_userId);
            _categoryGroups = await CategoryService.GetCategoryGroupsAsync(_userId, includeCategories: true);
        }
    }

    private async Task LoadBudgets()
    {
        if (string.IsNullOrWhiteSpace(_userId))
            return;

        if (_showingDefaults)
        {
            _monthlyBudgets = await CategoryService.GetDefaultBudgetsAsync(_userId);
            // Load actual spending for current month to show overspending indicators
            var now = DateTime.UtcNow;
            _actualSpending = await CategoryService.GetAllCategoriesActualSpendingAsync(_userId, now.Year, now.Month);
        }
        else
        {
            _monthlyBudgets = await CategoryService.GetEffectiveBudgetsForMonthAsync(_userId, _selectedYear, _selectedMonth);
            _actualSpending = await CategoryService.GetAllCategoriesActualSpendingAsync(_userId, _selectedYear, _selectedMonth);
        }
    }

    private async Task ToggleDefaultView()
    {
        _showingDefaults = !_showingDefaults;
        await LoadBudgets();
    }

    private async Task SetViewMode(string mode)
    {
        _viewMode = mode;
        if (mode == "budgets" && _monthlyBudgets.Count == 0)
        {
            await LoadBudgets();
        }
    }

    private async Task PreviousMonth()
    {
        _selectedMonth--;
        if (_selectedMonth < 1)
        {
            _selectedMonth = 12;
            _selectedYear--;
        }
        _selectedMonthName = new DateTime(_selectedYear, _selectedMonth, 1).ToString("MMMM");
        await LoadBudgets();
    }

    private async Task NextMonth()
    {
        _selectedMonth++;
        if (_selectedMonth > 12)
        {
            _selectedMonth = 1;
            _selectedYear++;
        }
        _selectedMonthName = new DateTime(_selectedYear, _selectedMonth, 1).ToString("MMMM");
        await LoadBudgets();
    }

    private async Task CurrentMonth()
    {
        _selectedYear = DateTime.UtcNow.Year;
        _selectedMonth = DateTime.UtcNow.Month;
        _selectedMonthName = new DateTime(_selectedYear, _selectedMonth, 1).ToString("MMMM");
        await LoadBudgets();
    }

    private async Task OpenCreateGroupDialog()
    {
        var parameters = new DialogParameters<CategoryGroupDialog>
        {
            { x => x.UserId, _userId },
            { x => x.IsNew, true }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CategoryGroupDialog>(L["Cat_NewCategoryGroupTitle"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadCategories();
            SnackbarService.Add(L["Cat_GroupCreatedSuccess"], Severity.Success);
        }
    }

    private async Task OpenEditGroupDialog(CategoryGroup group)
    {
        var parameters = new DialogParameters<CategoryGroupDialog>
        {
            { x => x.UserId, _userId },
            { x => x.CategoryGroup, group },
            { x => x.IsNew, false }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CategoryGroupDialog>(L["Cat_EditCategoryGroupTitle"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadCategories();
            SnackbarService.Add(L["Cat_GroupUpdatedSuccess"], Severity.Success);
        }
    }

    private async Task DeleteGroup(CategoryGroup group)
    {
        var activeCategoriesCount = group.Categories.Count(c => c.IsActive);
        
        var message = activeCategoriesCount > 0
            ? string.Format(L["Cat_GroupHasActiveCategories"], activeCategoriesCount)
            : L["Cat_ConfirmDeleteGroup"].Value;

        var result = await DialogService.ShowMessageBox(
            L["Cat_DeleteCategoryGroupTitle"],
            message,
            yesText: activeCategoriesCount > 0 ? L["Btn_Ok"] : L["Btn_Delete"],
            cancelText: L["Btn_Cancel"]);

        if (result == true && _userId != null)
        {
            try
            {
                var deleted = await CategoryService.DeleteCategoryGroupAsync(group.Id, _userId);
                if (deleted)
                {
                    await LoadCategories();
                    SnackbarService.Add(L["Cat_GroupDeletedSuccess"], Severity.Success);
                }
                else
                {
                    SnackbarService.Add(L["Cat_GroupDeleteFailed"], Severity.Error);
                }
            }
            catch (InvalidOperationException ex)
            {
                SnackbarService.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task OpenCreateCategoryDialog(int? groupId = null)
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.UserId, _userId },
            { x => x.IsNew, true },
            { x => x.PreselectedGroupId, groupId ?? 0 }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CategoryDialog>(L["Cat_NewCategoryTitle"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadCategories();
            SnackbarService.Add(L["Cat_CategoryCreatedSuccess"], Severity.Success);
        }
    }

    private async Task OpenEditCategoryDialog(Category category)
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.UserId, _userId },
            { x => x.Category, category },
            { x => x.IsNew, false }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CategoryDialog>(L["Cat_EditCategoryTitle"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadCategories();
            SnackbarService.Add(L["Cat_CategoryUpdatedSuccess"], Severity.Success);
        }
    }

    private async Task DeleteCategory(Category category)
    {
        var result = await DialogService.ShowMessageBox(
            L["Cat_DeleteCategoryTitle"],
            string.Format(L["Cat_ConfirmDeleteCategory"], category.Name),
            yesText: L["Btn_Delete"],
            cancelText: L["Btn_Cancel"]);

        if (result == true && _userId != null)
        {
            var deleted = await CategoryService.DeleteCategoryAsync(category.Id, _userId);
            if (deleted)
            {
                await LoadCategories();
                SnackbarService.Add(L["Cat_CategoryDeletedSuccess"], Severity.Success);
            }
            else
            {
                SnackbarService.Add(L["Cat_CategoryDeleteFailed"], Severity.Error);
            }
        }
    }

    private async Task OpenRenameCategoryDialog(Category category)
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.UserId, _userId },
            { x => x.Category, category },
            { x => x.IsNew, false }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CategoryDialog>(L["Cat_RenameCategoryTitle"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadCategories();
            SnackbarService.Add(L["Cat_CategoryRenamedSuccess"], Severity.Success);
        }
    }

    private async Task OpenUsageHistoryDialog(Category category)
    {
        var parameters = new DialogParameters<CategoryUsageHistoryDialog>
        {
            { x => x.Category, category },
            { x => x.UserId, _userId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };
        await DialogService.ShowAsync<CategoryUsageHistoryDialog>(string.Format(L["Cat_UsageHistoryTitle"], category.Name), parameters, options);
    }

    private async Task OpenMergeCategoryDialog(Category category)
    {
        var parameters = new DialogParameters<MergeCategoryDialog>
        {
            { x => x.SourceCategory, category },
            { x => x.UserId, _userId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<MergeCategoryDialog>(L["Cat_MergeCategoryTitle"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadCategories();
            SnackbarService.Add(string.Format(L["Cat_CategoryMergedSuccess"], category.Name), Severity.Success);
        }
    }

    private async Task OpenBudgetDialog(Category category, bool isDefault = false)
    {
        var parameters = new DialogParameters<BudgetAssignmentDialog>
        {
            { x => x.UserId, _userId },
            { x => x.Category, category },
            { x => x.Year, _selectedYear },
            { x => x.Month, _selectedMonth },
            { x => x.IsDefaultMode, isDefault }
        };

        var title = isDefault ? L["Cat_SetDefaultBudget"].Value : string.Format(L["Cat_SetBudgetForMonth"], _selectedMonthName, _selectedYear);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<BudgetAssignmentDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadBudgets();
            SnackbarService.Add(L["Cat_BudgetUpdatedSuccess"], Severity.Success);
        }
    }
}
