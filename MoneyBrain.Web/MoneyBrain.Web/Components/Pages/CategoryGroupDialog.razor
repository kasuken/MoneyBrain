@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject ICategoryService CategoryService
@inject ISnackbar SnackbarService
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" 
                      Label="@L["CatGrpDlg_GroupName"]" 
                      Variant="Variant.Outlined" 
                      Required="true"
                      Immediate="true"
                      MaxLength="100" />

        <MudSelect @bind-Value="_type" 
                   Label="@L["CatGrpDlg_CategoryType"]" 
                   Variant="Variant.Outlined" 
                   Required="true"
                   Class="mt-4">
            <MudSelectItem Value="@CategoryType.Expense">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" />
                    <div>
                        <div>@L["Cat_Expense"]</div>
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                            @L["CatGrpDlg_ExpenseDesc"]
                        </MudText>
                    </div>
                </div>
            </MudSelectItem>
            <MudSelectItem Value="@CategoryType.Income">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Success" />
                    <div>
                        <div>@L["Cat_Income"]</div>
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                            @L["CatGrpDlg_IncomeDesc"]
                        </MudText>
                    </div>
                </div>
            </MudSelectItem>
        </MudSelect>

        <DialogErrorAlert Message="@_errorMessage" />
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnCancel="Cancel"
                             OnSubmit="Submit"
                             IsSubmitting="_isSubmitting"
                             SubmitDisabled="@(string.IsNullOrWhiteSpace(_name))"
                             SubmitText="@(IsNew ? L["Btn_Create"] : L["Btn_Update"])" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public CategoryGroup? CategoryGroup { get; set; }
    [Parameter] public bool IsNew { get; set; } = true;

    private string _name = string.Empty;
    private CategoryType _type = CategoryType.Expense;
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (!IsNew && CategoryGroup != null)
        {
            _name = CategoryGroup.Name;
            _type = CategoryGroup.Type;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _errorMessage = L["CatGrpDlg_NameRequired"];
            return;
        }

        _isSubmitting = true;

        try
        {
            if (IsNew)
            {
                var group = await CategoryService.CreateCategoryGroupAsync(UserId, _name.Trim(), _type);
                MudDialog.Close(DialogResult.Ok(group));
            }
            else if (CategoryGroup != null)
            {
                var success = await CategoryService.UpdateCategoryGroupAsync(CategoryGroup.Id, UserId, _name.Trim(), _type);
                if (success)
                {
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    _errorMessage = L["CatGrpDlg_UpdateFailed"];
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = string.Format(L["Msg_Error"], ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
