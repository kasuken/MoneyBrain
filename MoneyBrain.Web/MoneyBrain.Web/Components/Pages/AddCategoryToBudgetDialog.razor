@using MoneyBrain.Web.Application.Budgets
@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject IBudgetService BudgetService
@inject ICategoryService CategoryService
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2" Class="mb-2">
                @L["AddCatBudgetDlg_SelectCategories"]
            </MudText>

            @foreach (var group in _categoryGroups.OrderBy(g => g.Name))
            {
                var groupCategories = _availableCategoriesByGroup.ContainsKey(group.Id) 
                    ? _availableCategoriesByGroup[group.Id] 
                    : new List<Category>();
                
                if (groupCategories.Any())
                {
                    <MudPaper @key="group.Id" Class="pa-3" Outlined="true">
                        <MudStack Spacing="2">
                            <div class="d-flex align-center justify-space-between">
                                <MudCheckBox T="bool" 
                                             Value="@IsGroupFullySelected(group.Id)"
                                             ValueChanged="@((bool value) => ToggleGroup(group.Id, value))"
                                             Label="@group.Name"
                                             Color="Color.Primary"
                                             Dense="true" />
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                    @string.Format(L["AddCatBudgetDlg_CategoryCount"], groupCategories.Count)
                                </MudChip>
                            </div>
                            
                            @if (IsGroupExpanded(group.Id))
                            {
                                <MudStack Spacing="1" Class="ms-4">
                                    @foreach (var category in groupCategories.OrderBy(c => c.Name))
                                    {
                                        <MudCheckBox @key="category.Id" T="bool"
                                                     Value="@_selectedCategoryIds.Contains(category.Id)"
                                                     ValueChanged="@((bool value) => ToggleCategory(category.Id, value))"
                                                     Label="@category.Name"
                                                     Color="Color.Primary"
                                                     Dense="true"
                                                     Size="Size.Small" />
                                    }
                                </MudStack>
                            }
                            
                            <MudButton Size="Size.Small" 
                                       Variant="Variant.Text"
                                       OnClick="@(() => ToggleGroupExpansion(group.Id))">
                                @(IsGroupExpanded(group.Id) ? L["AddCatBudgetDlg_HideCategories"] : L["AddCatBudgetDlg_ShowCategories"])
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                }
            }

            <MudDivider Class="my-2" />

            <MudNumericField @bind-Value="_plannedAmount" 
                             Label="@L["AddCatBudgetDlg_DefaultAmount"]" 
                             Variant="Variant.Outlined" 
                             Required="true"
                             Format="N2"
                             Min="0"
                             Step="0.01M"
                             Adornment="Adornment.Start"
                             AdornmentText="$"
                             HelperText="@L["AddCatBudgetDlg_DefaultAmountHelper"]" />

            <MudSwitch @bind-Value="_allowRollover" 
                       Label="@L["BudgetAsgnDlg_AllowRollover"]" 
                       Color="Color.Primary">
                <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">
                    @L["BudgetAsgnDlg_RolloverDesc"]
                </MudText>
            </MudSwitch>
            
            <MudTextField @bind-Value="_notes" 
                          Label="@L["AddCatBudgetDlg_Notes"]" 
                          Variant="Variant.Outlined"
                          Lines="2"
                          MaxLength="500"
                          HelperText="@L["AddCatBudgetDlg_NotesHelper"]" />

            @if (_selectedCategoryIds.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    @string.Format(L["AddCatBudgetDlg_SelectedCount"], _selectedCategoryIds.Count)
                </MudAlert>
            }
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Submit" 
                   Disabled="@(_isSubmitting || _selectedCategoryIds.Count == 0)">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="me-2" />
            }
            @string.Format(L["AddCatBudgetDlg_AddButton"], _selectedCategoryIds.Count)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public List<Category> AvailableCategories { get; set; } = [];
    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public int BudgetId { get; set; }
    [Parameter] public bool IsNewBudget { get; set; }

    private List<CategoryGroup> _categoryGroups = [];
    private Dictionary<int, List<Category>> _availableCategoriesByGroup = new();
    private HashSet<int> _selectedCategoryIds = new();
    private HashSet<int> _expandedGroupIds = new();
    private decimal _plannedAmount;
    private bool _allowRollover;
    private string? _notes;
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Load category groups
        var groups = await CategoryService.GetCategoryGroupsAsync(UserId, includeCategories: true);
        _categoryGroups = groups;

        // Group available categories by their group
        _availableCategoriesByGroup = AvailableCategories
            .GroupBy(c => c.CategoryGroupId)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private bool IsGroupFullySelected(int groupId)
    {
        if (!_availableCategoriesByGroup.ContainsKey(groupId))
            return false;

        var groupCategories = _availableCategoriesByGroup[groupId];
        return groupCategories.All(c => _selectedCategoryIds.Contains(c.Id));
    }

    private bool IsGroupExpanded(int groupId)
    {
        return _expandedGroupIds.Contains(groupId);
    }

    private void ToggleGroupExpansion(int groupId)
    {
        if (_expandedGroupIds.Contains(groupId))
            _expandedGroupIds.Remove(groupId);
        else
            _expandedGroupIds.Add(groupId);
    }

    private void ToggleGroup(int groupId, bool selected)
    {
        if (!_availableCategoriesByGroup.ContainsKey(groupId))
            return;

        var groupCategories = _availableCategoriesByGroup[groupId];
        
        if (selected)
        {
            // Select all categories in group
            foreach (var category in groupCategories)
            {
                _selectedCategoryIds.Add(category.Id);
            }
        }
        else
        {
            // Deselect all categories in group
            foreach (var category in groupCategories)
            {
                _selectedCategoryIds.Remove(category.Id);
            }
        }
        
        InvokeAsync(StateHasChanged);
    }

    private void ToggleCategory(int categoryId, bool selected)
    {
        if (selected)
            _selectedCategoryIds.Add(categoryId);
        else
            _selectedCategoryIds.Remove(categoryId);
            
        InvokeAsync(StateHasChanged);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        _errorMessage = null;

        if (_selectedCategoryIds.Count == 0)
        {
            _errorMessage = L["AddCatBudgetDlg_SelectAtLeastOne"];
            return;
        }

        if (_plannedAmount < 0)
        {
            _errorMessage = L["BudgetAsgnDlg_AmountNegative"];
            return;
        }

        _isSubmitting = true;

        try
        {
            var addedCategories = new List<BudgetCategory>();
            
            foreach (var categoryId in _selectedCategoryIds)
            {
                BudgetCategory budgetCategory;
                
                if (IsNewBudget)
                {
                    // For new budgets, create temporary BudgetCategory objects
                    var category = AvailableCategories.First(c => c.Id == categoryId);
                    budgetCategory = new BudgetCategory
                    {
                        CategoryId = categoryId,
                        PlannedAmount = _plannedAmount,
                        AllowRollover = _allowRollover,
                        Notes = _notes,
                        Category = category
                    };
                }
                else
                {
                    // For existing budgets, save to database
                    budgetCategory = await BudgetService.AddCategoryToBudgetAsync(
                        BudgetId, 
                        UserId, 
                        categoryId, 
                        _plannedAmount, 
                        _allowRollover,
                        _notes);
                }
                
                addedCategories.Add(budgetCategory);
            }

            MudDialog.Close(DialogResult.Ok(addedCategories));
        }
        catch (Exception ex)
        {
            _errorMessage = string.Format(L["Msg_Error"], ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
