@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Application.Settings
@using MoneyBrain.Web.Application.Reporting.Cashflow
@using MoneyBrain.Web.Application.Reporting.NetWorth
@using MoneyBrain.Web.Application.Reporting.BudgetComparison
@using MoneyBrain.Web.Application.Budgets
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums

@attribute [Authorize]
@inject IAccountService AccountService
@inject IUserSettingsService SettingsService
@inject ICashflowService CashflowService
@inject INetWorthService NetWorthService
@inject IBudgetComparisonService BudgetComparisonService
@inject IBudgetService BudgetService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Dashboard | MoneyBrain</PageTitle>

<div class="mb-page mb-animate-in">
    @if (_loading)
    {
        <DashboardLoader />
    }
    else
    {
        <!-- Overview Section -->
        <div class="mb-section-header mt-6">
            <h2 class="mb-section-title">Overview</h2>
            <div class="d-flex align-center gap-2">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="MudBlazor.Size.Small" OnClick="PreviousMonth" />
                <div class="mb-date-range">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="MudBlazor.Size.Small" />
                    @_periodStart.ToString("MMM dd, yyyy") – @_periodEnd.ToString("MMM dd, yyyy")
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="MudBlazor.Size.Small" OnClick="NextMonth" Disabled="@(_periodEnd >= DateTime.Today)" />
            </div>
        </div>
        
        <!-- Stats Cards -->
        <div class="mb-grid-stats mb-4">
            <div class="mb-card-stat">
                <div class="mb-label">Total Balance</div>
                <div class="mb-amount @GetBalanceClass(_totalBalance)">@FormatCurrency(_totalBalance)</div>
            </div>
            <div class="mb-card-stat info">
                <div class="mb-label">Period Change</div>
                <div class="mb-amount @GetBalanceClass(_periodChange)">@FormatCurrency(_periodChange)</div>
            </div>
            <div class="mb-card-stat expense">
                <div class="mb-label">Total Expenses</div>
                <div class="mb-amount negative">@FormatCurrency(_totalExpenses)</div>
            </div>
            <div class="mb-card-stat income">
                <div class="mb-label">Total Income</div>
                <div class="mb-amount positive">@FormatCurrency(_totalIncome)</div>
            </div>
        </div>
        
        <!-- Budget Summary -->
        @* @if (_budgetComparison != null && _budgetComparison.TotalBudgeted > 0)
        { *@
            <div class="mb-section-header mt-6">
                <h2 class="mb-section-title">Budget Summary</h2>
                <MudButton Variant="Variant.Text" 
                           Color="Color.Primary" 
                           EndIcon="@Icons.Material.Filled.ArrowForward"
                           OnClick="@(() => NavigationManager.NavigateTo("/budgets"))">
                    View All Budgets
                </MudButton>
            </div>
            
            @if (_activeBudgets.Any())
            {
                <MudPaper Class="pa-3 mb-4">
                    <MudText Typo="Typo.body2" Style="font-weight: 500; margin-bottom: 8px;">Active Budgets for @_periodStart.ToString("MMMM yyyy")</MudText>
                    <MudStack Row="true" Spacing="2">
                        @foreach (var budget in _activeBudgets)
                        {
                            <MudChip T="string" 
                                     Size="Size.Small" 
                                     Color="@(budget.IsDefault ? Color.Info : Color.Primary)"
                                     Icon="@(budget.IsDefault ? Icons.Material.Filled.Star : Icons.Material.Filled.AccountBalanceWallet)">
                                @budget.Name @(!string.IsNullOrWhiteSpace(budget.Description) ? $" - {budget.Description}" : "")
                            </MudChip>
                        }
                    </MudStack>
                </MudPaper>
            }
            
            <div class="mb-grid-stats mb-4">
                <div class="mb-card-stat">
                    <div class="mb-label">Budgeted This Month</div>
                    <div class="mb-amount neutral">@FormatCurrency(_budgetComparison.TotalBudgeted)</div>
                </div>
                <div class="mb-card-stat @(_budgetComparison.IsOverBudget ? "expense" : "income")">
                    <div class="mb-label">Actual Spending</div>
                    <div class="mb-amount @(_budgetComparison.IsOverBudget ? "negative" : "positive")">@FormatCurrency(_budgetComparison.TotalActual)</div>
                </div>
                <div class="mb-card-stat @(_budgetComparison.Remaining >= 0 ? "income" : "expense")">
                    <div class="mb-label">Remaining</div>
                    <div class="mb-amount @GetBalanceClass(_budgetComparison.Remaining)">@FormatCurrency(_budgetComparison.Remaining)</div>
                </div>
                <div class="mb-card-stat @GetBudgetHealthClass(_budgetComparison.PercentageUsed)">
                    <div class="mb-label">Budget Used</div>
                    <div class="mb-amount">@_budgetComparison.PercentageUsed.ToString("F1")%</div>
                </div>
            </div>
            
            @if (_budgetComparison.Categories.Any())
            {
                <MudPaper Class="pa-4 mb-4">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudText Typo="Typo.h6">Top Budget Categories</MudText>
                        @if (_budgetComparison.CategoriesOverBudget > 0)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">@_budgetComparison.CategoriesOverBudget over budget</MudChip>
                        }
                    </div>
                    <MudStack Spacing="2">
                        @foreach (var category in _budgetComparison.Categories.Take(5))
                        {
                            <div>
                                <div class="d-flex justify-space-between align-center mb-1">
                                    <MudText Typo="Typo.body2" Style="font-weight: 500;">@category.CategoryName</MudText>
                                    <MudText Typo="Typo.body2">
                                        <span class="@(category.IsOverBudget ? "negative" : "")">@category.Actual.ToString("N2")</span> / @category.Budgeted.ToString("N2") @_currencyCode
                                    </MudText>
                                </div>
                                <MudProgressLinear Color="@(category.IsOverBudget ? Color.Error : category.PercentageUsed > 90 ? Color.Warning : Color.Success)" 
                                                   Value="@((double)Math.Min(category.PercentageUsed, 100))" 
                                                   Size="Size.Small" />
                            </div>
                        }
                    </MudStack>
                </MudPaper>
            }
        @* } *@
        
        <!-- Charts Section -->
        <div class="mb-grid-charts">
            <div class="mb-chart-container">
                <div class="mb-chart-header">
                    <div>
                        <div class="mb-chart-title">Income vs Expenses</div>
                        <div class="mb-chart-subtitle">@_periodStart.ToString("MMMM yyyy")</div>
                    </div>
                </div>
                @if (_totalIncome > 0 || _totalExpenses > 0)
                {
                    <MudChart ChartType="ChartType.Bar" 
                              ChartSeries="@_incomeExpenseChartSeries" 
                              XAxisLabels="@_incomeExpenseChartLabels"
                              Width="100%" 
                              Height="250px"
                              ChartOptions="@(new ChartOptions { YAxisTicks = 5 })" />
                }
                else
                {
                    <div style="height: 250px; display: flex; align-items: center; justify-content: center; color: var(--mb-text-muted);">
                        <MudStack AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Outlined.BarChart" Style="font-size: 3rem; opacity: 0.5;" />
                            <MudText Typo="Typo.body2">No transactions this month</MudText>
                        </MudStack>
                    </div>
                }
            </div>
            
            <div class="mb-chart-container">
                <div class="mb-chart-header">
                    <div>
                        <div class="mb-chart-title">Top Expense Categories</div>
                        <div class="mb-chart-subtitle">@_periodStart.ToString("MMMM yyyy")</div>
                    </div>
                </div>
                @if (_totalExpenses > 0)
                {
                    <MudChart ChartType="ChartType.Donut" 
                              InputData="@_categoryPieData" 
                              InputLabels="@_categoryPieLabels"
                              Width="100%" 
                              Height="250px" />
                }
                else
                {
                    <div style="height: 250px; display: flex; align-items: center; justify-content: center; color: var(--mb-text-muted);">
                        <MudStack AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Outlined.PieChart" Style="font-size: 3rem; opacity: 0.5;" />
                            <MudText Typo="Typo.body2">No expenses this month</MudText>
                        </MudStack>
                    </div>
                }
            </div>
        </div>
        
        <!-- Trend Charts Section -->
        @if (_hasTrendData)
        {
            <div class="mb-section-header mt-6">
                <h2 class="mb-section-title">Trends (Last 6 Months)</h2>
            </div>
            
            <div class="mb-grid-charts">
                <div class="mb-chart-container">
                    <div class="mb-chart-header">
                        <div>
                            <div class="mb-chart-title">Net Worth Trend</div>
                            <div class="mb-chart-subtitle">Financial health over time</div>
                        </div>
                    </div>
                    @if (_netWorthTrendSeries.Any() && _netWorthTrendSeries[0].Data.Length > 0)
                    {
                        <MudChart ChartType="ChartType.Line" 
                                  ChartSeries="@_netWorthTrendSeries" 
                                  XAxisLabels="@_netWorthTrendLabels"
                                  Width="100%" 
                                  Height="250px"
                                  ChartOptions="@(new ChartOptions { YAxisTicks = 5, LineStrokeWidth = 3 })" />
                    }
                    else
                    {
                        <div style="height: 250px; display: flex; align-items: center; justify-content: center; color: var(--mb-text-muted);">
                            <MudStack AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Outlined.TrendingUp" Style="font-size: 3rem; opacity: 0.5;" />
                                <MudText Typo="Typo.body2">Not enough data yet</MudText>
                            </MudStack>
                        </div>
                    }
                </div>
                
                <div class="mb-chart-container">
                    <div class="mb-chart-header">
                        <div>
                            <div class="mb-chart-title">Monthly Cashflow</div>
                            <div class="mb-chart-subtitle">Income vs Expenses over time</div>
                        </div>
                    </div>
                    @if (_cashflowTrendSeries.Any() && _cashflowTrendSeries[0].Data.Length > 0)
                    {
                        <MudChart ChartType="ChartType.Line" 
                                  ChartSeries="@_cashflowTrendSeries" 
                                  XAxisLabels="@_cashflowTrendLabels"
                                  Width="100%" 
                                  Height="250px"
                                  ChartOptions="@(new ChartOptions { YAxisTicks = 5, LineStrokeWidth = 3 })" />
                    }
                    else
                    {
                        <div style="height: 250px; display: flex; align-items: center; justify-content: center; color: var(--mb-text-muted);">
                            <MudStack AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Outlined.ShowChart" Style="font-size: 3rem; opacity: 0.5;" />
                                <MudText Typo="Typo.body2">Not enough data yet</MudText>
                            </MudStack>
                        </div>
                    }
                </div>
            </div>
        }
    }
    
    <HelpButton Title="Dashboard Help"
                Description="The Dashboard is your financial command center. Get a quick overview of your budgets, net worth, and recent financial activity at a glance."
                Features="@(new[] { 
                    "View active budgets for the current month",
                    "Track your total net worth (assets minus liabilities)",
                    "Monitor budget vs actual spending",
                    "See top spending categories with progress bars",
                    "Review monthly income vs expenses breakdown"
                })"
                HowToUse="@(new[] {
                    "Check the Budget Summary to see overall budget health",
                    "Review active budgets to see which budgets apply this month",
                    "Use the progress bars to identify over-budget categories",
                    "Monitor the cashflow chart to spot spending patterns"
                })"
                Tips="@(new[] {
                    "Green progress bars indicate spending within budget",
                    "Red progress bars indicate over-budget categories",
                    "The dashboard updates automatically when you add transactions",
                    "Navigate between months to see budget trends over time"
                })" />
</div>

@code {
    private bool _loading = true;
    private string? _userId;
    private string _currencyCode = "USD";
    
    private DateTime _periodStart;
    private DateTime _periodEnd;
    
    private decimal _totalBalance;
    private decimal _periodChange;
    private decimal _totalExpenses;
    private decimal _totalIncome;
    
    // Chart data
    private List<ChartSeries> _incomeExpenseChartSeries = [];
    private string[] _incomeExpenseChartLabels = [];
    private double[] _categoryPieData = [];
    private string[] _categoryPieLabels = [];
    
    // Trend chart data
    private List<ChartSeries> _netWorthTrendSeries = [];
    private string[] _netWorthTrendLabels = [];
    private List<ChartSeries> _cashflowTrendSeries = [];
    private string[] _cashflowTrendLabels = [];
    private bool _hasTrendData = false;
    
    // Budget data
    private MonthlyBudgetComparisonDto? _budgetComparison;
    private List<Budget> _activeBudgets = [];

    protected override async Task OnInitializedAsync()
    {
        // Set period to current month
        var today = DateTime.Today;
        _periodStart = new DateTime(today.Year, today.Month, 1);
        _periodEnd = _periodStart.AddMonths(1).AddDays(-1);
        
        await LoadDataAsync();
        _loading = false;
    }

    private async Task LoadDataAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (string.IsNullOrEmpty(_userId)) return;
        
        // Load user settings
        var settings = await SettingsService.GetSettingsAsync(_userId);
        if (settings != null)
        {
            _currencyCode = settings.CurrencyCode;
        }
        
        // Calculate net worth for total balance
        var netWorth = await NetWorthService.GetNetWorthSnapshotAsync(_userId, DateTime.Today);
        _totalBalance = netWorth.NetWorth;
        
        // Load cashflow data for the selected period
        var cashflow = await CashflowService.GetMonthCashflowAsync(_userId, _periodStart.Year, _periodStart.Month);
        _totalIncome = cashflow.TotalIncome;
        _totalExpenses = cashflow.TotalExpenses;
        _periodChange = cashflow.NetCashflow;
        
        // Prepare chart data
        PrepareChartData(cashflow);
        
        // Load budget data for the selected period
        await LoadBudgetDataAsync();
        
        // Load trend data (last 6 months)
        await LoadTrendDataAsync();
    }
    
    private async Task LoadBudgetDataAsync()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        
        try
        {
            _budgetComparison = await BudgetComparisonService.GetMonthlyBudgetComparisonAsync(
                _userId, 
                _periodStart.Year, 
                _periodStart.Month);
                
            // Load active budgets for the current period
            var periodBudgets = await BudgetService.GetBudgetsForPeriodAsync(_userId, _periodStart.Year, _periodStart.Month);
            var defaultBudgets = await BudgetService.GetDefaultBudgetsAsync(_userId);
            
            // Use period-specific budgets if available, otherwise default budgets
            _activeBudgets = periodBudgets.Any() ? periodBudgets : defaultBudgets;
        }
        catch
        {
            // Budget comparison not available - this is okay
            _budgetComparison = null;
            _activeBudgets = [];
        }
    }
    
    private async Task LoadTrendDataAsync()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        
        var endDate = DateTime.Today;
        var startDate = endDate.AddMonths(-5).AddDays(1 - endDate.Day); // Start of month, 6 months ago
        
        // Load cashflow trend
        var cashflowData = await CashflowService.GetMonthlyCashflowAsync(_userId, startDate, endDate);
        
        if (cashflowData.Any())
        {
            _hasTrendData = true;
            
            // Prepare cashflow trend chart
            var orderedCashflow = cashflowData.OrderBy(c => c.Year).ThenBy(c => c.Month).ToList();
            _cashflowTrendLabels = orderedCashflow.Select(c => new DateTime(c.Year, c.Month, 1).ToString("MMM")).ToArray();
            _cashflowTrendSeries = new List<ChartSeries>
            {
                new ChartSeries { Name = "Income", Data = orderedCashflow.Select(c => (double)c.TotalIncome).ToArray() },
                new ChartSeries { Name = "Expenses", Data = orderedCashflow.Select(c => (double)c.TotalExpenses).ToArray() }
            };
        }
        
        // Load net worth trend
        var netWorthHistory = await NetWorthService.GetNetWorthHistoryAsync(_userId, startDate, endDate, intervalDays: 30);
        
        if (netWorthHistory.Snapshots.Any())
        {
            _hasTrendData = true;
            
            _netWorthTrendLabels = netWorthHistory.Snapshots.Select(s => s.Date.ToString("MMM")).ToArray();
            _netWorthTrendSeries = new List<ChartSeries>
            {
                new ChartSeries { Name = "Net Worth", Data = netWorthHistory.Snapshots.Select(s => (double)s.NetWorth).ToArray() }
            };
        }
    }

    private async Task PreviousMonth()
    {
        _periodStart = _periodStart.AddMonths(-1);
        _periodEnd = _periodStart.AddMonths(1).AddDays(-1);
        await LoadDataAsync();
    }

    private async Task NextMonth()
    {
        if (_periodEnd >= DateTime.Today) return;
        _periodStart = _periodStart.AddMonths(1);
        _periodEnd = _periodStart.AddMonths(1).AddDays(-1);
        if (_periodEnd > DateTime.Today) _periodEnd = DateTime.Today;
        await LoadDataAsync();
    }

    private string FormatCurrency(decimal amount)
    {
        var sign = amount >= 0 ? "+" : "";
        return $"{sign}{amount:N2} {_currencyCode}";
    }

    private string GetBalanceClass(decimal amount) => amount switch
    {
        > 0 => "positive",
        < 0 => "negative",
        _ => "neutral"
    };

    private void PrepareChartData(MonthlyCashflowDto cashflow)
    {
        // Prepare income vs expenses bar chart
        _incomeExpenseChartLabels = new[] { "Income", "Expenses" };
        _incomeExpenseChartSeries = new List<ChartSeries>
        {
            new ChartSeries { Name = "Amount", Data = new double[] { (double)cashflow.TotalIncome, (double)cashflow.TotalExpenses } }
        };
        
        // Prepare expense category pie chart (top 5 categories)
        var topCategories = cashflow.ExpensesByCategory
            .OrderByDescending(c => c.Amount)
            .Take(5)
            .ToList();
        
        if (topCategories.Any())
        {
            _categoryPieData = topCategories.Select(c => (double)c.Amount).ToArray();
            _categoryPieLabels = topCategories.Select(c => c.CategoryName).ToArray();
        }
        else
        {
            _categoryPieData = new double[] { 1 };
            _categoryPieLabels = new[] { "No expenses" };
        }
    }
    
    private string GetBudgetHealthClass(decimal percentageUsed) => percentageUsed switch
    {
        <= 75 => "income",
        <= 90 => "info",
        <= 100 => "",
        _ => "expense"
    };
}
