#nullable enable
@page "/insights"
@using Microsoft.AspNetCore.Authorization
@using MoneyBrain.Web.Application.InsightExplorer
@using MoneyBrain.Web.Application.InsightExplorer.Models
@using MoneyBrain.Web.Domain.Entities
@using InsightChartType = MoneyBrain.Web.Application.InsightExplorer.Models.ChartType
@using InsightFilterOperator = MoneyBrain.Web.Application.InsightExplorer.Models.FilterOperator
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Resources
@attribute [Authorize]


<PageTitle>@L["Insight_PageTitle"]</PageTitle>

<div class="mb-page mb-animate-in">
    <div class="mb-section-header">
        <div>
            <h1 class="mb-title">@L["Insight_Header"]</h1>
            <p class="mb-subtitle">@L["Insight_Subtitle"]</p>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="OpenSaveDialog" Disabled="@(!_hasChanges)">
                @L["Insight_SaveQuery"]
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FolderOpen"
                       OnClick="OpenLoadDialog">
                @L["Insight_LoadQuery"]
            </MudButton>
            <MudButton Variant="Variant.Filled" Class="mb-btn-primary"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       OnClick="ExecuteQuery" Disabled="@_isLoading">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @L["Insight_RunQuery"]
            </MudButton>
        </div>
    </div>

    <!-- Query Builder Section -->
    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <!-- Target Entity Selection -->
            <MudItem xs="12" md="4">
                <MudSelect T="QueryTargetEntity" Value="_query.TargetEntity"
                           Label="@L["Insight_QueryTarget"]" Variant="Variant.Outlined"
                           ValueChanged="OnTargetEntityChanged">
                    <MudSelectItem T="QueryTargetEntity" Value="QueryTargetEntity.Transaction">@L["Insight_TargetTransactions"]</MudSelectItem>
                    <MudSelectItem T="QueryTargetEntity" Value="QueryTargetEntity.Account">@L["Insight_TargetAccounts"]</MudSelectItem>
                    <MudSelectItem T="QueryTargetEntity" Value="QueryTargetEntity.Category">@L["Insight_TargetCategories"]</MudSelectItem>
                    <MudSelectItem T="QueryTargetEntity" Value="QueryTargetEntity.Payee">@L["Insight_TargetPayees"]</MudSelectItem>
                    <MudSelectItem T="QueryTargetEntity" Value="QueryTargetEntity.Budget">@L["Insight_TargetBudgets"]</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <!-- Filter Conditions -->
        <MudText Typo="Typo.h6" Class="mt-4 mb-2">@L["Insight_Filters"]</MudText>
        @for (var i = 0; i < _query.Filters.Count; i++)
        {
            var index = i;
            var filter = _query.Filters[i];
            <MudPaper @key="index" Class="pa-3 mb-2" Elevation="0" Style="background: var(--mud-palette-background-gray);">
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" Value="filter.Property"
                                   Label="@L["Insight_Property"]" Variant="Variant.Outlined" Dense="true"
                                   ValueChanged="@(v => OnPropertyChanged(index, v))">
                            @foreach (var prop in _availableProperties.Where(p => p.IsFilterable))
                            {
                                <MudSelectItem @key="prop.Name" T="string" Value="@prop.Name">@prop.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="InsightFilterOperator" Value="filter.Operator"
                                   Label="@L["Insight_Operator"]" Variant="Variant.Outlined" Dense="true"
                                   ValueChanged="@(v => OnOperatorChanged(index, v))">
                            @foreach (var op in GetOperatorsForDataType(filter.DataType))
                            {
                                <MudSelectItem @key="op" T="InsightFilterOperator" Value="@op">@FormatOperator(op)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        @if (filter.Operator != InsightFilterOperator.IsNull && filter.Operator != InsightFilterOperator.IsNotNull)
                        {
                            @if (filter.DataType == PropertyDataType.Boolean)
                            {
                                <MudSelect T="string" Value="filter.Value"
                                           Label="@L["Insight_Value"]" Variant="Variant.Outlined" Dense="true"
                                           ValueChanged="@(v => OnValueChanged(index, v))">
                                    <MudSelectItem T="string" Value="@("true")">@L["Common_Yes"]</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("false")">@L["Common_No"]</MudSelectItem>
                                </MudSelect>
                            }
                            else if (filter.DataType == PropertyDataType.Enum)
                            {
                                var propMeta = _availableProperties.FirstOrDefault(p => p.Name == filter.Property);
                                <MudSelect T="string" Value="filter.Value"
                                           Label="@L["Insight_Value"]" Variant="Variant.Outlined" Dense="true"
                                           ValueChanged="@(v => OnValueChanged(index, v))">
                                    @if (propMeta?.EnumValues != null)
                                    {
                                        @foreach (var enumVal in propMeta.EnumValues)
                                        {
                                            <MudSelectItem @key="enumVal" T="string" Value="@enumVal">@enumVal</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            }
                            else if (filter.DataType == PropertyDataType.DateTime)
                            {
                                <MudDatePicker Date="@(_filterDates.GetValueOrDefault(index))" Label="@L["Insight_Value"]"
                                               Variant="Variant.Outlined" dense="true"
                                               DateChanged="@(d => OnDateFilterChanged(index, d))" />
                            }
                            else
                            {
                                <MudTextField T="string" Value="filter.Value"
                                              Label="@L["Insight_Value"]" Variant="Variant.Outlined" dense="true"
                                              ValueChanged="@(v => OnValueChanged(index, v))" />
                            }

                            @if (filter.Operator == InsightFilterOperator.Between)
                            {
                                @if (filter.DataType == PropertyDataType.DateTime)
                                {
                                    <MudDatePicker Date="@(_filterSecondDates.GetValueOrDefault(index))" Label="@L["Insight_ToValue"]"
                                                   Variant="Variant.Outlined" dense="true" Class="mt-2"
                                                   DateChanged="@(d => OnSecondDateFilterChanged(index, d))" />
                                }
                                else
                                {
                                    <MudTextField T="string" Value="filter.SecondValue"
                                                  Label="@L["Insight_ToValue"]" Variant="Variant.Outlined" dense="true" Class="mt-2"
                                                  ValueChanged="@(v => OnSecondValueChanged(index, v))" />
                                }
                            }
                        }
                    </MudItem>
                    <MudItem xs="12" md="2" Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                       OnClick="@(() => RemoveFilter(index))" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddFilter" Color="Color.Primary">
            @L["Insight_AddFilter"]
        </MudButton>

        <!-- Aggregation (Optional) -->
        <MudExpansionPanels Class="mt-4">
            <MudExpansionPanel Text="@L["Insight_AggregationOptional"]">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudSwitch T="bool" Value="_useAggregation" Label="@L["Insight_EnableAggregation"]"
                                   Color="Color.Primary" ValueChanged="OnAggregationToggled" />
                    </MudItem>
                    @if (_useAggregation)
                    {
                        <MudItem xs="12" md="4">
                            <MudSelect T="AggregationFunction" Value="_aggregationFunction"
                                       Label="@L["Insight_Function"]" Variant="Variant.Outlined"
                                       ValueChanged="OnAggregationFunctionChanged">
                                <MudSelectItem T="AggregationFunction" Value="AggregationFunction.Sum">@L["Insight_FuncSum"]</MudSelectItem>
                                <MudSelectItem T="AggregationFunction" Value="AggregationFunction.Count">@L["Insight_FuncCount"]</MudSelectItem>
                                <MudSelectItem T="AggregationFunction" Value="AggregationFunction.Average">@L["Insight_FuncAverage"]</MudSelectItem>
                                <MudSelectItem T="AggregationFunction" Value="AggregationFunction.Min">@L["Insight_FuncMin"]</MudSelectItem>
                                <MudSelectItem T="AggregationFunction" Value="AggregationFunction.Max">@L["Insight_FuncMax"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="string" Value="_aggregationProperty"
                                       Label="@L["Insight_AggregateProperty"]" Variant="Variant.Outlined"
                                       ValueChanged="OnAggregationPropertyChanged">
                                @foreach (var prop in _availableProperties.Where(p => p.IsAggregatable))
                                {
                                    <MudSelectItem @key="prop.Name" T="string" Value="@prop.Name">@prop.DisplayName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="string" Value="_groupByProperty"
                                       Label="@L["Lbl_Group"]" Variant="Variant.Outlined"
                                       ValueChanged="OnGroupByChanged">
                                <MudSelectItem T="string" Value="@string.Empty">@L["Common_None"]</MudSelectItem>
                                @foreach (var prop in _availableProperties.Where(p => p.IsGroupable))
                                {
                                    <MudSelectItem @key="prop.Name" T="string" Value="@prop.Name">@prop.DisplayName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                </MudGrid>
            </MudExpansionPanel>
            <MudExpansionPanel Text="@L["Insight_ChartSettingsOptional"]">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudSwitch T="bool" Value="_useChart" Label="@L["Insight_EnableChart"]"
                                   Color="Color.Primary" ValueChanged="OnChartToggled" />
                    </MudItem>
                    @if (_useChart)
                    {
                        <MudItem xs="12" md="4">
                            <MudSelect T="InsightChartType" Value="_chartType"
                                       Label="@L["Insight_ChartType"]" Variant="Variant.Outlined"
                                       ValueChanged="OnChartTypeChanged">
                                <MudSelectItem T="InsightChartType" Value="InsightChartType.Bar">@L["Insight_ChartBar"]</MudSelectItem>
                                <MudSelectItem T="InsightChartType" Value="InsightChartType.Line">@L["Insight_ChartLine"]</MudSelectItem>
                                <MudSelectItem T="InsightChartType" Value="InsightChartType.Pie">@L["Insight_ChartPie"]</MudSelectItem>
                                <MudSelectItem T="InsightChartType" Value="InsightChartType.Donut">@L["Insight_ChartDonut"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Value="_chartTitle"
                                          Label="@L["Insight_ChartTitle"]" Variant="Variant.Outlined"
                                          ValueChanged="OnChartTitleChanged" />
                        </MudItem>
                    }
                </MudGrid>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudPaper>

    <!-- Results Section with Tabs -->
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
        <MudTabPanel Text="@L["Insight_DataTable"]" Icon="@Icons.Material.Filled.TableChart">
            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_result != null && (_result.Rows.Count > 0 || _result.AggregatedRows.Count > 0))
            {
                @if (_result.AggregatedRows.Count > 0)
                {
                    <MudDataGrid T="AggregatedRow" Items="@_result.AggregatedRows"
                                 Dense="true" Hover="true">
                        <Columns>
                            @foreach (var col in _result.Columns)
                            {
                                <TemplateColumn @key="col.Name" T="AggregatedRow" Title="@col.DisplayName">
                                    <CellTemplate>
                                        @GetAggregatedValue(context.Item, col.Name)
                                    </CellTemplate>
                                </TemplateColumn>
                            }
                        </Columns>
                    </MudDataGrid>
                    <MudText Typo="Typo.caption" Class="mt-2">@L["Insight_TotalRows"]: @_result.TotalCount</MudText>
                }
                else
                {
                    <MudDataGrid T="Dictionary<string, object?>" Items="@_result.Rows"
                                 Dense="true" Hover="true" Virtualize="true">
                        <Columns>
                            @foreach (var col in _result.Columns)
                            {
                                <TemplateColumn @key="col.Name" T="Dictionary<string, object?>" Title="@col.DisplayName">
                                    <CellTemplate>
                                        @FormatValue(context.Item.GetValueOrDefault(col.Name), col.DataType)
                                    </CellTemplate>
                                </TemplateColumn>
                            }
                        </Columns>
                    </MudDataGrid>
                    <MudText Typo="Typo.caption" Class="mt-2">@L["Insight_ShowingRows", _result.Rows.Count, _result.TotalCount]</MudText>
                }
            }
            else if (_hasExecuted)
            {
                <MudAlert Severity="Severity.Info">@L["Insight_NoResultsFound"]</MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info">@L["Insight_RunQueryToSeeResults"]</MudAlert>
            }
        </MudTabPanel>
        <MudTabPanel Text="@L["Insight_Chart"]" Icon="@Icons.Material.Filled.BarChart">
            @if (_result?.ChartData != null && _result.ChartData.Labels.Length > 0)
            {
                @if (!string.IsNullOrEmpty(_chartTitle))
                {
                    <MudText Typo="Typo.h6" Class="mb-4">@_chartTitle</MudText>
                }
                @if (_chartType == InsightChartType.Line || _chartType == InsightChartType.Bar)
                {
                    <MudChart ChartType="@GetMudChartType()"
                              ChartSeries="@_chartSeries"
                              XAxisLabels="@_result.ChartData.Labels"
                              Width="100%" Height="400px"
                              ChartOptions="@_chartOptions" />
                }
                else
                {
                    <MudChart ChartType="@GetMudChartType()"
                              InputData="@_result.ChartData.Data"
                              InputLabels="@_result.ChartData.Labels"
                              Width="100%" Height="400px"
                              ChartOptions="@_chartOptions" />
                }
            }
            else if (_hasExecuted)
            {
                <MudAlert Severity="Severity.Info">@L["Insight_ConfigureAggregationForChart"]</MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info">@L["Insight_ConfigureChartAndRun"]</MudAlert>
            }
        </MudTabPanel>
    </MudTabs>

    @if (_loadedQueryName != null)
    {
        <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">@L["Insight_LoadedQuery"]: @_loadedQueryName</MudText>
    }
</div>

<!-- Save Query Dialog -->
<MudDialog @bind-Visible="_showSaveDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Insight_SaveQueryTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_saveQueryName" Label="@L["Insight_QueryName"]"
                      Variant="Variant.Outlined" Required="true" Class="mb-4" />
        <MudTextField T="string" @bind-Value="_saveQueryDescription" Label="@L["Insight_DescriptionOptional"]"
                      Variant="Variant.Outlined" Lines="2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showSaveDialog = false)">@L["Btn_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="SaveQuery" Disabled="@string.IsNullOrWhiteSpace(_saveQueryName)">@L["Btn_Save"]</MudButton>
    </DialogActions>
</MudDialog>

<!-- Load Query Dialog -->
<MudDialog @bind-Visible="_showLoadDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Insight_LoadQueryTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        @if (_savedQueries.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@L["Insight_NoSavedQueries"]</MudAlert>
        }
        else
        {
            <MudList T="SavedQuery" Dense="true">
                @foreach (var sq in _savedQueries)
                {
                    <MudListItem @key="sq.Id">
                        <div class="d-flex justify-space-between align-center" style="width: 100%;">
                            <div>
                                <MudText Typo="Typo.body1">@sq.Name</MudText>
                                @if (!string.IsNullOrEmpty(sq.Description))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@sq.Description</MudText>
                                }
                                <MudText Typo="Typo.caption">@L["Insight_Updated"]: @sq.UpdatedAt.ToString("g")</MudText>
                            </div>
                            <div>
                                <MudIconButton Icon="@Icons.Material.Filled.FileOpen" Color="Color.Primary"
                                               OnClick="@(() => LoadQuery(sq))" title="@L["Insight_Load"]" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               OnClick="@(() => DeleteSavedQuery(sq))" title="@L["Btn_Delete"]" />
                            </div>
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showLoadDialog = false)">@L["Btn_Close"]</MudButton>
    </DialogActions>
</MudDialog>

