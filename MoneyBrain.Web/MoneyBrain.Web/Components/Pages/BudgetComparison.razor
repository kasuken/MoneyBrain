@page "/budget-comparison"
@using Microsoft.AspNetCore.Authorization
@using MoneyBrain.Web.Application.Reporting.BudgetComparison
@using MoneyBrain.Web.Application.Reporting.CsvExport
@using Microsoft.JSInterop
@using MudBlazor
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Resources
@attribute [Authorize]
@inject IBudgetComparisonService BudgetComparisonService
@inject ICsvExportService CsvExportService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SharedResource> L
@inject ICurrencyFormattingService CurrencyFormattingService

<PageTitle>@L["BudgetVsActual_PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@L["BudgetVsActual_Header"]</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="@L["Lbl_StartDate"]" 
                               @bind-Date="_startDate" 
                               @bind-Date:after="LoadDataAsync"
                               PickerVariant="PickerVariant.Dialog"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="@L["Lbl_EndDate"]" 
                               @bind-Date="_endDate"
                               @bind-Date:after="LoadDataAsync"
                               PickerVariant="PickerVariant.Dialog"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="ExportToCsv"
                           Disabled="@(_summary == null)"
                           FullWidth="true">
                    @L["BudgetVsActual_ExportToCsv"]
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_summary != null)
    {
        <!-- Summary Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.body2" Color="Color.Default">@L["BudgetVsActual_TotalBudgeted"]</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary">@CurrencyFormattingService.FormatCurrency(_summary.TotalBudgeted, _userSettings?.CurrencyCode ?? "USD")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.body2" Color="Color.Default">@L["BudgetVsActual_TotalActual"]</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Secondary">@CurrencyFormattingService.FormatCurrency(_summary.TotalActual, _userSettings?.CurrencyCode ?? "USD")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.body2" Color="Color.Default">@L["BudgetVsActual_Remaining"]</MudText>
                    <MudText Typo="Typo.h5" Color="@(_summary.TotalRemaining >= 0 ? Color.Success : Color.Error)">
                        @CurrencyFormattingService.FormatCurrency(_summary.TotalRemaining, _userSettings?.CurrencyCode ?? "USD")
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.body2" Color="Color.Default">@L["BudgetVsActual_BudgetUsed"]</MudText>
                    <MudText Typo="Typo.h5">
                        @_summary.OverallPercentageUsed.ToString("F1")%
                        <MudChip T="string" Size="Size.Small" Color="@GetPercentageColor(_summary.OverallPercentageUsed)">
                            @GetPercentageStatus(_summary.OverallPercentageUsed)
                        </MudChip>
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Budget Usage Chart -->
        @if (_chartData.Any())
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-4">@L["BudgetVsActual_MonthlyBudgetUsage"]</MudText>
                <MudChart ChartType="ChartType.Bar" 
                          ChartSeries="_chartSeries" 
                          XAxisLabels="_chartData.Select(d => d.MonthName).ToArray()"
                          Width="100%" 
                          Height="350px"
                          ChartOptions="_chartOptions" />
            </MudPaper>
        }

        <!-- Monthly Breakdown Table -->
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-4">@L["BudgetVsActual_MonthlyBreakdown"]</MudText>
            <MudTable Items="_summary.MonthlyComparisons" 
                      Hover="true" 
                      Dense="true"
                      FixedHeader="true"
                      Height="600px">
                <HeaderContent>
                    <MudTh>@L["Col_Month"]</MudTh>
                    <MudTh Style="text-align: right;">@L["BudgetVsActual_Budgeted"]</MudTh>
                    <MudTh Style="text-align: right;">@L["BudgetVsActual_Actual"]</MudTh>
                    <MudTh Style="text-align: right;">@L["BudgetVsActual_Remaining"]</MudTh>
                    <MudTh Style="text-align: right;">@L["BudgetVsActual_PercentUsed"]</MudTh>
                    <MudTh>@L["Col_Status"]</MudTh>
                    <MudTh Style="text-align: center;">@L["Lbl_Details"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Col_Month"]">@context.MonthName</MudTd>
                    <MudTd DataLabel="@L["BudgetVsActual_Budgeted"]" Style="text-align: right;">@CurrencyFormattingService.FormatCurrency(context.TotalBudgeted, _userSettings?.CurrencyCode ?? "USD")</MudTd>
                    <MudTd DataLabel="@L["BudgetVsActual_Actual"]" Style="text-align: right;">@CurrencyFormattingService.FormatCurrency(context.TotalActual, _userSettings?.CurrencyCode ?? "USD")</MudTd>
                    <MudTd DataLabel="@L["BudgetVsActual_Remaining"]" Style="text-align: right;">
                        <span style="color: @(context.Remaining >= 0 ? "green" : "red")">
                            @CurrencyFormattingService.FormatCurrency(context.Remaining, _userSettings?.CurrencyCode ?? "USD")
                        </span>
                    </MudTd>
                    <MudTd DataLabel="@L["BudgetVsActual_PercentUsed"]" Style="text-align: right;">@context.PercentageUsed.ToString("F1")%</MudTd>
                    <MudTd DataLabel="@L["Col_Status"]">
                        <MudChip T="string" Size="Size.Small" Color="@GetPercentageColor(context.PercentageUsed)">
                            @GetPercentageStatus(context.PercentageUsed)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="@L["Lbl_Details"]" Style="text-align: center;">
                        <MudIconButton Icon="@(_expandedMonths.Contains(context) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" 
                                       OnClick="@(() => ToggleMonthExpansion(context))"
                                       Size="Size.Small" />
                    </MudTd>
                </RowTemplate>
                <ChildRowContent>
                    @if (_expandedMonths.Contains(context))
                    {
                        <MudTr>
                            <td colspan="7">
                                <MudCard Elevation="0" Class="my-2">
                                    <MudCardContent>
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                                            @L["BudgetVsActual_CategoryBreakdown"] - @context.MonthName
                                        </MudText>
                                        
                                        @if (context.Categories.Any())
                                        {
                                            <MudTable Items="context.Categories" 
                                                      Hover="true" 
                                                      Dense="true"
                                                      Elevation="0">
                                                <HeaderContent>
                                                    <MudTh>@L["Col_Category"]</MudTh>
                                                    <MudTh>@L["Lbl_Group"]</MudTh>
                                                    <MudTh Style="text-align: right;">@L["BudgetVsActual_Budgeted"]</MudTh>
                                                    <MudTh Style="text-align: right;">@L["BudgetVsActual_Actual"]</MudTh>
                                                    <MudTh Style="text-align: right;">@L["BudgetVsActual_Remaining"]</MudTh>
                                                    <MudTh Style="text-align: right;">@L["BudgetVsActual_PercentUsed"]</MudTh>
                                                    <MudTh Style="text-align: center;">@L["Col_Transactions"]</MudTh>
                                                </HeaderContent>
                                                <RowTemplate Context="category">
                                                    <MudTd DataLabel="@L["Col_Category"]">
                                                        <strong>@category.CategoryName</strong>
                                                    </MudTd>
                                                    <MudTd DataLabel="@L["Lbl_Group"]">@(category.CategoryGroupName ?? "-")</MudTd>
                                                    <MudTd DataLabel="@L["BudgetVsActual_Budgeted"]" Style="text-align: right;">@CurrencyFormattingService.FormatCurrency(category.Budgeted, _userSettings?.CurrencyCode ?? "USD")</MudTd>
                                                    <MudTd DataLabel="@L["BudgetVsActual_Actual"]" Style="text-align: right;">@CurrencyFormattingService.FormatCurrency(category.Actual, _userSettings?.CurrencyCode ?? "USD")</MudTd>
                                                    <MudTd DataLabel="@L["BudgetVsActual_Remaining"]" Style="text-align: right;">
                                                        <span style="color: @(category.Remaining >= 0 ? "green" : "red")">
                                                            @CurrencyFormattingService.FormatCurrency(category.Remaining, _userSettings?.CurrencyCode ?? "USD")
                                                        </span>
                                                    </MudTd>
                                                    <MudTd DataLabel="@L["BudgetVsActual_PercentUsed"]" Style="text-align: right;">
                                                        @category.PercentageUsed.ToString("F1")%
                                                    </MudTd>
                                                    <MudTd DataLabel="@L["Col_Transactions"]" Style="text-align: center;">
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@category.TransactionCount</MudChip>
                                                    </MudTd>
                                                </RowTemplate>
                                            </MudTable>
                                        }
                                        else
                                        {
                                            <MudAlert Severity="Severity.Info" Dense="true">
                                                @L["BudgetVsActual_NoBudgetedCategories"]
                                            </MudAlert>
                                        }
                                    </MudCardContent>
                                </MudCard>
                            </td>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            @L["BudgetVsActual_SelectDateRange"]
        </MudAlert>
    }
    
    <HelpButton Title="@L["BudgetVsActual_HelpTitle"]"
                Description="@L["BudgetVsActual_HelpDescription"]"
                Features="@(new[] { 
                    L["BudgetVsActual_HelpFeature1"].Value,
                    L["BudgetVsActual_HelpFeature2"].Value,
                    L["BudgetVsActual_HelpFeature3"].Value,
                    L["BudgetVsActual_HelpFeature4"].Value,
                    L["BudgetVsActual_HelpFeature5"].Value
                })"
                HowToUse="@(new[] {
                    L["BudgetVsActual_HelpHowTo1"].Value,
                    L["BudgetVsActual_HelpHowTo2"].Value,
                    L["BudgetVsActual_HelpHowTo3"].Value,
                    L["BudgetVsActual_HelpHowTo4"].Value,
                    L["BudgetVsActual_HelpHowTo5"].Value
                })"
                Tips="@(new[] {
                    L["BudgetVsActual_HelpTip1"].Value,
                    L["BudgetVsActual_HelpTip2"].Value,
                    L["BudgetVsActual_HelpTip3"].Value,
                    L["BudgetVsActual_HelpTip4"].Value
                })" />
</MudContainer>

@code {
    private DateTime? _startDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-5);
    private DateTime? _endDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1);
    private bool _loading = true;
    private BudgetComparisonSummaryDto? _summary;
    private List<MonthlyBudgetComparisonDto> _chartData = [];
    private HashSet<MonthlyBudgetComparisonDto> _expandedMonths = [];
    private UserSettings? _userSettings;

    private List<ChartSeries> _chartSeries = [];
    private ChartOptions _chartOptions = new()
    {
        YAxisTicks = 1000,
        YAxisFormat = "C0",
        InterpolationOption = InterpolationOption.Straight
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if (_startDate == null || _endDate == null)
            return;

        _loading = true;
        StateHasChanged();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
                return;

            _summary = await BudgetComparisonService.GetBudgetComparisonSummaryAsync(
                userId, 
                _startDate.Value, 
                _endDate.Value);

            PrepareChartData();
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrepareChartData()
    {
        if (_summary == null)
            return;

        _chartData = _summary.MonthlyComparisons
            .OrderBy(m => m.Year)
            .ThenBy(m => m.Month)
            .ToList();

        _chartSeries =
        [
            new ChartSeries
            {
                Name = L["BudgetVsActual_Budgeted"].Value,
                Data = _chartData.Select(d => (double)d.TotalBudgeted).ToArray()
            },
            new ChartSeries
            {
                Name = L["BudgetVsActual_Actual"].Value,
                Data = _chartData.Select(d => (double)d.TotalActual).ToArray()
            }
        ];
    }

    private void ToggleMonthExpansion(MonthlyBudgetComparisonDto month)
    {
        if (_expandedMonths.Contains(month))
            _expandedMonths.Remove(month);
        else
            _expandedMonths.Add(month);
    }

    private Color GetPercentageColor(decimal percentage)
    {
        return percentage switch
        {
            <= 75 => Color.Success,
            <= 90 => Color.Info,
            <= 100 => Color.Warning,
            _ => Color.Error
        };
    }

    private string GetPercentageStatus(decimal percentage)
    {
        return percentage switch
        {
            <= 75 => L["BudgetVsActual_StatusOnTrack"],
            <= 90 => L["BudgetVsActual_StatusGood"],
            <= 100 => L["BudgetVsActual_StatusNearLimit"],
            _ => L["BudgetVsActual_StatusOverBudget"]
        };
    }

    private async Task ExportToCsv()
    {
        if (_summary == null)
            return;

        var csvBytes = CsvExportService.ExportBudgetComparisonToCsv(_summary);
        var fileName = $"budget_comparison_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
        var base64 = Convert.ToBase64String(csvBytes);
        
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64);
    }
}
