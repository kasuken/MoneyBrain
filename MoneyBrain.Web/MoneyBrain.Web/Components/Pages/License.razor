@page "/license"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using MoneyBrain.Web.Application.Licensing
@using MoneyBrain.Web.Domain.Enums
@using Microsoft.Extensions.Options

@attribute [Authorize]
@inject ILicenseService LicenseService
@inject IOptions<LicensingSettings> LicensingSettings
@inject IOptions<StripeSettings> StripeSettings
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>License | MoneyBrain</PageTitle>

<div class="mb-page mb-animate-in">
    <div class="mb-section-header">
        <div>
            <h1 class="mb-title">License</h1>
            <p class="mb-subtitle">Manage your MoneyBrain subscription</p>
        </div>
    </div>

    <div style="max-width: 600px;">
        @if (_loading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="mb-4" />
        }
        else if (!LicensingSettings.Value.Enabled)
        {
            <div class="mb-card">
                <MudAlert Severity="Severity.Success" Class="mb-4">
                    <MudText Typo="Typo.body1">
                        <strong>Self-Hosted Mode</strong> — Licensing is disabled. You have full access to all features.
                    </MudText>
                </MudAlert>
                <div class="d-flex align-center gap-4">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h6">Self-Hosted License</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Free forever • All features included</MudText>
                    </div>
                </div>
            </div>
        }
        else if (_licenseInfo == null)
        {
            <div class="mb-card">
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    No active license found. Subscribe to access all features.
                </MudAlert>
                
                <MudText Typo="Typo.h6" Class="mb-4">Get Started</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/pricing" FullWidth>
                    View Plans & Pricing
                </MudButton>
            </div>
        }
        else
        {
            <div class="mb-card">
                @* Status Badge *@
                <div class="d-flex justify-space-between align-center mb-4">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@GetStatusIcon()" Color="@GetStatusColor()" Size="Size.Large" />
                        <div>
                            <MudText Typo="Typo.h6">@(_licenseInfo.PlanName ?? "Subscription")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor()" Variant="Variant.Filled">
                                @GetStatusText()
                            </MudChip>
                        </div>
                    </div>
                </div>

                @* Status-specific alerts *@
                @if (_licenseInfo.Status == LicenseStatus.Trial && _licenseInfo.DaysRemaining.HasValue)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        Your trial ends in <strong>@_licenseInfo.DaysRemaining days</strong>. 
                        Upgrade now to keep your data and continue using MoneyBrain.
                    </MudAlert>
                }
                else if (_licenseInfo.Status == LicenseStatus.Expired)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">
                        Your subscription has expired. Please renew to continue using MoneyBrain.
                    </MudAlert>
                }
                else if (_licenseInfo.Status == LicenseStatus.Cancelled)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                        Your subscription has been cancelled. 
                        @if (_licenseInfo.ExpiresAt.HasValue && _licenseInfo.ExpiresAt > DateTime.UtcNow)
                        {
                            <text>You have access until @_licenseInfo.ExpiresAt.Value.ToString("MMMM d, yyyy").</text>
                        }
                    </MudAlert>
                }

                @* License Details *@
                <MudDivider Class="my-4" />
                
                <MudSimpleTable Dense Hover="false" Elevation="0" Class="mb-4">
                    <tbody>
                        <tr>
                            <td style="width: 40%;"><MudText Typo="Typo.body2" Color="Color.Secondary">Status</MudText></td>
                            <td><MudText Typo="Typo.body2">@GetStatusText()</MudText></td>
                        </tr>
                        @if (!string.IsNullOrEmpty(_licenseInfo.PlanName))
                        {
                            <tr>
                                <td><MudText Typo="Typo.body2" Color="Color.Secondary">Plan</MudText></td>
                                <td><MudText Typo="Typo.body2">@_licenseInfo.PlanName</MudText></td>
                            </tr>
                        }
                        @if (_licenseInfo.ExpiresAt.HasValue)
                        {
                            <tr>
                                <td><MudText Typo="Typo.body2" Color="Color.Secondary">@(_licenseInfo.Status == LicenseStatus.Active ? "Renews" : "Expires")</MudText></td>
                                <td><MudText Typo="Typo.body2">@_licenseInfo.ExpiresAt.Value.ToString("MMMM d, yyyy")</MudText></td>
                            </tr>
                        }
                        @if (_licenseInfo.TrialEndsAt.HasValue && _licenseInfo.IsTrialing)
                        {
                            <tr>
                                <td><MudText Typo="Typo.body2" Color="Color.Secondary">Trial Ends</MudText></td>
                                <td><MudText Typo="Typo.body2">@_licenseInfo.TrialEndsAt.Value.ToString("MMMM d, yyyy")</MudText></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                @* Action Buttons *@
                <div class="d-flex flex-column gap-2">
                    @if (_licenseInfo.IsActive && !string.IsNullOrEmpty(_licenseInfo.StripeCustomerId))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" 
                                   OnClick="ManageSubscription" Disabled="_actionLoading" FullWidth>
                            @if (_actionLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                            }
                            Manage Subscription
                        </MudButton>
                    }
                    
                    @if (!_licenseInfo.IsActive || _licenseInfo.Status == LicenseStatus.Trial || _licenseInfo.Status == LicenseStatus.Cancelled)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/pricing" FullWidth>
                            @if (_licenseInfo.Status == LicenseStatus.Trial)
                            {
                                <text>Upgrade Now</text>
                            }
                            else
                            {
                                <text>Subscribe</text>
                            }
                        </MudButton>
                    }
                </div>
            </div>
        }

        @* Help Section *@
        <div class="mb-card mt-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Need Help?</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Having trouble with your license? Contact our support team.
            </MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Email">
                Contact Support
            </MudButton>
        </div>
    </div>
</div>

@code {
    private string? _userId;
    private LicenseInfo? _licenseInfo;
    private bool _loading = true;
    private bool _actionLoading;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(_userId))
        {
            _licenseInfo = await LicenseService.GetLicenseAsync(_userId);
        }

        _loading = false;
    }

    private string GetStatusIcon() => _licenseInfo?.Status switch
    {
        LicenseStatus.Active => Icons.Material.Filled.CheckCircle,
        LicenseStatus.Trial => Icons.Material.Filled.Timer,
        LicenseStatus.Expired => Icons.Material.Filled.Error,
        LicenseStatus.Cancelled => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.Help
    };

    private Color GetStatusColor() => _licenseInfo?.Status switch
    {
        LicenseStatus.Active => Color.Success,
        LicenseStatus.Trial => Color.Info,
        LicenseStatus.Expired => Color.Error,
        LicenseStatus.Cancelled => Color.Warning,
        _ => Color.Default
    };

    private string GetStatusText() => _licenseInfo?.Status switch
    {
        LicenseStatus.Active => "Active",
        LicenseStatus.Trial => "Trial",
        LicenseStatus.Expired => "Expired",
        LicenseStatus.Cancelled => "Cancelled",
        LicenseStatus.None => "No License",
        _ => "Unknown"
    };

    private async Task ManageSubscription()
    {
        if (string.IsNullOrEmpty(_userId)) return;

        _actionLoading = true;
        StateHasChanged();

        try
        {
            var returnUrl = NavigationManager.ToAbsoluteUri("/license").AbsoluteUri;
            var portalUrl = await LicenseService.CreateCustomerPortalSessionAsync(_userId, returnUrl);

            if (!string.IsNullOrEmpty(portalUrl))
            {
                NavigationManager.NavigateTo(portalUrl, forceLoad: true);
            }
            else
            {
                Snackbar.Add("Unable to open subscription management. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _actionLoading = false;
            StateHasChanged();
        }
    }
}
