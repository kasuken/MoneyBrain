<MudPaper Class="pa-4 mb-4">
    <div class="d-flex justify-space-between align-center">
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" Height="20px" />
        <div class="d-flex gap-2 align-center">
            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="28px" Height="28px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="60px" Height="24px" />
            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="28px" Height="28px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100px" Height="24px" />
        </div>
    </div>
</MudPaper>

<MudStack Spacing="4">
    @for (var i = 0; i < 2; i++)
    {
        <MudPaper Class="pa-4">
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="160px" Height="20px" Class="mb-3" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="36px" Class="mb-2" />
            <MudStack Spacing="2">
                @for (var r = 0; r < 5; r++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="32px" />
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>
