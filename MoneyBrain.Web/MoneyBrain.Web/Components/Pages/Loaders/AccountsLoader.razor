<div class="mb-grid-stats mb-6">
    @for (var i = 0; i < 3; i++)
    {
        <div class="mb-card-stat">
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="16px" Class="mb-2" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="160px" Height="28px" />
        </div>
    }
</div>

@foreach (var section in AccountSkeletonSections)
{
    <div class="mb-section-header mt-6">
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="@section.HeaderWidth" Height="24px" />
    </div>
    <div class="mb-grid-accounts mb-4">
        @for (var i = 0; i < section.CardCount; i++)
        {
            <div class="mb-account-card">
                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" />
                <div class="flex-grow-1">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="160px" Height="16px" Class="mb-1" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="14px" />
                </div>
                <div class="text-end">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="20px" />
                </div>
                <div class="d-flex flex-column gap-1 ms-2">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="28px" Height="28px" />
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="28px" Height="28px" />
                </div>
            </div>
        }
    </div>
}

@code {
    private static readonly (string HeaderWidth, int CardCount)[] AccountSkeletonSections =
    {
        ("120px", 4),
        ("140px", 2)
    };
}
