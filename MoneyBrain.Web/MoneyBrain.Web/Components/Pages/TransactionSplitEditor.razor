@using Microsoft.AspNetCore.Components
@using MoneyBrain.Web.Application.Transactions.Splits
@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Application.Settings
@using MoneyBrain.Web.Domain.Entities
@using MudBlazor
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Resources
@inject ICategoryService CategoryService
@inject IUserSettingsService SettingsService
@inject IStringLocalizer<SharedResource> L

<MudPaper Class="pa-4" Elevation="0">
    <MudStack Spacing="3">
        <div class="d-flex justify-space-between align-center">
            <MudText Typo="Typo.h6">@L["Split_Title"]</MudText>
            <MudChip T="string" Size="Size.Small" Color="@GetBalanceColor()">
                @GetBalanceText()
            </MudChip>
        </div>

        @foreach (var split in Splits)
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudGrid>
                    <MudItem xs="12" sm="5">
                        <MudSelect T="int?" @bind-Value="split.CategoryId" Label="@L["Lbl_Category"]" Variant="Variant.Outlined" Required>
                            @foreach (var group in _categoryGroups.OrderBy(g => g.Name))
                            {
                                <MudSelectItem T="int?" Value="null" Disabled="true">
                                    <strong>@group.Name</strong>
                                </MudSelectItem>
                                @foreach (var category in group.Categories.Where(c => c.IsActive).OrderBy(c => c.Name))
                                {
                                    <MudSelectItem T="int?" Value="category.Id">&nbsp;&nbsp;&nbsp;@category.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="split.Amount" 
                                         Label="@L["Lbl_Amount"]" 
                                         Variant="Variant.Outlined"
                                         Format="N2"
                                         Step="0.01M"
                                         Required
                                         OnBlur="@(() => OnSplitChanged())" />
                    </MudItem>
                    <MudItem xs="10" sm="2">
                        <MudTextField @bind-Value="split.Memo" 
                                      Label="@L["Lbl_Memo"]" 
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="2" sm="1" Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       OnClick="@(() => RemoveSplit(split))"
                                       Disabled="@(Splits.Count <= 1)" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddSplit">
                @L["Split_AddSplit"]
            </MudButton>
            @if (!IsBalanced)
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary"
                           OnClick="AutoBalance">
                    @L["Split_AutoBalance"]
                </MudButton>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public List<TransactionSplitDto> Splits { get; set; } = [];
    [Parameter] public decimal TransactionAmount { get; set; }
    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSplitsChanged { get; set; }

    private List<CategoryGroup> _categoryGroups = [];
    private string? _errorMessage;
    private string _currencySymbol = "$";

    protected override async Task OnInitializedAsync()
    {
        // Load user settings for currency
        var settings = await SettingsService.GetSettingsAsync(UserId);
        if (settings != null)
        {
            _currencySymbol = GetCurrencySymbol(settings.CurrencyCode);
        }

        _categoryGroups = (await CategoryService.GetCategoryGroupsAsync(UserId)).ToList();
        
        // Initialize with one split if empty
        if (Splits.Count == 0 && TransactionAmount != 0)
        {
            Splits.Add(new TransactionSplitDto { Amount = TransactionAmount });
        }
    }

    private void AddSplit()
    {
        var remainingAmount = GetRemainingAmount();
        Splits.Add(new TransactionSplitDto { Amount = remainingAmount });
        _ = OnSplitChanged();
    }

    private void RemoveSplit(TransactionSplitDto split)
    {
        if (Splits.Count > 1)
        {
            Splits.Remove(split);
            _ = OnSplitChanged();
        }
    }

    private decimal GetRemainingAmount()
    {
        var total = Splits.Sum(s => s.Amount);
        return TransactionAmount - total;
    }

    private bool IsBalanced => Math.Abs(GetRemainingAmount()) < 0.01m;

    private Color GetBalanceColor()
    {
        if (IsBalanced) return Color.Success;
        return Color.Warning;
    }

    private string GetBalanceText()
    {
        var remaining = GetRemainingAmount();
        if (IsBalanced)
        {
            return L["Split_Balanced"];
        }
        return L["Split_Remaining", remaining.ToString("N2")];
    }

    private void AutoBalance()
    {
        if (Splits.Count == 0) return;

        var remaining = GetRemainingAmount();
        if (Math.Abs(remaining) < 0.01m) return;

        // Add remaining amount to the first split
        Splits[0].Amount += remaining;
        _ = OnSplitChanged();
    }

    private async Task OnSplitChanged()
    {
        await OnSplitsChanged.InvokeAsync();
    }

    private string GetCurrencySymbol(string currencyCode)
    {
        var currencies = SettingsService.GetAvailableCurrencies();
        return currencies.FirstOrDefault(c => c.Code == currencyCode)?.Symbol ?? "$";
    }
}
