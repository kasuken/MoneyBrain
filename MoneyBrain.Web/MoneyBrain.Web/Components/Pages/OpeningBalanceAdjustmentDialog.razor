@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <MudAlert Severity="Severity.Info" Dense="true">
                    @L["OpenBalAdjDlg_Description"]
                </MudAlert>

                <MudTextField @bind-Value="Account.Name"
                              Label="@L["Col_Account"]"
                              ReadOnly="true"
                              Variant="Variant.Filled" />

                <MudNumericField @bind-Value="Account.OpeningBalance"
                                 Label="@L["OpenBalAdjDlg_CurrentBalance"]"
                                 ReadOnly="true"
                                 Variant="Variant.Filled"
                                 Format="C2" />

                <MudNumericField @bind-Value="_newBalance"
                                 Label="@L["OpenBalAdjDlg_NewBalance"]"
                                 Required="true"
                                 RequiredError="@L["OpenBalAdjDlg_BalanceRequired"]"
                                 Variant="Variant.Outlined"
                                 Format="C2" />

                <MudTextField Value="@_adjustmentAmount.ToString("C2")"
                              Label="@L["OpenBalAdjDlg_AdjustmentAmount"]"
                              ReadOnly="true"
                              Variant="Variant.Filled"
                              HelperText="@_adjustmentHelperText"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@(_adjustmentAmount >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)"
                              AdornmentColor="@(_adjustmentAmount >= 0 ? Color.Success : Color.Error)" />

                <MudTextField @bind-Value="_reason"
                              Label="@L["OpenBalAdjDlg_Reason"]"
                              Lines="3"
                              Variant="Variant.Outlined"
                              HelperText="@L["OpenBalAdjDlg_ReasonHelper"]" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Submit" 
                   Disabled="@(!_isValid || _isSaving)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">@L["Msg_Saving"]</MudText>
            }
            else
            {
                <MudText>@L["OpenBalAdjDlg_SaveButton"]</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Account Account { get; set; } = default!;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSaving;
    private decimal _newBalance;
    private string? _reason;

    private decimal _adjustmentAmount => _newBalance - Account.OpeningBalance;
    private string _adjustmentHelperText => _adjustmentAmount switch
    {
        > 0 => string.Format(L["OpenBalAdjDlg_IncreaseOf"], _adjustmentAmount.ToString("C2")),
        < 0 => string.Format(L["OpenBalAdjDlg_DecreaseOf"], Math.Abs(_adjustmentAmount).ToString("C2")),
        _ => L["OpenBalAdjDlg_NoChange"]
    };

    protected override void OnInitialized()
    {
        _newBalance = Account.OpeningBalance;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        if (!_isValid) return;

        _isSaving = true;
        try
        {
            await AccountService.AdjustOpeningBalanceAsync(
                Account.Id,
                _newBalance,
                _reason,
                UserId);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["OpenBalAdjDlg_SaveError"], ex.Message), Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
