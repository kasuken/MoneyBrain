@page "/mobile/transactions"
@layout MobileLayout
@using Microsoft.AspNetCore.Components.Authorization
@using MoneyBrain.Web.Application.Transactions
@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using MoneyBrain.Web.Components.Pages
@using MudBlazor
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Resources
@inject ITransactionService TransactionService
@inject IAccountService AccountService
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4" Style="padding-bottom: 80px !important;">
            <!-- Header -->
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h5" Style="font-weight: 600;">@L["Mobile_Transactions"]</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.FilterList" 
                               Color="Color.Default" 
                               Size="Size.Medium"
                               OnClick="@(() => _showFilters = !_showFilters)" />
            </MudStack>

            <!-- Filter Section (Collapsible) -->
            @if (_showFilters)
            {
                <MudCard Class="mb-4">
                    <MudCardContent>
                        <MudSelect T="int?" @bind-Value="_selectedAccountId" Label="@L["Lbl_Account"]" Clearable="true" FullWidth="true">
                            @foreach (var account in _accounts)
                            {
                                <MudSelectItem T="int?" Value="@((int?)account.Id)">@account.Name</MudSelectItem>
                            }
                        </MudSelect>
                        
                        <MudButton OnClick="ApplyFilters" 
                                   Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   FullWidth="true"
                                   Class="mt-3">
                            @L["Btn_ApplyFilters"]
                        </MudButton>
                    </MudCardContent>
                </MudCard>
            }

            <!-- Transaction List -->
            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_transactions.Count == 0)
            {
                <MudPaper Class="pa-8" Style="text-align: center;">
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Color="Color.Default" />
                    <MudText Typo="Typo.body1" Class="mt-2">@L["Trans_NoTransactionsFound"]</MudText>
                </MudPaper>
            }
            else
            {
                <MudStack Spacing="2">
                    @foreach (var transaction in _transactions)
                    {
                        <MudCard @onclick="@(() => EditTransaction(transaction))" 
                                 Style="cursor: pointer; min-height: 72px;"
                                 Class="transaction-card">
                            <MudCardContent Class="pa-3">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudStack Spacing="1" Style="flex: 1;">
                                        <MudText Typo="Typo.body1" Style="font-weight: 500;">
                                            @(transaction.Payee?.Name ?? L["Trans_NoPayee"])
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Default">
                                            @transaction.Date.ToString("MMM dd, yyyy")
                                            @if (!string.IsNullOrEmpty(transaction.Category?.Name))
                                            {
                                                <span> • @transaction.Category.Name</span>
                                            }
                                        </MudText>
                                    </MudStack>
                                    <MudStack Spacing="1" AlignItems="AlignItems.End">
                                        <MudText Typo="Typo.body1" 
                                                 Style="@($"font-weight: 600; color: {(transaction.Amount >= 0 ? "#10B981" : "#EF4444")}")">
                                            @transaction.Amount.ToString("C2")
                                        </MudText>
                                        @if (transaction.IsCleared)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" 
                                                     Size="Size.Small" 
                                                     Color="Color.Success" />
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    }
                </MudStack>
            }

            <!-- Floating Action Button (FAB) -->
            <MudFab Color="Color.Primary" 
                    StartIcon="@Icons.Material.Filled.Add" 
                    Style="position: fixed; bottom: 88px; right: 16px; z-index: 1000;"
                    Size="Size.Large"
                    OnClick="CreateTransaction" />
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="pa-4">
            <MudPaper Class="pa-8" Style="text-align: center;">
                <MudText Typo="Typo.h6">@L["Mobile_PleaseSignInTransactions"]</MudText>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<Transaction> _transactions = new();
    private List<Account> _accounts = new();
    private bool _isLoading = true;
    private bool _showFilters = false;
    private int? _selectedAccountId;
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            
            if (!string.IsNullOrEmpty(_userId))
            {
                await LoadDataAsync();
            }
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _accounts = (await AccountService.GetUserAccountsAsync(_userId!)).ToList();
            
            if (_selectedAccountId.HasValue)
            {
                _transactions = await TransactionService.GetAccountTransactionsAsync(
                    _selectedAccountId.Value, 
                    _userId!, 
                    DateTime.Now.AddMonths(-3), 
                    DateTime.Now);
            }
            else
            {
                _transactions = await TransactionService.GetUserTransactionsAsync(
                    _userId!, 
                    DateTime.Now.AddMonths(-3), 
                    DateTime.Now);
            }

            // Sort by date descending
            _transactions = _transactions.OrderByDescending(t => t.Date).ToList();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        _showFilters = false;
        await LoadDataAsync();
    }

    private async Task CreateTransaction()
    {
        var parameters = new DialogParameters<TransactionDialog>
        {
            { x => x.UserId, _userId },
            { x => x.IsNew, true },
            { x => x.FullScreen, true }
        };

        var options = new DialogOptions 
        { 
            FullScreen = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<TransactionDialog>(L["Trans_NewTransaction"], parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task EditTransaction(Transaction transaction)
    {
        var parameters = new DialogParameters<TransactionDialog>
        {
            { x => x.UserId, _userId },
            { x => x.Transaction, transaction },
            { x => x.IsNew, false },
            { x => x.FullScreen, true }
        };

        var options = new DialogOptions 
        { 
            FullScreen = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<TransactionDialog>(L["Trans_EditTransaction"], parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadDataAsync();
        }
    }
}

<style>
    .transaction-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .transaction-card:active {
        transform: scale(0.98);
    }

    /* Ensure touch targets meet minimum 44px requirement */
    .transaction-card {
        min-height: 72px;
    }
</style>
