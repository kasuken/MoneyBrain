@page "/balance-history"
@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Resources
@attribute [Authorize]
@inject IAccountService AccountService
@inject IStringLocalizer<SharedResource> L
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@L["BalHist_PageTitle"] - MoneyBrain</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <MudText Typo="Typo.h4" GutterBottom="true">@L["BalHist_Title"]</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        @L["BalHist_Subtitle"]
    </MudText>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudGrid>
            <!-- Account Selector -->
            <MudItem xs="12">
                <MudPaper Class="pa-4 mb-4">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSelect T="Account" 
                                       @bind-Value="_selectedAccount" 
                                       Label="@L["Lbl_SelectAccount"]" 
                                       Variant="Variant.Outlined"
                                       AnchorOrigin="Origin.BottomCenter"
                                       ToStringFunc="@(a => a?.Name ?? string.Empty)">
                                @foreach (var account in _accounts)
                                {
                                    <MudSelectItem Value="@account">
                                        @account.Name (@account.Type - @account.SubType)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="_startDate" 
                                          Label="@L["Lbl_StartDate"]" 
                                          Variant="Variant.Outlined"
                                          Clearable="true" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="_endDate" 
                                          Label="@L["Lbl_EndDate"]" 
                                          Variant="Variant.Outlined"
                                          Clearable="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Primary" 
                                          OnClick="LoadBalanceHistory"
                                          Disabled="@(_selectedAccount == null)">
                                    @L["BalHist_LoadHistory"]
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" 
                                          Color="Color.Secondary" 
                                          OnClick="CreateManualSnapshot"
                                          Disabled="@(_selectedAccount == null)">
                                    @L["BalHist_CreateSnapshot"]
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            @if (_selectedAccount != null && _snapshots.Any())
            {
                <!-- Chart Visualization -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-4">@L["BalHist_BalanceTrend"]</MudText>
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                            @L["BalHist_ChartComingSoon"]
                        </MudAlert>
                    </MudPaper>
                </MudItem>

                <!-- Data Table -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-4">@L["BalHist_SnapshotHistory"] (@_snapshots.Count)</MudText>
                        <MudTable Items="@_snapshots" 
                                  Dense="true" 
                                  Hover="true" 
                                  Breakpoint="Breakpoint.Sm"
                                  Loading="@_isLoadingSnapshots">
                            <HeaderContent>
                                <MudTh>@L["Col_Date"]</MudTh>
                                <MudTh>@L["Col_Balance"]</MudTh>
                                <MudTh>@L["BalHist_Change"]</MudTh>
                                <MudTh>@L["Col_Type"]</MudTh>
                                <MudTh>@L["Lbl_Notes"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["Col_Date"]">
                                    @context.SnapshotDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                </MudTd>
                                <MudTd DataLabel="@L["Col_Balance"]">
                                    <MudText Color="@(context.Balance >= 0 ? Color.Success : Color.Error)">
                                        @context.Balance.ToString("C2")
                                    </MudText>
                                </MudTd>
                                <MudTd DataLabel="@L["BalHist_Change"]">
                                    @{
                                        var change = GetBalanceChange(context);
                                        if (change.HasValue)
                                        {
                                            <MudChip T="string" 
                                                    Size="Size.Small" 
                                                    Color="@(change.Value >= 0 ? Color.Success : Color.Error)">
                                                @(change.Value >= 0 ? "+" : "")@change.Value.ToString("C2")
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                        }
                                    }
                                </MudTd>
                                <MudTd DataLabel="@L["Col_Type"]">
                                    <MudChip T="string" 
                                            Size="Size.Small" 
                                            Color="@GetTypeColor(context.Type)">
                                        @context.Type
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="@L["Lbl_Notes"]">
                                    @(context.Notes ?? "-")
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            }
            else if (_selectedAccount != null && !_snapshots.Any())
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info">
                        @L["BalHist_NoSnapshots"]
                    </MudAlert>
                </MudItem>
            }
        </MudGrid>
    }
    
    <HelpButton Title="@L["BalHist_HelpTitle"]"
                Description="@L["BalHist_HelpDescription"]"
                Features="@(new[] { 
                    L["BalHist_HelpFeature1"].Value,
                    L["BalHist_HelpFeature2"].Value,
                    L["BalHist_HelpFeature3"].Value,
                    L["BalHist_HelpFeature4"].Value,
                    L["BalHist_HelpFeature5"].Value
                })"
                HowToUse="@(new[] {
                    L["BalHist_HelpHowTo1"].Value,
                    L["BalHist_HelpHowTo2"].Value,
                    L["BalHist_HelpHowTo3"].Value,
                    L["BalHist_HelpHowTo4"].Value,
                    L["BalHist_HelpHowTo5"].Value
                })"
                Tips="@(new[] {
                    L["BalHist_HelpTip1"].Value,
                    L["BalHist_HelpTip2"].Value,
                    L["BalHist_HelpTip3"].Value
                })" />
</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private List<Account> _accounts = new();
    private List<AccountBalanceSnapshot> _snapshots = new();
    private Account? _selectedAccount;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private bool _isLoading = true;
    private bool _isLoadingSnapshots = false;
    private string _userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState == null) return;

        var authState = await AuthenticationState;
        _userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        _isLoading = true;
        try
        {
            var allAccounts = await AccountService.GetUserAccountsAsync(_userId, includeInactive: false);
            _accounts = allAccounts.OrderBy(a => a.Name).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Msg_ErrorLoadingAccounts", ex.Message], Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadBalanceHistory()
    {
        if (_selectedAccount == null) return;

        _isLoadingSnapshots = true;
        try
        {
            _snapshots = (await AccountService.GetBalanceHistoryAsync(
                _selectedAccount.Id,
                _userId,
                _startDate,
                _endDate)).ToList();

            if (!_snapshots.Any())
            {
                Snackbar.Add(L["BalHist_NoSnapshotsFound"], Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Msg_ErrorLoadingBalanceHistory", ex.Message], Severity.Error);
        }
        finally
        {
            _isLoadingSnapshots = false;
        }
    }

    private async Task CreateManualSnapshot()
    {
        if (_selectedAccount == null) return;

        var parameters = new DialogParameters<ManualSnapshotDialog>
        {
            { x => x.Account, _selectedAccount },
            { x => x.UserId, _userId }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ManualSnapshotDialog>(L["BalHist_CreateSnapshotDialogTitle"], parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadBalanceHistory();
            Snackbar.Add(L["BalHist_SnapshotCreated", _selectedAccount?.Name ?? string.Empty], Severity.Success);
        }
    }

    private decimal? GetBalanceChange(AccountBalanceSnapshot snapshot)
    {
        var index = _snapshots.IndexOf(snapshot);
        if (index > 0)
        {
            var previous = _snapshots[index - 1];
            return snapshot.Balance - previous.Balance;
        }
        return null;
    }

    private MudBlazor.Color GetTypeColor(SnapshotType type) => type switch
    {
        SnapshotType.Manual => MudBlazor.Color.Primary,
        SnapshotType.Automatic => MudBlazor.Color.Info,
        SnapshotType.Reconciliation => MudBlazor.Color.Success,
        SnapshotType.OpeningBalanceAdjustment => MudBlazor.Color.Warning,
        _ => MudBlazor.Color.Default
    };
}
