@page "/payees"
@using Microsoft.AspNetCore.Authorization
@using MoneyBrain.Web.Application.Transactions
@using MoneyBrain.Web.Application.Transactions.PayeeNormalization
@using MoneyBrain.Web.Domain.Entities
@using System.Security.Claims
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization

@attribute [Authorize]

@inject IStringLocalizer<SharedResource> L
@inject ITransactionService TransactionService
@inject IDialogService DialogService
@inject ISnackbar SnackbarService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@L["Payee_PageTitle"] | MoneyBrain</PageTitle>

<div class="mb-page mb-animate-in">
    <!-- Header -->
    <div class="mb-section-header">
        <div>
            <h1 class="mb-title">@L["Payee_Title"]</h1>
            <p class="mb-subtitle">@L["Payee_Subtitle"]</p>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.FindReplace"
                       OnClick="@FindDuplicates">
                @L["Payee_FindDuplicates"]
            </MudButton>
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.DeleteSweep"
                       OnClick="@DeleteUnusedPayees">
                @L["Payee_CleanUpUnused"]
            </MudButton>
        </div>
    </div>

    @if (_isLoading)
    {
        <PayeeManagementLoader />
    }
    else
    {
        @if (_duplicateGroups.Count > 0)
        {
            <MudPaper Class="mb-4 pa-4">
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    @string.Format(L["Payee_DuplicatesFound"].Value, _duplicateGroups.Count, _duplicateGroups.Sum(g => g.Payees.Count))
                </MudAlert>

                <MudText Typo="Typo.h6" Class="mb-3">@L["Payee_PotentialDuplicates"]</MudText>

                @foreach (var group in _duplicateGroups)
                {
                    <MudCard Class="mb-3">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2" Class="mb-2">
                                @string.Format(L["Payee_SuggestedMerge"].Value, group.SuggestedPrimary?.Payee.Name)
                            </MudText>
                            <MudList T="string" Dense>
                                @foreach (var payeeUsage in group.Payees)
                                {
                                    <MudListItem T="string">
                                        <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                            <div>
                                                <MudText>
                                                    <strong>@payeeUsage.Payee.Name</strong>
                                                    @if (payeeUsage.Payee.Id == group.SuggestedPrimary?.Payee.Id)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["Payee_Primary"]</MudChip>
                                                    }
                                                </MudText>
                                                <MudText Typo="Typo.caption">
                                                    @string.Format(L["Payee_TransactionCount"].Value, payeeUsage.TransactionCount) • @L["Payee_LastUsed"]: @(payeeUsage.LastUsedDate?.ToString("MM/dd/yyyy") ?? L["Common_Never"].Value)
                                                </MudText>
                                            </div>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Color="Color.Primary" OnClick="@(() => MergeGroup(group))">
                                @string.Format(L["Payee_MergeAll"].Value, group.SuggestedPrimary?.Payee.Name)
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                }
            </MudPaper>
        }

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">@string.Format(L["Payee_AllPayees"].Value, _payees.Count)</MudText>
            
            <MudTable Items="_payees" Dense Hover FixedHeader Height="600px">
                <HeaderContent>
                    <MudTh>@L["Payee_Col_PayeeName"]</MudTh>
                    <MudTh>@L["Payee_Col_Transactions"]</MudTh>
                    <MudTh>@L["Payee_Col_LastUsed"]</MudTh>
                    <MudTh>@L["Common_Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Payee_Col_PayeeName"].Value">@context.Payee.Name</MudTd>
                    <MudTd DataLabel="@L["Payee_Col_Transactions"].Value">@context.TransactionCount</MudTd>
                    <MudTd DataLabel="@L["Payee_Col_LastUsed"].Value">@(context.LastUsedDate?.ToString("MM/dd/yyyy") ?? L["Common_Never"].Value)</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Size="Size.Small" 
                                       Color="Color.Primary" 
                                       OnClick="@(() => RenamePayee(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-8 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" Class="mb-4" Style="opacity: 0.3;" />
                        <MudText Typo="Typo.h6">@L["Payee_NoPayees"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Payee_NoPayeesHint"]</MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
</div>

@code {
    private string _userId = string.Empty;
    private bool _isLoading = true;
    private List<PayeeWithUsage> _payees = new();
    private List<PayeeDuplicateGroup> _duplicateGroups = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        }

        await LoadPayees();
    }

    private async Task LoadPayees()
    {
        _isLoading = true;

        if (!string.IsNullOrWhiteSpace(_userId))
        {
            _payees = await TransactionService.GetPayeesWithUsageAsync(_userId);
        }

        _isLoading = false;
    }

    private async Task FindDuplicates()
    {
        _isLoading = true;

        if (!string.IsNullOrWhiteSpace(_userId))
        {
            _duplicateGroups = await TransactionService.FindDuplicatePayeesAsync(_userId);
            
            if (_duplicateGroups.Count == 0)
            {
                SnackbarService.Add(L["Payee_Msg_NoDuplicates"].Value, Severity.Success);
            }
            else
            {
                SnackbarService.Add(string.Format(L["Payee_Msg_FoundDuplicates"].Value, _duplicateGroups.Count), Severity.Warning);
            }
        }

        _isLoading = false;
    }

    private async Task MergeGroup(PayeeDuplicateGroup group)
    {
        if (group.SuggestedPrimary == null)
            return;

        var parameters = new DialogParameters<PayeeMergeDialog>
        {
            { x => x.TargetPayee, group.SuggestedPrimary },
            { x => x.SourcePayees, group.Payees.Where(p => p.Payee.Id != group.SuggestedPrimary.Payee.Id).ToList() }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PayeeMergeDialog>(L["Payee_Dlg_MergePayees"].Value, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            var sourceIds = group.Payees
                .Where(p => p.Payee.Id != group.SuggestedPrimary.Payee.Id)
                .Select(p => p.Payee.Id)
                .ToList();

            var success = await TransactionService.MergePayeesAsync(_userId, group.SuggestedPrimary.Payee.Id, sourceIds);

            if (success)
            {
                SnackbarService.Add(L["Payee_Msg_MergeSuccess"].Value, Severity.Success);
                await LoadPayees();
                _duplicateGroups.Remove(group);
            }
            else
            {
                SnackbarService.Add(L["Payee_Msg_MergeFailed"].Value, Severity.Error);
            }
        }
    }

    private async Task RenamePayee(PayeeWithUsage payeeUsage)
    {
        var parameters = new DialogParameters<PayeeRenameDialog>
        {
            { x => x.PayeeId, payeeUsage.Payee.Id },
            { x => x.CurrentName, payeeUsage.Payee.Name }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PayeeRenameDialog>(L["Payee_Dlg_RenamePayee"].Value, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string newName })
        {
            var success = await TransactionService.RenamePayeeAsync(payeeUsage.Payee.Id, _userId, newName);

            if (success)
            {
                SnackbarService.Add(L["Payee_Msg_RenameSuccess"].Value, Severity.Success);
                await LoadPayees();
            }
            else
            {
                SnackbarService.Add(L["Payee_Msg_RenameFailed"].Value, Severity.Error);
            }
        }
    }

    private async Task DeleteUnusedPayees()
    {
        bool? confirm = await DialogService.ShowMessageBox(
            L["Payee_Dlg_DeleteUnused"].Value,
            L["Payee_Dlg_DeleteUnusedConfirm"].Value,
            yesText: L["Common_Delete"].Value, cancelText: L["Common_Cancel"].Value);

        if (confirm == true)
        {
            var count = await TransactionService.DeleteUnusedPayeesAsync(_userId);
            SnackbarService.Add(string.Format(L["Payee_Msg_DeletedCount"].Value, count), Severity.Success);
            await LoadPayees();
        }
    }
}
