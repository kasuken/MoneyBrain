@page "/manual-adjustments"
@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Resources
@attribute [Authorize]
@inject IAccountService AccountService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ManAdj_PageTitle"] - MoneyBrain</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <MudText Typo="Typo.h4" GutterBottom="true">@L["ManAdj_Title"]</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        @L["ManAdj_Subtitle"]
    </MudText>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudGrid>
            <!-- Account Selector -->
            <MudItem xs="12">
                <MudPaper Class="pa-4 mb-4">
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudSelect T="Account" 
                                       @bind-Value="_selectedAccount" 
                                       Label="@L["Lbl_SelectAccount"]" 
                                       Variant="Variant.Outlined"
                                       AnchorOrigin="Origin.BottomCenter"
                                       ToStringFunc="@(a => a?.Name ?? string.Empty)">
                                @foreach (var account in _accounts)
                                {
                                    <MudSelectItem Value="@account">
                                        @account.Name (@account.Type - @account.SubType)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="_startDate" 
                                          Label="@L["Lbl_StartDate"]" 
                                          Variant="Variant.Outlined"
                                          Clearable="true" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="_endDate" 
                                          Label="@L["Lbl_EndDate"]" 
                                          Variant="Variant.Outlined"
                                          Clearable="true" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Primary" 
                                          OnClick="LoadAdjustments"
                                          Disabled="@(_selectedAccount == null)"
                                          FullWidth="true">
                                    @L["Btn_Load"]
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            @if (_selectedAccount != null)
            {
                <!-- Current Balance Summary -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4 mb-4">
                        <MudGrid>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ManAdj_OpeningBalance"]</MudText>
                                <MudText Typo="Typo.h6">@_selectedAccount.OpeningBalance.ToString("C2")</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ManAdj_TotalAdjustments"]</MudText>
                                <MudText Typo="Typo.h6" Color="@(_totalAdjustments >= 0 ? Color.Success : Color.Error)">
                                    @_totalAdjustments.ToString("C2")
                                </MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ManAdj_CurrentBalance"]</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Primary">@_currentBalance.ToString("C2")</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3" Class="d-flex align-end justify-end">
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Primary" 
                                          StartIcon="@Icons.Material.Filled.Add"
                                          OnClick="CreateAdjustment">
                                    @L["ManAdj_NewAdjustment"]
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>

                <!-- Adjustments Table -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-4">@L["ManAdj_AdjustmentHistory"] (@_adjustments.Count)</MudText>
                        
                        @if (_isLoadingAdjustments)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                        }
                        else if (!_adjustments.Any())
                        {
                            <MudAlert Severity="Severity.Info">
                                @L["ManAdj_NoAdjustments"]
                            </MudAlert>
                        }
                        else
                        {
                            <MudTable Items="@_adjustments" 
                                      Dense="true" 
                                      Hover="true" 
                                      Breakpoint="Breakpoint.Sm">
                                <HeaderContent>
                                    <MudTh>@L["Col_Date"]</MudTh>
                                    <MudTh>@L["Col_Amount"]</MudTh>
                                    <MudTh>@L["Col_Category"]</MudTh>
                                    <MudTh>@L["Lbl_Description"]</MudTh>
                                    <MudTh>@L["Col_Status"]</MudTh>
                                    <MudTh>@L["Col_Actions"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="@L["Col_Date"]">
                                        @context.AdjustmentDate.ToLocalTime().ToString("MMM dd, yyyy")
                                    </MudTd>
                                    <MudTd DataLabel="@L["Col_Amount"]">
                                        <MudChip T="string" 
                                                Size="Size.Small" 
                                                Color="@(context.Amount >= 0 ? Color.Success : Color.Error)">
                                            @(context.Amount >= 0 ? "+" : "")@context.Amount.ToString("C2")
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="@L["Col_Category"]">
                                        @(context.Category ?? "-")
                                    </MudTd>
                                    <MudTd DataLabel="@L["Lbl_Description"]">
                                        <MudText Typo="Typo.body2">@context.Description</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="@L["Col_Status"]">
                                        @if (context.IsReconciled)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Lock">
                                                @L["Status_Reconciled"]
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                                @L["Status_Unreconciled"]
                                            </MudChip>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="@L["Col_Actions"]">
                                        @if (!context.IsReconciled)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                          Size="Size.Small"
                                                          Color="Color.Error"
                                                          OnClick="@(() => DeleteAdjustment(context))" />
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private List<Account> _accounts = new();
    private List<ManualBalanceAdjustment> _adjustments = new();
    private Account? _selectedAccount;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private decimal _currentBalance;
    private decimal _totalAdjustments;
    private bool _isLoading = true;
    private bool _isLoadingAdjustments = false;
    private string _userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState == null) return;

        var authState = await AuthenticationState;
        _userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        _isLoading = true;
        try
        {
            var allAccounts = await AccountService.GetUserAccountsAsync(_userId, includeInactive: false);
            _accounts = allAccounts.OrderBy(a => a.Name).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Msg_ErrorLoadingAccounts", ex.Message], Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAdjustments()
    {
        if (_selectedAccount == null) return;

        _isLoadingAdjustments = true;
        try
        {
            _adjustments = (await AccountService.GetManualAdjustmentsAsync(
                _selectedAccount.Id,
                _userId,
                _startDate,
                _endDate)).ToList();

            _totalAdjustments = _adjustments.Sum(a => a.Amount);
            _currentBalance = await AccountService.CalculateCurrentBalanceAsync(_selectedAccount.Id, _userId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Msg_ErrorLoadingAdjustments", ex.Message], Severity.Error);
        }
        finally
        {
            _isLoadingAdjustments = false;
        }
    }

    private async Task CreateAdjustment()
    {
        if (_selectedAccount == null) return;

        var parameters = new DialogParameters<ManualAdjustmentDialog>
        {
            { x => x.Account, _selectedAccount },
            { x => x.UserId, _userId }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ManualAdjustmentDialog>(L["ManAdj_CreateDialogTitle"], parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadAdjustments();
            Snackbar.Add(L["ManAdj_AdjustmentCreated", _selectedAccount?.Name ?? string.Empty], Severity.Success);
        }
    }

    private async Task DeleteAdjustment(ManualBalanceAdjustment adjustment)
    {
        var result = await DialogService.ShowMessageBox(
            L["ManAdj_DeleteDialogTitle"],
            L["ManAdj_DeleteDialogMessage", adjustment.Amount.ToString("C2")],
            yesText: L["Btn_Delete"],
            cancelText: L["Btn_Cancel"]);

        if (result == true)
        {
            try
            {
                var deleted = await AccountService.DeleteManualAdjustmentAsync(adjustment.Id, _userId);
                if (deleted)
                {
                    await LoadAdjustments();
                    Snackbar.Add(L["ManAdj_DeletedSuccess"], Severity.Success);
                }
                else
                {
                    Snackbar.Add(L["ManAdj_DeleteFailed"], Severity.Error);
                }
            }
            catch (InvalidOperationException ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
            catch (Exception ex)
            {
                Snackbar.Add(L["Msg_ErrorDeletingAdjustment", ex.Message], Severity.Error);
            }
        }
    }
}
