@using Microsoft.AspNetCore.Components
@using MoneyBrain.Web.Application.Transactions
@using MoneyBrain.Web.Application.Transactions.BulkEdit
@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Domain.Entities
@using MudBlazor
@inject ITransactionService TransactionService
@inject ICategoryService CategoryService
@inject ISnackbar SnackbarService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">
            Update <strong>@SelectedTransactionIds.Count</strong> transaction@(SelectedTransactionIds.Count != 1 ? "s" : "")
            @if (_reconciledCount > 0)
            {
                <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Warning" Class="ms-2">
                    @_reconciledCount reconciled (will be skipped)
                </MudChip>
            }
        </MudText>

        <MudStack Spacing="4">
            <!-- Category -->
            <MudStack Spacing="2">
                <MudCheckBox @bind-Value="_updateCategory" Label="Update Category" Color="MudBlazor.Color.Primary" />
                @if (_updateCategory)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudSelect T="int?" @bind-Value="_categoryId" Label="Category" Variant="Variant.Outlined" 
                                   Disabled="!_updateCategory || _clearCategory" FullWidth="true">
                            <MudSelectItem T="int?" Value="null">-- Select Category --</MudSelectItem>
                            @foreach (var group in _categoryGroups.OrderBy(g => g.Name))
                            {
                                <MudSelectItem T="int?" Value="null" Disabled="true">
                                    <strong>@group.Name</strong>
                                </MudSelectItem>
                                @foreach (var category in group.Categories.Where(c => c.IsActive).OrderBy(c => c.Name))
                                {
                                    <MudSelectItem T="int?" Value="category.Id">&nbsp;&nbsp;&nbsp;@category.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                        <MudCheckBox @bind-Value="_clearCategory" Label="Clear" Color="MudBlazor.Color.Secondary" 
                                     Disabled="!_updateCategory" Dense="true" />
                    </MudStack>
                }
            </MudStack>

            <!-- Payee -->
            <MudStack Spacing="2">
                <MudCheckBox @bind-Value="_updatePayee" Label="Update Payee" Color="MudBlazor.Color.Primary" />
                @if (_updatePayee)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudSelect T="int?" @bind-Value="_payeeId" Label="Payee" Variant="Variant.Outlined" 
                                   Disabled="!_updatePayee || _clearPayee" FullWidth="true">
                            <MudSelectItem T="int?" Value="null">-- Select Payee --</MudSelectItem>
                            @foreach (var payee in _payees.OrderBy(p => p.Name))
                            {
                                <MudSelectItem T="int?" Value="payee.Id">@payee.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudCheckBox @bind-Value="_clearPayee" Label="Clear" Color="MudBlazor.Color.Secondary" 
                                     Disabled="!_updatePayee" Dense="true" />
                    </MudStack>
                }
            </MudStack>

            <!-- Tags -->
            <MudStack Spacing="2">
                <MudCheckBox @bind-Value="_updateTags" Label="Update Tags" Color="MudBlazor.Color.Primary" />
                @if (_updateTags)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_tagsInput" Label="Tags (comma-separated)" Variant="Variant.Outlined"
                                      Disabled="!_updateTags || _clearTags" FullWidth="true"
                                      HelperText="e.g., business, tax-deductible" />
                        <MudCheckBox @bind-Value="_clearTags" Label="Clear" Color="MudBlazor.Color.Secondary" 
                                     Disabled="!_updateTags" Dense="true" />
                    </MudStack>
                }
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="me-2" />
            }
            Update @SelectedTransactionIds.Count Transaction@(SelectedTransactionIds.Count != 1 ? "s" : "")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public List<int> SelectedTransactionIds { get; set; } = [];
    [Parameter] public int ReconciledCount { get; set; }

    private List<CategoryGroup> _categoryGroups = [];
    private List<Payee> _payees = [];
    private bool _isSubmitting;
    private string? _errorMessage;
    private int _reconciledCount;

    // Update flags
    private bool _updateCategory;
    private bool _updatePayee;
    private bool _updateTags;

    // Values
    private int? _categoryId;
    private int? _payeeId;
    private string _tagsInput = string.Empty;

    // Clear flags
    private bool _clearCategory;
    private bool _clearPayee;
    private bool _clearTags;

    protected override async Task OnInitializedAsync()
    {
        _reconciledCount = ReconciledCount;
        
        // Load categories
        _categoryGroups = (await CategoryService.GetCategoryGroupsAsync(UserId)).ToList();
        
        // Load payees
        _payees = await TransactionService.GetPayeesAsync(UserId);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        _errorMessage = null;

        // Validate at least one update is selected
        if (!_updateCategory && !_updatePayee && !_updateTags)
        {
            _errorMessage = "Please select at least one field to update";
            return;
        }

        // Build request
        var request = new BulkEditTransactionRequest
        {
            TransactionIds = SelectedTransactionIds
        };

        if (_updateCategory)
        {
            request.ClearCategory = _clearCategory;
            if (!_clearCategory)
            {
                request.CategoryId = _categoryId;
            }
        }

        if (_updatePayee)
        {
            request.ClearPayee = _clearPayee;
            if (!_clearPayee)
            {
                request.PayeeId = _payeeId;
            }
        }

        if (_updateTags)
        {
            request.ClearTags = _clearTags;
            if (!_clearTags && !string.IsNullOrWhiteSpace(_tagsInput))
            {
                request.Tags = _tagsInput.Split(',')
                    .Select(t => t.Trim())
                    .Where(t => !string.IsNullOrWhiteSpace(t))
                    .ToList();
            }
            else if (!_clearTags)
            {
                request.Tags = [];
            }
        }

        _isSubmitting = true;

        try
        {
            var result = await TransactionService.BulkUpdateTransactionsAsync(UserId, request);
            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to update transactions: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
