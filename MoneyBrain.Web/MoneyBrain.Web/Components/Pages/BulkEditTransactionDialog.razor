@using Microsoft.AspNetCore.Components
@using MoneyBrain.Web.Application.Transactions
@using MoneyBrain.Web.Application.Transactions.BulkEdit
@using MoneyBrain.Web.Application.Transactions.PayeeNormalization
@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@using MudBlazor
@inject ITransactionService TransactionService
@inject IPayeeService PayeeService
@inject ICategoryService CategoryService
@inject ISnackbar SnackbarService
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">
            @((MarkupString)string.Format(L["BulkEditDlg_UpdateCount"], $"<strong>{SelectedTransactionIds.Count}</strong>"))
            @if (_reconciledCount > 0)
            {
                <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Warning" Class="ms-2">
                    @string.Format(L["BulkEditDlg_ReconciledSkipped"], _reconciledCount)
                </MudChip>
            }
        </MudText>

        <MudStack Spacing="4">
            <!-- Category -->
            <MudStack Spacing="2">
                <MudCheckBox @bind-Value="_updateCategory" Label="@L["BulkEditDlg_UpdateCategory"]" Color="MudBlazor.Color.Primary" />
                @if (_updateCategory)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudSelect T="int?" @bind-Value="_categoryId" Label="@L["Col_Category"]" Variant="Variant.Outlined" 
                                   Disabled="!_updateCategory || _clearCategory" FullWidth="true">
                            <MudSelectItem T="int?" Value="null">@L["BulkEditDlg_SelectCategory"]</MudSelectItem>
                            @foreach (var group in _categoryGroups.OrderBy(g => g.Name))
                            {
                                <MudSelectItem @key="group.Id" T="int?" Value="null" Disabled="true">
                                    <strong>@group.Name</strong>
                                </MudSelectItem>
                                @foreach (var category in group.Categories.Where(c => c.IsActive).OrderBy(c => c.Name))
                                {
                                    <MudSelectItem @key="category.Id" T="int?" Value="category.Id">&nbsp;&nbsp;&nbsp;@category.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                        <MudCheckBox @bind-Value="_clearCategory" Label="@L["Btn_Clear"]" Color="MudBlazor.Color.Secondary" 
                                     Disabled="!_updateCategory" Dense="true" />
                    </MudStack>
                }
            </MudStack>

            <!-- Payee -->
            <MudStack Spacing="2">
                <MudCheckBox @bind-Value="_updatePayee" Label="@L["BulkEditDlg_UpdatePayee"]" Color="MudBlazor.Color.Primary" />
                @if (_updatePayee)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudSelect T="int?" @bind-Value="_payeeId" Label="@L["Col_Payee"]" Variant="Variant.Outlined" 
                                   Disabled="!_updatePayee || _clearPayee" FullWidth="true">
                            <MudSelectItem T="int?" Value="null">@L["BulkEditDlg_SelectPayee"]</MudSelectItem>
                            @foreach (var payee in _payees.OrderBy(p => p.Name))
                            {
                                <MudSelectItem @key="payee.Id" T="int?" Value="payee.Id">@payee.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudCheckBox @bind-Value="_clearPayee" Label="@L["Btn_Clear"]" Color="MudBlazor.Color.Secondary" 
                                     Disabled="!_updatePayee" Dense="true" />
                    </MudStack>
                }
            </MudStack>

            <!-- Tags -->
            <MudStack Spacing="2">
                <MudCheckBox @bind-Value="_updateTags" Label="@L["BulkEditDlg_UpdateTags"]" Color="MudBlazor.Color.Primary" />
                @if (_updateTags)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_tagsInput" Label="@L["BulkEditDlg_Tags"]" Variant="Variant.Outlined"
                                      Disabled="!_updateTags || _clearTags" FullWidth="true"
                                      HelperText="@L["BulkEditDlg_TagsHelper"]" />
                        <MudCheckBox @bind-Value="_clearTags" Label="@L["Btn_Clear"]" Color="MudBlazor.Color.Secondary" 
                                     Disabled="!_updateTags" Dense="true" />
                    </MudStack>
                }
            </MudStack>

            <!-- Status -->
            <MudStack Spacing="2">
                <MudCheckBox @bind-Value="_updateStatus" Label="@L["BulkEditDlg_UpdateStatus"]" Color="MudBlazor.Color.Primary" />
                @if (_updateStatus)
                {
                    <MudSelect T="TransactionStatus?" @bind-Value="_status" Label="@L["Col_Status"]" Variant="Variant.Outlined" 
                               Disabled="!_updateStatus" FullWidth="true">
                        <MudSelectItem T="TransactionStatus?" Value="TransactionStatus.Pending">@L["Status_Pending"]</MudSelectItem>
                        <MudSelectItem T="TransactionStatus?" Value="TransactionStatus.Posted">@L["Status_Posted"]</MudSelectItem>
                    </MudSelect>
                }
            </MudStack>

            <!-- Cleared Flag -->
            <MudStack Spacing="2">
                <MudCheckBox @bind-Value="_updateCleared" Label="@L["BulkEditDlg_UpdateCleared"]" Color="MudBlazor.Color.Primary" />
                @if (_updateCleared)
                {
                    <MudCheckBox @bind-Value="_isCleared" Label="@L["BulkEditDlg_MarkCleared"]" Color="MudBlazor.Color.Info" 
                                 Disabled="!_updateCleared" />
                    @if (_reconciledCount > 0)
                    {
                        <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">
                            @L["BulkEditDlg_ReconciledClearedWarning"]
                        </MudAlert>
                    }
                }
            </MudStack>
        </MudStack>

        <DialogErrorAlert Message="@_errorMessage" />
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnCancel="Cancel"
                             OnSubmit="Submit"
                             IsSubmitting="_isSubmitting"
                             SubmitText="@string.Format(L["BulkEditDlg_UpdateButton"], SelectedTransactionIds.Count)" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public List<int> SelectedTransactionIds { get; set; } = [];
    [Parameter] public int ReconciledCount { get; set; }

    private List<CategoryGroup> _categoryGroups = [];
    private List<Payee> _payees = [];
    private bool _isSubmitting;
    private string? _errorMessage;
    private int _reconciledCount;

    // Update flags
    private bool _updateCategory;
    private bool _updatePayee;
    private bool _updateTags;
    private bool _updateStatus;
    private bool _updateCleared;

    // Values
    private int? _categoryId;
    private int? _payeeId;
    private string _tagsInput = string.Empty;
    private TransactionStatus? _status;
    private bool _isCleared;

    // Clear flags
    private bool _clearCategory;
    private bool _clearPayee;
    private bool _clearTags;

    protected override async Task OnInitializedAsync()
    {
        _reconciledCount = ReconciledCount;
        
        // Load categories
        _categoryGroups = (await CategoryService.GetCategoryGroupsAsync(UserId)).ToList();
        
        // Load payees
        _payees = await PayeeService.GetPayeesAsync(UserId);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        _errorMessage = null;

        // Validate at least one update is selected
        if (!_updateCategory && !_updatePayee && !_updateTags && !_updateStatus && !_updateCleared)
        {
            _errorMessage = L["BulkEditDlg_SelectOneField"];
            return;
        }

        // Build request
        var request = new BulkEditTransactionRequest
        {
            TransactionIds = SelectedTransactionIds
        };

        if (_updateCategory)
        {
            request.ClearCategory = _clearCategory;
            if (!_clearCategory)
            {
                request.CategoryId = _categoryId;
            }
        }

        if (_updatePayee)
        {
            request.ClearPayee = _clearPayee;
            if (!_clearPayee)
            {
                request.PayeeId = _payeeId;
            }
        }

        if (_updateTags)
        {
            request.ClearTags = _clearTags;
            if (!_clearTags && !string.IsNullOrWhiteSpace(_tagsInput))
            {
                request.Tags = _tagsInput.Split(',')
                    .Select(t => t.Trim())
                    .Where(t => !string.IsNullOrWhiteSpace(t))
                    .ToList();
            }
            else if (!_clearTags)
            {
                request.Tags = [];
            }
        }

        if (_updateStatus && _status.HasValue)
        {
            request.Status = _status.Value;
        }

        if (_updateCleared)
        {
            request.IsCleared = _isCleared;
        }

        _isSubmitting = true;

        try
        {
            var result = await TransactionService.BulkUpdateTransactionsAsync(UserId, request);
            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (Exception ex)
        {
            _errorMessage = string.Format(L["BulkEditDlg_UpdateFailed"], ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
