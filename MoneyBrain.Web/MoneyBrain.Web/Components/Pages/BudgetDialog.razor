@using MoneyBrain.Web.Application.Budgets
@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Application.Settings
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject IBudgetService BudgetService
@inject ICategoryService CategoryService
@inject IDialogService DialogService
@inject ISnackbar SnackbarService
@inject IStringLocalizer<SharedResource> L
@inject ICurrencyFormattingService CurrencyFormattingService
@inject IUserSettingsService SettingsService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_name" 
                          Label="@L["BudgetDlg_BudgetName"]" 
                          Variant="Variant.Outlined" 
                          Required="true"
                          MaxLength="200"
                          Placeholder="@L["BudgetDlg_NamePlaceholder"]" />

            <MudTextField @bind-Value="_description" 
                          Label="@L["BudgetDlg_Description"]" 
                          Variant="Variant.Outlined"
                          Lines="2"
                          MaxLength="500" />

            <MudSwitch @bind-Value="_isDefault" 
                       Label="@L["BudgetDlg_DefaultBudget"]" 
                       Color="Color.Primary">
                <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">
                    @L["BudgetDlg_DefaultBudgetDesc"]
                </MudText>
            </MudSwitch>

            @if (!_isDefault)
            {
                <div class="d-flex gap-2">
                    <MudSelect @bind-Value="_selectedMonth" 
                               Label="@L["BudgetDlg_Month"]" 
                               Variant="Variant.Outlined"
                               Required="true">
                        @for (int i = 1; i <= 12; i++)
                        {
                            var month = i;
                            var monthName = new DateTime(2000, month, 1).ToString("MMMM");
                            <MudSelectItem Value="@month">@monthName</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField @bind-Value="_selectedYear" 
                                     Label="@L["BudgetDlg_Year"]" 
                                     Variant="Variant.Outlined"
                                     Required="true"
                                     Min="2000"
                                     Max="2100" />
                </div>
                
                @if (IsNew && _defaultBudgets.Count > 0)
                {
                    <MudSwitch @bind-Value="_copyFromDefault" 
                               Label="@L["BudgetDlg_CopyFromDefault"]" 
                               Color="Color.Primary"
                               T="bool">
                        <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">
                            @L["BudgetDlg_CopyFromDefaultDesc"]
                        </MudText>
                    </MudSwitch>
                    
                    @if (_copyFromDefault)
                    {
                        <MudSelect @bind-Value="_selectedDefaultBudgetId" 
                                   Label="@L["BudgetDlg_SelectDefaultBudget"]" 
                                   Variant="Variant.Outlined"
                                   Required="true">
                            @foreach (var defaultBudget in _defaultBudgets)
                            {
                                <MudSelectItem @key="defaultBudget.Id" Value="@defaultBudget.Id">@defaultBudget.Name</MudSelectItem>
                            }
                        </MudSelect>
                        
                        @if (_selectedDefaultBudgetId > 0)
                        {
                            <MudButton Variant="Variant.Outlined" 
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       OnClick="@CopyFromDefaultBudget"
                                       Disabled="@(_budgetCategories.Count > 0)">
                                @L["BudgetDlg_CopyCategories"]
                            </MudButton>
                            
                            @if (_budgetCategories.Count > 0)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    @L["BudgetDlg_CategoriesCopied"]
                                </MudAlert>
                            }
                        }
                    }
                }
            }

            <MudDivider Class="my-2" />

            <div class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h6">@L["BudgetDlg_Categories"]</MudText>
                <MudButton Variant="Variant.Outlined" 
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@OpenAddCategoryDialog"
                           Disabled="@(!IsNew && Budget == null)">
                    @L["BudgetDlg_AddCategory"]
                </MudButton>
            </div>

            @if (_budgetCategories.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Surface" Class="text-center py-3">
                    @L["BudgetDlg_NoCategoriesYet"]
                </MudText>
            }
            else
            {
                <MudTable Items="@_budgetCategories.OrderBy(bc => bc.Category.Name)" 
                          Dense="true"
                          Hover="true">
                    <HeaderContent>
                        <MudTh>@L["Col_Category"]</MudTh>
                        <MudTh Style="text-align: right;">@L["BudgetDlg_Amount"]</MudTh>
                        <MudTh Style="text-align: center;">@L["BudgetDlg_Rollover"]</MudTh>
                        <MudTh>@L["Col_Notes"]</MudTh>
                        <MudTh Style="text-align: right;">@L["Col_Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Category.Name</MudTd>
                        <MudTd Style="text-align: right;">@CurrencyFormattingService.FormatCurrency(context.PlannedAmount, _userSettings?.CurrencyCode ?? "USD")</MudTd>
                        <MudTd Style="text-align: center;">
                            @if (context.AllowRollover)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                            }
                        </MudTd>
                        <MudTd>
                            @{
                                var notesText = string.IsNullOrWhiteSpace(context.Notes) ? L["BudgetDlg_NoNotes"] : context.Notes;
                                <MudText Typo="Typo.body2" Style="color: var(--mb-text-muted);">
                                    @notesText
                                </MudText>
                            }
                        </MudTd>
                        <MudTd Style="text-align: right;">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => RemoveCategory(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudText Typo="Typo.body2" Class="mt-2">
                    <strong>@L["BudgetDlg_Total"]:</strong> @CurrencyFormattingService.FormatCurrency(_budgetCategories.Sum(bc => bc.PlannedAmount), _userSettings?.CurrencyCode ?? "USD")
                </MudText>
            }
        </MudStack>

        <DialogErrorAlert Message="@_errorMessage" />
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnCancel="Cancel"
                             OnSubmit="Submit"
                             IsSubmitting="_isSubmitting"
                             SubmitText="@(IsNew ? L["BudgetDlg_CreateBudget"] : L["BudgetDlg_UpdateBudget"])" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public Budget? Budget { get; set; }
    [Parameter] public bool IsNew { get; set; } = true;

    private string _name = string.Empty;
    private string? _description;
    private bool _isDefault = false;
    private int _selectedYear = DateTime.UtcNow.Year;
    private int _selectedMonth = DateTime.UtcNow.Month;
    private bool _isSubmitting;
    private string? _errorMessage;
    
    private List<BudgetCategory> _budgetCategories = [];
    private List<Category> _allCategories = [];
    private List<Budget> _defaultBudgets = [];
    private bool _copyFromDefault = false;
    private int _selectedDefaultBudgetId = 0;
    private UserSettings? _userSettings;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(UserId))
        {
            _userSettings = await SettingsService.GetSettingsAsync(UserId);
        }

        // Load all available categories
        var groups = await CategoryService.GetCategoryGroupsAsync(UserId, includeCategories: true);
        _allCategories = groups.SelectMany(g => g.Categories.Where(c => c.IsActive)).ToList();
        
        // Load default budgets for copying (only when creating new budget)
        if (IsNew)
        {
            var allBudgets = await BudgetService.GetBudgetsAsync(UserId);
            _defaultBudgets = allBudgets.Where(b => b.IsDefault).ToList();
        }

        if (!IsNew && Budget != null)
        {
            _name = Budget.Name;
            _description = Budget.Description;
            _isDefault = Budget.IsDefault;
            _selectedYear = Budget.Year ?? DateTime.UtcNow.Year;
            _selectedMonth = Budget.Month ?? DateTime.UtcNow.Month;
            
            // Load existing budget categories
            var loadedBudget = await BudgetService.GetBudgetByIdAsync(Budget.Id, UserId);
            if (loadedBudget != null)
            {
                _budgetCategories = loadedBudget.BudgetCategories.ToList();
            }
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _errorMessage = L["BudgetDlg_NameRequired"];
            return;
        }

        _isSubmitting = true;

        try
        {
            Budget budget;
            
            if (IsNew)
            {
                // Create new budget
                budget = await BudgetService.CreateBudgetAsync(
                    UserId, 
                    _name, 
                    _description, 
                    _isDefault,
                    _isDefault ? null : _selectedYear, 
                    _isDefault ? null : _selectedMonth);
                
                // Add all categories
                foreach (var bc in _budgetCategories)
                {
                    await BudgetService.AddCategoryToBudgetAsync(budget.Id, UserId, bc.CategoryId, bc.PlannedAmount, bc.AllowRollover, bc.Notes);
                }
            }
            else
            {
                if (Budget == null)
                {
                    _errorMessage = L["BudgetDlg_NotFound"];
                    return;
                }
                
                // Update existing budget
                budget = await BudgetService.UpdateBudgetAsync(
                    Budget.Id, 
                    UserId, 
                    _name, 
                    _description, 
                    _isDefault,
                    _isDefault ? null : _selectedYear, 
                    _isDefault ? null : _selectedMonth);
            }

            MudDialog.Close(DialogResult.Ok(budget));
        }
        catch (Exception ex)
        {
            _errorMessage = string.Format(L["Msg_Error"], ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OpenAddCategoryDialog()
    {
        // Get categories not yet in the budget
        var usedCategoryIds = _budgetCategories.Select(bc => bc.CategoryId).ToHashSet();
        var availableCategories = _allCategories.Where(c => !usedCategoryIds.Contains(c.Id)).ToList();

        if (availableCategories.Count == 0)
        {
            SnackbarService.Add(L["BudgetDlg_AllCategoriesAdded"], Severity.Info);
            return;
        }

        var parameters = new DialogParameters<AddCategoryToBudgetDialog>
        {
            { x => x.AvailableCategories, availableCategories },
            { x => x.UserId, UserId },
            { x => x.BudgetId, Budget?.Id ?? 0 },
            { x => x.IsNewBudget, IsNew }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddCategoryToBudgetDialog>(L["BudgetDlg_AddCategoriesTitle"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: List<BudgetCategory> categories })
        {
            _budgetCategories.AddRange(categories);
            StateHasChanged();
        }
    }

    private async Task RemoveCategory(BudgetCategory budgetCategory)
    {
        if (!IsNew && budgetCategory.Id > 0)
        {
            // Remove from database
            var success = await BudgetService.RemoveCategoryFromBudgetAsync(budgetCategory.Id, UserId);
            if (!success)
            {
                SnackbarService.Add(L["BudgetDlg_RemoveFailed"], Severity.Error);
                return;
            }
        }
        
        _budgetCategories.Remove(budgetCategory);
        StateHasChanged();
    }
    
    private async Task CopyFromDefaultBudget()
    {
        if (_selectedDefaultBudgetId <= 0)
            return;
            
        try
        {
            var defaultBudget = await BudgetService.GetBudgetByIdAsync(_selectedDefaultBudgetId, UserId);
            if (defaultBudget == null)
            {
                SnackbarService.Add(L["BudgetDlg_DefaultNotFound"], Severity.Error);
                return;
            }
            
            // Clear existing categories
            _budgetCategories.Clear();
            
            // Copy categories from default budget
            foreach (var bc in defaultBudget.BudgetCategories)
            {
                var category = _allCategories.FirstOrDefault(c => c.Id == bc.CategoryId);
                if (category != null)
                {
                    _budgetCategories.Add(new BudgetCategory
                    {
                        CategoryId = bc.CategoryId,
                        Category = category,
                        PlannedAmount = bc.PlannedAmount,
                        AllowRollover = bc.AllowRollover,
                        Notes = bc.Notes
                    });
                }
            }
            
            StateHasChanged();
            SnackbarService.Add(string.Format(L["BudgetDlg_CopiedCategories"], _budgetCategories.Count, defaultBudget.Name), Severity.Success);
        }
        catch (Exception ex)
        {
            SnackbarService.Add(string.Format(L["BudgetDlg_CopyError"], ex.Message), Severity.Error);
        }
    }
}
