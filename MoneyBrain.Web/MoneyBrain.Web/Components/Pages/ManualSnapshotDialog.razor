@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <MudAlert Severity="Severity.Info" Dense="true">
                    @L["SnapshotDlg_Description"]
                </MudAlert>

                <MudTextField @bind-Value="Account.Name"
                              Label="@L["Col_Account"]"
                              ReadOnly="true"
                              Variant="Variant.Filled" />

                <MudNumericField @bind-Value="_currentBalance"
                                 Label="@L["SnapshotDlg_CurrentBalance"]"
                                 ReadOnly="true"
                                 Variant="Variant.Filled"
                                 Format="C2"
                                 HelperText="@L["SnapshotDlg_BalanceHelper"]" />

                <MudDatePicker @bind-Date="_snapshotDate"
                               Label="@L["SnapshotDlg_SnapshotDate"]"
                               Required="true"
                               RequiredError="@L["SnapshotDlg_DateRequired"]"
                               Variant="Variant.Outlined"
                               disableFuture="true"
                               HelperText="@L["SnapshotDlg_DateTimeHelper"]" />

                <MudTimePicker @bind-Time="_snapshotTime"
                               Label="@L["SnapshotDlg_SnapshotTime"]"
                               Required="true"
                               RequiredError="@L["SnapshotDlg_TimeRequired"]"
                               Variant="Variant.Outlined"
                               HelperText="@L["SnapshotDlg_TimeHelper"]" />

                <MudTextField @bind-Value="_notes"
                              Label="@L["AcctDlg_Notes"]"
                              Lines="3"
                              Variant="Variant.Outlined"
                              HelperText="@L["SnapshotDlg_NotesHelper"]" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Submit" 
                   Disabled="@(!_isValid || _isSaving)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">@L["SnapshotDlg_Creating"]</MudText>
            }
            else
            {
                <MudText>@L["SnapshotDlg_CreateButton"]</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Account Account { get; set; } = default!;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSaving;
    private decimal _currentBalance;
    private DateTime? _snapshotDate = DateTime.Today;
    private TimeSpan? _snapshotTime = DateTime.Now.TimeOfDay;
    private string? _notes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _currentBalance = await AccountService.CalculateCurrentBalanceAsync(Account.Id, UserId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["SnapshotDlg_BalanceError"], ex.Message), Severity.Error);
            _currentBalance = Account.OpeningBalance;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        if (!_isValid || !_snapshotDate.HasValue || !_snapshotTime.HasValue) return;

        _isSaving = true;
        try
        {
            var snapshotDateTime = _snapshotDate.Value.Date + _snapshotTime.Value;

            await AccountService.CreateBalanceSnapshotAsync(
                Account.Id,
                _currentBalance,
                snapshotDateTime,
                SnapshotType.Manual,
                _notes,
                UserId);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["SnapshotDlg_CreateError"], ex.Message), Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
