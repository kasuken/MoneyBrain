@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization

@inject IAccountService AccountService
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudTextField @bind-Value="_model.Name"
                          Label="@L["AcctDlg_AccountName"]"
                          Required="true"
                          RequiredError="@L["AcctDlg_NameRequired"]"
                          MaxLength="100"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            <MudSelect @bind-Value="_model.Type"
                       Label="@L["AcctDlg_AccountType"]"
                       Required="true"
                       Variant="Variant.Outlined"
                       Class="mb-3">
                <MudSelectItem Value="@AccountType.Asset">@L["AcctDlg_Asset"]</MudSelectItem>
                <MudSelectItem Value="@AccountType.Liability">@L["AcctDlg_Liability"]</MudSelectItem>
            </MudSelect>

            <MudSelect @bind-Value="_model.SubType"
                       Label="@L["AcctDlg_AccountSubType"]"
                       Required="true"
                       Variant="Variant.Outlined"
                       Class="mb-3">
                @if (_model.Type == AccountType.Asset)
                {
                    <MudSelectItem Value="@AccountSubType.Cash">@L["AcctDlg_Cash"]</MudSelectItem>
                    <MudSelectItem Value="@AccountSubType.Checking">@L["AcctDlg_Checking"]</MudSelectItem>
                    <MudSelectItem Value="@AccountSubType.Savings">@L["AcctDlg_Savings"]</MudSelectItem>
                    <MudSelectItem Value="@AccountSubType.Investment">@L["AcctDlg_Investment"]</MudSelectItem>
                    <MudSelectItem Value="@AccountSubType.DebitCard">@L["AcctDlg_DebitCard"]</MudSelectItem>
                    <MudSelectItem Value="@AccountSubType.OtherAsset">@L["AcctDlg_OtherAsset"]</MudSelectItem>
                }
                else
                {
                    <MudSelectItem Value="@AccountSubType.CreditCard">@L["AcctDlg_CreditCard"]</MudSelectItem>
                    <MudSelectItem Value="@AccountSubType.Loan">@L["AcctDlg_Loan"]</MudSelectItem>
                    <MudSelectItem Value="@AccountSubType.Mortgage">@L["AcctDlg_Mortgage"]</MudSelectItem>
                    <MudSelectItem Value="@AccountSubType.OtherLiability">@L["AcctDlg_OtherLiability"]</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_model.Group"
                          Label="@L["AcctDlg_Group"]"
                          MaxLength="50"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          HelperText="@L["AcctDlg_GroupHelper"]" />

            <MudNumericField @bind-Value="_model.OpeningBalance"
                             Label="@L["AcctDlg_OpeningBalance"]"
                             Variant="Variant.Outlined"
                             Class="mb-3"
                             Format="C2"
                             Culture="@System.Globalization.CultureInfo.CurrentCulture"
                             HelperText="@L["AcctDlg_OpeningBalanceHelper"]" />

            <MudNumericField @bind-Value="_model.MonthlySpendingLimit"
                             Label="@L["AcctDlg_MonthlySpendingLimit"]"
                             Variant="Variant.Outlined"
                             Class="mb-3"
                             Format="N2"
                             Min="0"
                             HelperText="@L["AcctDlg_MonthlySpendingLimitHelper"]" />

            @if (_model.SubType == AccountSubType.CreditCard || _model.SubType == AccountSubType.DebitCard)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["AcctDlg_CardBillingCycle"]</MudText>
                <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--mb-text-muted);">
                    @L["AcctDlg_BillingCycleDesc"]
                </MudText>

                <MudNumericField @bind-Value="_model.BillingCycleDay"
                                 Label="@L["AcctDlg_BillingCycleDay"]"
                                 Variant="Variant.Outlined"
                                 Class="mb-3"
                                 Required="true"
                                 RequiredError="@L["AcctDlg_BillingCycleDayRequired"]"
                                 Min="1"
                                 Max="31"
                                 HelperText="@L["AcctDlg_BillingCycleDayHelper"]" />

                <MudSelect T="int?" @bind-Value="_model.LinkedPaymentAccountId"
                           Label="@L["AcctDlg_PaymentAccount"]"
                           Variant="Variant.Outlined"
                           Class="mb-3"
                           Required="true"
                           RequiredError="@L["AcctDlg_PaymentAccountRequired"]"
                           Clearable="false"
                           HelperText="@L["AcctDlg_PaymentAccountHelper"]">
                    @foreach (var account in _assetAccounts)
                    {
                        <MudSelectItem T="int?" Value="@account.Id">@account.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            <MudTextField @bind-Value="_model.Notes"
                          Label="@L["AcctDlg_Notes"]"
                          Lines="3"
                          MaxLength="500"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            <MudCheckBox T="bool" @bind-Checked="_model.IsActive"
                         Label="@L["AcctDlg_Active"]"
                         Color="Color.Primary" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Save" 
                   Disabled="@(!_isValid || _isSaving)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <text>@L["Btn_Save"]</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudBlazor.IDialogService DialogService { get; set; } = default!;

    [Parameter]
    public string? UserId { get; set; }

    [Parameter]
    public Account? Account { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    [CascadingParameter] 
    IMudDialogInstance DialogInstance { get; set; } = default!;

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSaving;
    private AccountModel _model = new();
    private List<Account> _assetAccounts = [];

    protected override async Task OnInitializedAsync()
    {
        // Load asset accounts for the payment account dropdown
        if (!string.IsNullOrWhiteSpace(UserId))
        {
            var allAccounts = await AccountService.GetUserAccountsAsync(UserId);
            _assetAccounts = allAccounts
                .Where(a => a.Type == AccountType.Asset && a.Id != Account?.Id)
                .ToList();
        }

        if (Account != null)
        {
            _model = new AccountModel
           {
                Name = Account.Name,
                Type = Account.Type,
                SubType = Account.SubType,
                Group = Account.Group,
                OpeningBalance = Account.OpeningBalance,
                MonthlySpendingLimit = Account.MonthlySpendingLimit,
                BillingCycleDay = Account.BillingCycleDay,
                LinkedPaymentAccountId = Account.LinkedPaymentAccountId,
                Notes = Account.Notes,
                IsActive = Account.IsActive
            };
        }
        else
        {
            // Defaults for new account
            _model = new AccountModel
            {
                Type = AccountType.Asset,
                SubType = AccountSubType.Checking,
                IsActive = true
            };
        }
    }

    private void Cancel()
    {
        DialogInstance.Cancel();
    }

    private async Task Save()
    {
        await _form.Validate();
        if (!_isValid)
            return;

        // Additional validation for card accounts (credit and debit)
        var isCardAccount = _model.SubType == AccountSubType.CreditCard || _model.SubType == AccountSubType.DebitCard;
        if (isCardAccount)
        {
            if (!_model.BillingCycleDay.HasValue || _model.BillingCycleDay < 1 || _model.BillingCycleDay > 31)
            {
                return; // Form validation should have caught this
            }
            if (!_model.LinkedPaymentAccountId.HasValue)
            {
                return; // Form validation should have caught this
            }
        }

        _isSaving = true;
        try
        {
            if (IsNew)
            {
                var newAccount = new Account
                {
                    UserId = UserId!,
                    Name = _model.Name!,
                    Type = _model.Type,
                    SubType = _model.SubType,
                    Group = _model.Group,
                    OpeningBalance = _model.OpeningBalance,
                    MonthlySpendingLimit = _model.MonthlySpendingLimit,
                    BillingCycleDay = isCardAccount ? _model.BillingCycleDay : null,
                    LinkedPaymentAccountId = isCardAccount ? _model.LinkedPaymentAccountId : null,
                    Notes = _model.Notes,
                    IsActive = _model.IsActive
                };

                await AccountService.CreateAccountAsync(newAccount);
            }
            else if (Account != null)
            {
                Account.Name = _model.Name!;
                Account.Type = _model.Type;
                Account.SubType = _model.SubType;
                Account.Group = _model.Group;
                Account.OpeningBalance = _model.OpeningBalance;
                Account.MonthlySpendingLimit = _model.MonthlySpendingLimit;
                Account.BillingCycleDay = isCardAccount ? _model.BillingCycleDay : null;
                Account.LinkedPaymentAccountId = isCardAccount ? _model.LinkedPaymentAccountId : null;
                Account.Notes = _model.Notes;
                Account.IsActive = _model.IsActive;

                await AccountService.UpdateAccountAsync(Account);
            }

            DialogInstance.Close(DialogResult.Ok(true));
        }
        finally
        {
            _isSaving = false;
        }
    }

    private class AccountModel
    {
        public string? Name { get; set; }
        public AccountType Type { get; set; }
        public AccountSubType SubType { get; set; }
        public string? Group { get; set; }
        public decimal OpeningBalance { get; set; }
        public decimal? MonthlySpendingLimit { get; set; }
        public int? BillingCycleDay { get; set; }
        public int? LinkedPaymentAccountId { get; set; }
        public string? Notes { get; set; }
        public bool IsActive { get; set; }
    }
}
