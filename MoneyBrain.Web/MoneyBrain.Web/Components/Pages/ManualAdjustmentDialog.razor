@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Domain.Entities
@inject IAccountService AccountService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <MudAlert Severity="Severity.Info" Dense="true">
                    Manual adjustments directly affect the account balance. All adjustments are fully auditable.
                </MudAlert>

                <MudTextField @bind-Value="Account.Name"
                              Label="Account"
                              ReadOnly="true"
                              Variant="Variant.Filled" />

                <MudNumericField @bind-Value="_currentBalance"
                                 Label="Current Balance"
                                 ReadOnly="true"
                                 Variant="Variant.Filled"
                                 Format="C2" />

                <MudNumericField @bind-Value="_amount"
                                 Label="Adjustment Amount"
                                 Required="true"
                                 RequiredError="Amount is required"
                                 Variant="Variant.Outlined"
                                 Format="C2"
                                 HelperText="Positive = increase balance, Negative = decrease balance" />

                <MudDatePicker @bind-Date="_adjustmentDate"
                               Label="Adjustment Date"
                               Required="true"
                               RequiredError="Date is required"
                               Variant="Variant.Outlined"
                               HelperText="When this adjustment takes effect" />

                <MudSelect T="string"
                           @bind-Value="_category"
                           Label="Category (optional)"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    <MudSelectItem Value="@("Bank Fee")">Bank Fee</MudSelectItem>
                    <MudSelectItem Value="@("Interest")">Interest</MudSelectItem>
                    <MudSelectItem Value="@("Correction")">Correction</MudSelectItem>
                    <MudSelectItem Value="@("Service Charge")">Service Charge</MudSelectItem>
                    <MudSelectItem Value="@("ATM Fee")">ATM Fee</MudSelectItem>
                    <MudSelectItem Value="@("Overdraft Fee")">Overdraft Fee</MudSelectItem>
                    <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="_description"
                              Label="Description"
                              Required="true"
                              RequiredError="Description is required"
                              Lines="3"
                              Variant="Variant.Outlined"
                              HelperText="Explain why this adjustment is being made" />

                <MudAlert Severity="Severity.Success" Dense="true">
                    New Balance: <strong>@(_currentBalance + _amount).ToString("C2")</strong>
                </MudAlert>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Submit" 
                   Disabled="@(!_isValid || _isSaving)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Creating...</MudText>
            }
            else
            {
                <MudText>Create Adjustment</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Account Account { get; set; } = default!;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSaving;
    private decimal _currentBalance;
    private decimal _amount;
    private DateTime? _adjustmentDate = DateTime.Today;
    private string? _category;
    private string _description = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _currentBalance = await AccountService.CalculateCurrentBalanceAsync(Account.Id, UserId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error calculating balance: {ex.Message}", Severity.Error);
            _currentBalance = Account.OpeningBalance;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        if (!_isValid || !_adjustmentDate.HasValue) return;

        if (string.IsNullOrWhiteSpace(_description))
        {
            Snackbar.Add("Description is required", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            await AccountService.CreateManualAdjustmentAsync(
                Account.Id,
                _amount,
                _adjustmentDate.Value,
                _description,
                _category,
                UserId);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating adjustment: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
