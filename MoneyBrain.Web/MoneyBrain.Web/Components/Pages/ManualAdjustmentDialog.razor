@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@inject ICurrencyFormattingService CurrencyFormattingService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <MudAlert Severity="Severity.Info" Dense="true">
                    @L["AdjustDlg_Description"]
                </MudAlert>

                <MudTextField @bind-Value="Account.Name"
                              Label="@L["Col_Account"]"
                              ReadOnly="true"
                              Variant="Variant.Filled" />

                <MudNumericField @bind-Value="_currentBalance"
                                 Label="@L["AdjustDlg_CurrentBalance"]"
                                 ReadOnly="true"
                                 Variant="Variant.Filled"
                                 Format="C2" />

                <MudNumericField @bind-Value="_amount"
                                 Label="@L["AdjustDlg_AdjustmentAmount"]"
                                 Required="true"
                                 RequiredError="@L["AdjustDlg_AmountRequired"]"
                                 Variant="Variant.Outlined"
                                 Format="C2"
                                 HelperText="@L["AdjustDlg_AmountHelper"]" />

                <MudDatePicker @bind-Date="_adjustmentDate"
                               Label="@L["AdjustDlg_AdjustmentDate"]"
                               Required="true"
                               RequiredError="@L["AdjustDlg_DateRequired"]"
                               Variant="Variant.Outlined"
                               HelperText="@L["AdjustDlg_DateHelper"]" />

                <MudSelect T="string"
                           @bind-Value="_category"
                           Label="@L["AdjustDlg_Category"]"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    <MudSelectItem Value="@("Bank Fee")">@L["AdjustDlg_BankFee"]</MudSelectItem>
                    <MudSelectItem Value="@("Interest")">@L["AdjustDlg_Interest"]</MudSelectItem>
                    <MudSelectItem Value="@("Correction")">@L["AdjustDlg_Correction"]</MudSelectItem>
                    <MudSelectItem Value="@("Service Charge")">@L["AdjustDlg_ServiceCharge"]</MudSelectItem>
                    <MudSelectItem Value="@("ATM Fee")">@L["AdjustDlg_ATMFee"]</MudSelectItem>
                    <MudSelectItem Value="@("Overdraft Fee")">@L["AdjustDlg_OverdraftFee"]</MudSelectItem>
                    <MudSelectItem Value="@("Other")">@L["AdjustDlg_Other"]</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="_description"
                              Label="@L["AdjustDlg_DescriptionLabel"]"
                              Required="true"
                              RequiredError="@L["AdjustDlg_DescriptionRequired"]"
                              Lines="3"
                              Variant="Variant.Outlined"
                              HelperText="@L["AdjustDlg_DescriptionHelper"]" />

                <MudAlert Severity="Severity.Success" Dense="true">
                    @L["AdjustDlg_NewBalance"]: <strong>@CurrencyFormattingService.FormatCurrency(_currentBalance + _amount, _userSettings?.CurrencyCode ?? "USD")</strong>
                </MudAlert>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Submit" 
                   Disabled="@(!_isValid || _isSaving)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">@L["AdjustDlg_Creating"]</MudText>
            }
            else
            {
                <MudText>@L["AdjustDlg_CreateButton"]</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Account Account { get; set; } = default!;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSaving;
    private decimal _currentBalance;
    private decimal _amount;
    private DateTime? _adjustmentDate = DateTime.Today;
    private string? _category;
    private string _description = string.Empty;
    private UserSettings? _userSettings;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _currentBalance = await AccountService.CalculateCurrentBalanceAsync(Account.Id, UserId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["AdjustDlg_BalanceError"], ex.Message), Severity.Error);
            _currentBalance = Account.OpeningBalance;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        if (!_isValid || !_adjustmentDate.HasValue) return;

        if (string.IsNullOrWhiteSpace(_description))
        {
            Snackbar.Add(L["AdjustDlg_DescriptionRequiredSnack"], Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            await AccountService.CreateManualAdjustmentAsync(
                Account.Id,
                _amount,
                _adjustmentDate.Value,
                _description,
                _category,
                UserId);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["AdjustDlg_CreateError"], ex.Message), Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
