@page "/transactions"
@using Microsoft.AspNetCore.Authorization
@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Application.Transactions
@using MoneyBrain.Web.Application.Transactions.Filtering
@using MoneyBrain.Web.Application.Transactions.BulkEdit
@using MoneyBrain.Web.Application.Transactions.Transfers
@using MoneyBrain.Web.Application.Settings
@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using System.Security.Claims
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Resources

@attribute [Authorize]


<PageTitle>@L["Nav_Transactions"] | @L["App_MoneyBrain"]</PageTitle>

<div class="mb-page mb-animate-in">
    <!-- Header -->
    <div class="mb-section-header">
        <div>
            <h1 class="mb-title">@L["Nav_Transactions"]</h1>
            <p class="mb-subtitle">@L["Trans_Subtitle"]</p>
        </div>
        <div class="transaction-buttons-container d-flex gap-2">
            @if (_selectedTransactions.Count > 0)
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="@OpenBulkEditDialog">
                    @L["Trans_BulkEdit"] (@_selectedTransactions.Count)
                </MudButton>
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="@ClearSelection">
                    @L["Trans_ClearSelection"]
                </MudButton>
            }
            else
            {
                @if (_pendingTransactionCount > 0)
                {
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Schedule"
                               OnClick="@ShowPendingTransactions">
                        @_pendingTransactionCount @L["Status_Pending"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               OnClick="@PostAllPendingTransactions">
                        @L["Trans_PostAllPending"]
                    </MudButton>
                }
                @if (_unreconciledTransactionCount > 0)
                {
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Outlined.LockOpen"
                               OnClick="@ShowUnreconciledTransactions">
                        @_unreconciledTransactionCount @L["Trans_Unreconciled"]
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary"
                           StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                           OnClick="@(() => _showFilters = !_showFilters)">
                    @(_showFilters ? L["Trans_HideFilters"] : L["Trans_ShowFilters"])
                </MudButton>
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Upload"
                           OnClick="@OpenCsvImportDialog">
                    @L["Trans_ImportCSV"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.SwapHoriz"
                           OnClick="@OpenCreateTransferDialog">
                    @L["Trans_Transfer"]
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                           Class="mb-btn-primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@OpenCreateTransactionDialog">
                    @L["Trans_AddTransaction"]
                </MudButton>
            }
        </div>
    </div>

    @if (_showFilters)
    {
        <MudPaper Class="mb-4 pa-4">
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int?" @bind-Value="@_filter.AccountId" Label="@L["Lbl_Account"]" Variant="Variant.Outlined" Clearable OnClearButtonClick="ApplyFilters">
                        @foreach (var account in _accounts)
                        {
                            <MudSelectItem @key="account.Id" T="int?" Value="@account.Id">@account.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="@_filter.SearchText" Label="@L["Lbl_Search"]" Variant="Variant.Outlined" 
                                  Placeholder="@L["Trans_SearchPlaceholder"]"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="TransactionType?" @bind-Value="@_filter.TransactionType" Label="@L["Trans_TransactionType"]" Variant="Variant.Outlined" Clearable>
                        <MudSelectItem T="TransactionType?" Value="@TransactionType.Income">@L["Trans_TypeIncome"]</MudSelectItem>
                        <MudSelectItem T="TransactionType?" Value="@TransactionType.Expense">@L["Trans_TypeExpense"]</MudSelectItem>
                        <MudSelectItem T="TransactionType?" Value="@TransactionType.Transfer">@L["Trans_TypeTransfer"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="@_filter.StartDate" Label="@L["Lbl_StartDate"]" Variant="Variant.Outlined" Clearable />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="@_filter.EndDate" Label="@L["Lbl_EndDate"]" Variant="Variant.Outlined" Clearable />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="TransactionStatus?" @bind-Value="@_filter.Status" Label="@L["Lbl_Status"]" Variant="Variant.Outlined" Clearable>
                        <MudSelectItem T="TransactionStatus?" Value="@TransactionStatus.Pending">@L["Status_Pending"]</MudSelectItem>
                        <MudSelectItem T="TransactionStatus?" Value="@TransactionStatus.Posted">@L["Status_Posted"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="@_filter.MinAmount" Label="@L["Trans_MinAmount"]" Variant="Variant.Outlined" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="@_filter.MaxAmount" Label="@L["Trans_MaxAmount"]" Variant="Variant.Outlined" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudCheckBox @bind-Value="@_filter.IsCleared" Label="@L["Trans_ClearedOnly"]" Color="Color.Primary" TriState />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudCheckBox @bind-Value="@_filter.IsReconciled" Label="@L["Trans_ReconciledOnly"]" Color="Color.Primary" TriState />
                </MudItem>
            </MudGrid>
            <div class="d-flex gap-2 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilters">@L["Trans_ApplyFilters"]</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="ClearFilters">@L["Trans_ClearAll"]</MudButton>
                @if (_filter.HasActiveFilters)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@string.Format(L["Trans_FiltersActive"], GetActiveFilterCount())</MudChip>
                }
            </div>
        </MudPaper>
    }

    @if (_isLoading)
    {
        <TransactionsLoader />
    }
    else if (_transactions.Count == 0)
    {
        <div class="mb-empty-state">
            <MudIcon Icon="@Icons.Material.Outlined.Receipt" Class="mb-empty-state-icon" />
            <MudText Typo="Typo.h6" Class="mb-2">@L["Trans_NoTransactionsYet"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mb-text-muted);">
                @L["Trans_StartTracking"]
            </MudText>
            <MudButton Variant="Variant.Filled" Class="mb-btn-primary" OnClick="@OpenCreateTransactionDialog">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="me-2" />
                @L["Trans_AddFirstTransaction"]
            </MudButton>
        </div>
    }
    else
    {
        <MudDataGrid T="Transaction" Items="@_transactions" Dense="true" Hover="true" 
                     MultiSelection="true" @bind-SelectedItems="_selectedTransactions"
                     SelectOnRowClick="false"
                     Groupable="true"
                     GroupExpanded="true"
                     pagination="true"
                     pageSize="100">
            <Columns>
                <SelectColumn T="Transaction" />
                <PropertyColumn Property="t => t.Date" Title="@L["Col_Date"]" Format="yyyy-MM-dd" Grouping>
                    <GroupTemplate>
                        <span style="font-weight: bold">@GetGroupDateHeader(context)</span>
                    </GroupTemplate>
                </PropertyColumn>
                <PropertyColumn Property="t => t.Account.Name" Title="@L["Col_Account"]" />
                <TemplateColumn Title="@L["Col_Payee"]">
                    <CellTemplate>
                        <div class="d-flex align-center gap-2">
                            @if (context.Item.IsRecurring)
                            {
                                <MudTooltip Text="@L["Trans_RecurringTransaction"]">
                                    <MudIcon Icon="@Icons.Material.Filled.Loop" Size="Size.Small" Color="Color.Info" />
                                </MudTooltip>
                            }
                            @if (context.Item.TransferTransactionId.HasValue)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Color="Color.Secondary" />
                                <span>@L["Trans_TypeTransfer"]</span>
                            }
                            else
                            {
                                <span>@context.Item.Payee?.Name</span>
                            }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Col_Category"]">
                    <CellTemplate>
                        @if (context.Item.TransferTransactionId.HasValue)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@L["Trans_TypeTransfer"]</MudChip>
                        }
                        else if (context.Item.Splits?.Any() == true)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@L["Trans_Split"] (@context.Item.Splits.Count)</MudChip>
                        }
                        else
                        {
                            @context.Item.Category?.Name
                        }
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="t => t.Memo" Title="@L["Col_Memo"]" />
                <TemplateColumn Title="@L["Col_Amount"]" SortBy="t => t.Amount">
                    <CellTemplate>
                        <span class="mb-amount @GetAmountClass(context.Item.Amount)">
                            @FormatCurrency(context.Item.Amount)
                        </span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Col_Status"]">
                    <CellTemplate>
                        @if (context.Item.IsReconciled)
                        {
                            <MudChip Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Success">@L["Status_Reconciled"]</MudChip>
                        }
                        else if (context.Item.IsCleared)
                        {
                            <MudChip Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Info">@L["Status_Cleared"]</MudChip>
                        }
                        else if (context.Item.Status == TransactionStatus.Posted)
                        {
                            <MudChip Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Default">@L["Status_Posted"]</MudChip>
                        }
                        else
                        {
                            <MudChip Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Warning">@L["Status_Pending"]</MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Col_Actions"]" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.TransferTransactionId.HasValue)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" 
                                           Size="MudBlazor.Size.Small"
                                           OnClick="@(() => OpenEditTransferDialog(context.Item))"
                                           Disabled="@context.Item.IsReconciled"
                                           title="@L["Trans_EditTransfer"]" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Size="MudBlazor.Size.Small"
                                           Color="MudBlazor.Color.Error"
                                           OnClick="@(() => DeleteTransfer(context.Item))"
                                           Disabled="@context.Item.IsReconciled"
                                           title="@L["Trans_DeleteTransfer"]" />
                        }
                        else
                        {
                            @if (context.Item.IsReconciled)
                            {
                                <MudTooltip Text="@L["Trans_ReconciledLocked"]">
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" 
                                            Size="MudBlazor.Size.Small"
                                            Color="MudBlazor.Color.Success" />
                                </MudTooltip>
                            }
                            <MudIconButton Icon="@(context.Item.IsCleared ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.CheckCircle)" 
                                           Size="MudBlazor.Size.Small"
                                           Color="@(context.Item.IsCleared ? MudBlazor.Color.Info : MudBlazor.Color.Default)"
                                           OnClick="@(() => ToggleCleared(context.Item))"
                                           Disabled="@context.Item.IsReconciled"
                                           title="@(context.Item.IsReconciled ? L["Trans_CannotClearReconciled"] : L["Trans_ToggleCleared"])" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                           Size="MudBlazor.Size.Small"
                                           OnClick="@(() => OpenEditTransactionDialog(context.Item))"
                                           Disabled="@context.Item.IsReconciled"
                                           title="@(context.Item.IsReconciled ? L["Trans_CannotEditReconciled"] : L["Trans_EditTransaction"])" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Size="MudBlazor.Size.Small"
                                           Color="MudBlazor.Color.Error"
                                           OnClick="@(() => DeleteTransaction(context.Item))"
                                           Disabled="@context.Item.IsReconciled"
                                           title="@(context.Item.IsReconciled ? L["Trans_CannotDeleteReconciled"] : L["Trans_DeleteTransaction"])" />
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="Transaction" 
                                  PageSizeOptions="new int[] { 50, 100, 250, 500 }" />
            </PagerContent>
        </MudDataGrid>
    }
    
    <HelpButton Title="@L["Trans_HelpTitle"]"
                Description="@L["Trans_HelpDescription"]"
                Features="@(new[] { 
                    L["Trans_HelpFeature1"].Value,
                    L["Trans_HelpFeature2"].Value,
                    L["Trans_HelpFeature3"].Value,
                    L["Trans_HelpFeature4"].Value,
                    L["Trans_HelpFeature5"].Value,
                    L["Trans_HelpFeature6"].Value,
                    L["Trans_HelpFeature7"].Value
                })"
                HowToUse="@(new[] {
                    L["Trans_HelpHowTo1"].Value,
                    L["Trans_HelpHowTo2"].Value,
                    L["Trans_HelpHowTo3"].Value,
                    L["Trans_HelpHowTo4"].Value,
                    L["Trans_HelpHowTo5"].Value
                })"
                Tips="@(new[] {
                    L["Trans_HelpTip1"].Value,
                    L["Trans_HelpTip2"].Value,
                    L["Trans_HelpTip3"].Value,
                    L["Trans_HelpTip4"].Value,
                    L["Trans_HelpTip5"].Value
                })" />
</div>

