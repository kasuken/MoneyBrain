@page "/transactions"
@using Microsoft.AspNetCore.Authorization
@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Application.Transactions
@using MoneyBrain.Web.Application.Transactions.Filtering
@using MoneyBrain.Web.Application.Settings
@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using System.Security.Claims

@attribute [Authorize]

@inject ITransactionService TransactionService
@inject IAccountService AccountService
@inject ICategoryService CategoryService
@inject IUserSettingsService SettingsService
@inject IDialogService DialogService
@inject ISnackbar SnackbarService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Transactions | MoneyBrain</PageTitle>

<div class="mb-page mb-animate-in">
    <!-- Header -->
    <div class="mb-section-header">
        <div>
            <h1 class="mb-title">Transactions</h1>
            <p class="mb-subtitle">Track income and expenses</p>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary"
                       StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                       OnClick="@(() => _showFilters = !_showFilters)">
                @(_showFilters ? "Hide Filters" : "Show Filters")
            </MudButton>
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Upload"
                       OnClick="@OpenCsvImportDialog">
                Import CSV
            </MudButton>
            <MudButton Variant="Variant.Filled" 
                       Class="mb-btn-primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OpenCreateTransactionDialog">
                Add Transaction
            </MudButton>
        </div>
    </div>

    @if (_showFilters)
    {
        <MudPaper Class="mb-4 pa-4">
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int?" @bind-Value="@_filter.AccountId" Label="Account" Variant="Variant.Outlined" Clearable OnClearButtonClick="ApplyFilters">
                        @foreach (var account in _accounts)
                        {
                            <MudSelectItem T="int?" Value="@account.Id">@account.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="@_filter.SearchText" Label="Search" Variant="Variant.Outlined" 
                                  Placeholder="Payee, memo, category..."
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="TransactionType?" @bind-Value="@_filter.TransactionType" Label="Transaction Type" Variant="Variant.Outlined" Clearable>
                        <MudSelectItem T="TransactionType?" Value="@TransactionType.Income">Income</MudSelectItem>
                        <MudSelectItem T="TransactionType?" Value="@TransactionType.Expense">Expense</MudSelectItem>
                        <MudSelectItem T="TransactionType?" Value="@TransactionType.Transfer">Transfer</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="@_filter.StartDate" Label="Start Date" Variant="Variant.Outlined" Clearable />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="@_filter.EndDate" Label="End Date" Variant="Variant.Outlined" Clearable />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="TransactionStatus?" @bind-Value="@_filter.Status" Label="Status" Variant="Variant.Outlined" Clearable>
                        <MudSelectItem T="TransactionStatus?" Value="@TransactionStatus.Pending">Pending</MudSelectItem>
                        <MudSelectItem T="TransactionStatus?" Value="@TransactionStatus.Posted">Posted</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="@_filter.MinAmount" Label="Min Amount" Variant="Variant.Outlined" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="@_filter.MaxAmount" Label="Max Amount" Variant="Variant.Outlined" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudCheckBox @bind-Value="@_filter.IsCleared" Label="Cleared Only" Color="Color.Primary" TriState />
                </MudItem>
            </MudGrid>
            <div class="d-flex gap-2 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilters">Apply Filters</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="ClearFilters">Clear All</MudButton>
                @if (_filter.HasActiveFilters)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@GetActiveFilterCount() filter(s) active</MudChip>
                }
            </div>
        </MudPaper>
    }

    @if (_isLoading)
    {
        <MudProgressLinear Color="MudBlazor.Color.Primary" Indeterminate="true" Class="mb-4" />
    }
    else if (_transactions.Count == 0)
    {
        <div class="mb-empty-state">
            <MudIcon Icon="@Icons.Material.Outlined.Receipt" Class="mb-empty-state-icon" />
            <MudText Typo="Typo.h6" Class="mb-2">No transactions yet</MudText>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mb-text-muted);">
                Start tracking your income and expenses
            </MudText>
            <MudButton Variant="Variant.Filled" Class="mb-btn-primary" OnClick="@OpenCreateTransactionDialog">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="me-2" />
                Add Your First Transaction
            </MudButton>
        </div>
    }
    else
    {
        <MudDataGrid T="Transaction" Items="@_transactions" Dense="true" Hover="true">
            <Columns>
                <PropertyColumn Property="t => t.Date" Title="Date" Format="yyyy-MM-dd" />
                <PropertyColumn Property="t => t.Account.Name" Title="Account" />
                <PropertyColumn Property="t => t.Payee!.Name" Title="Payee" />
                <PropertyColumn Property="t => t.Category!.Name" Title="Category" />
                <PropertyColumn Property="t => t.Memo" Title="Memo" />
                <TemplateColumn Title="Amount" SortBy="t => t.Amount">
                    <CellTemplate>
                        <span class="mb-amount @GetAmountClass(context.Item.Amount)">
                            @FormatCurrency(context.Item.Amount)
                        </span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        @if (context.Item.IsReconciled)
                        {
                            <MudChip Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Success">Reconciled</MudChip>
                        }
                        else if (context.Item.IsCleared)
                        {
                            <MudChip Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Info">Cleared</MudChip>
                        }
                        else if (context.Item.Status == TransactionStatus.Posted)
                        {
                            <MudChip Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Default">Posted</MudChip>
                        }
                        else
                        {
                            <MudChip Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Warning">Pending</MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Size="MudBlazor.Size.Small"
                                       OnClick="@(() => OpenEditTransactionDialog(context.Item))"
                                       Disabled="@context.Item.IsReconciled" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Error"
                                       OnClick="@(() => DeleteTransaction(context.Item))"
                                       Disabled="@context.Item.IsReconciled" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
</div>

@code {
    private List<Transaction> _transactions = [];
    private List<Account> _accounts = [];
    private bool _isLoading = true;
    private string? _userId;
    private string _currencyCode = "USD";
    private TransactionFilter _filter = new();
    private bool _showFilters = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(_userId))
        {
            var settings = await SettingsService.GetSettingsAsync(_userId);
            if (settings != null)
            {
                _currencyCode = settings.CurrencyCode;
            }

            _accounts = (await AccountService.GetUserAccountsAsync(_userId)).ToList();
            await LoadTransactions();
        }

        _isLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isLoading && _userId != null)
        {
            await LoadTransactions();
        }
    }

    private async Task LoadTransactions()
    {
        if (string.IsNullOrWhiteSpace(_userId))
            return;

        _transactions = await TransactionService.SearchTransactionsAsync(_userId, _filter);
    }

    private async Task ApplyFilters()
    {
        await LoadTransactions();
    }

    private async Task ClearFilters()
    {
        _filter.Clear();
        await LoadTransactions();
    }

    private int GetActiveFilterCount()
    {
        int count = 0;
        
        if (_filter.AccountId.HasValue) count++;
        if (!string.IsNullOrWhiteSpace(_filter.SearchText)) count++;
        if (_filter.StartDate.HasValue) count++;
        if (_filter.EndDate.HasValue) count++;
        if (_filter.MinAmount.HasValue) count++;
        if (_filter.MaxAmount.HasValue) count++;
        if (_filter.TransactionType.HasValue) count++;
        if (_filter.CategoryIds?.Any() == true) count++;
        if (_filter.PayeeIds?.Any() == true) count++;
        if (_filter.Status.HasValue) count++;
        if (_filter.IsCleared.HasValue) count++;
        if (_filter.IsReconciled.HasValue) count++;
        if (!_filter.IncludeTransfers) count++;
        if (_filter.Tags?.Any() == true) count++;
        
        return count;
    }

    private async Task OpenCreateTransactionDialog()
    {
        var parameters = new DialogParameters<TransactionDialog>
        {
            { x => x.UserId, _userId },
            { x => x.IsNew, true },
            { x => x.PreselectedAccountId, _filter.AccountId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TransactionDialog>("Add Transaction", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadTransactions();
            SnackbarService.Add("Transaction created successfully", Severity.Success);
        }
    }

    private async Task OpenCsvImportDialog()
    {
        var parameters = new DialogParameters<TransactionCsvImportDialog>
        {
            { x => x.UserId, _userId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TransactionCsvImportDialog>("Import Transactions from CSV", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: int importedCount })
        {
            if (importedCount > 0)
            {
                await LoadTransactions();
                SnackbarService.Add($"Imported {importedCount} transactions", Severity.Success);
            }
        }
    }

    private async Task OpenEditTransactionDialog(Transaction transaction)
    {
        var parameters = new DialogParameters<TransactionDialog>
        {
            { x => x.UserId, _userId },
            { x => x.Transaction, transaction },
            { x => x.IsNew, false }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TransactionDialog>("Edit Transaction", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadTransactions();
            SnackbarService.Add("Transaction updated successfully", Severity.Success);
        }
    }

    private async Task DeleteTransaction(Transaction transaction)
    {
        var result = await DialogService.ShowMessageBox(
            "Delete Transaction",
            $"Are you sure you want to delete this transaction? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (result == true && _userId != null)
        {
            try
            {
                var deleted = await TransactionService.DeleteTransactionAsync(transaction.Id, _userId);
                if (deleted)
                {
                    await LoadTransactions();
                    SnackbarService.Add("Transaction deleted successfully", Severity.Success);
                }
                else
                {
                    SnackbarService.Add("Failed to delete transaction", Severity.Error);
                }
            }
            catch (InvalidOperationException ex)
            {
                SnackbarService.Add("Cannot delete reconciled transaction", Severity.Error);
            }
        }
    }

    private string FormatCurrency(decimal amount)
    {
        var sign = amount >= 0 ? "+" : "";
        return $"{sign}{amount:N2} {_currencyCode}";
    }

    private string GetAmountClass(decimal amount) => amount switch
    {
        > 0 => "positive",
        < 0 => "negative",
        _ => "neutral"
    };
}
