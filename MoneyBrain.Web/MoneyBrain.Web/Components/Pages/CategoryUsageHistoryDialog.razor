@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Application.Settings
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject ICategoryService CategoryService
@inject IStringLocalizer<SharedResource> L
@inject ICurrencyFormattingService CurrencyFormattingService
@inject IUserSettingsService SettingsService

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center align-center pa-8">
                <MudProgressCircular Indeterminate="true" />
            </div>
        }
        else if (_errorMessage != null)
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }
        else
        {
            <MudStack Spacing="4">
                <!-- Header -->
                <div>
                    <MudText Typo="Typo.h5">@Category.Name</MudText>
                    <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">
                        @Category.CategoryGroup.Name
                    </MudText>
                </div>

                <!-- Overall Statistics -->
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-3">@L["CatUsageDlg_UsageStatistics"]</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="6" sm="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">@L["CatUsageDlg_TotalTransactions"]</MudText>
                                <MudText Typo="Typo.h6">@(_stats.TransactionCount + _stats.SplitCount)</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">@L["CatUsageDlg_TotalIncome"]</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Success">@CurrencyFormattingService.FormatCurrency(_stats.TotalIncome, _userSettings?.CurrencyCode ?? "USD")</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">@L["CatUsageDlg_TotalExpenses"]</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Error">@CurrencyFormattingService.FormatCurrency(_stats.TotalExpense, _userSettings?.CurrencyCode ?? "USD")</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">@L["CatUsageDlg_NetAmount"]</MudText>
                                <MudText Typo="Typo.h6" Color="@(_stats.NetAmount >= 0 ? Color.Success : Color.Error)">
                                    @CurrencyFormattingService.FormatCurrency(_stats.NetAmount, _userSettings?.CurrencyCode ?? "USD")
                                </MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">@L["CatUsageDlg_FirstUsed"]</MudText>
                                <MudText Typo="Typo.body2">
                                    @(_stats.FirstUsed?.ToString("MMM dd, yyyy") ?? L["CatUsageDlg_Never"])
                                </MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">@L["CatUsageDlg_LastUsed"]</MudText>
                                <MudText Typo="Typo.body2">
                                    @(_stats.LastUsed?.ToString("MMM dd, yyyy") ?? L["CatUsageDlg_Never"])
                                </MudText>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Monthly Trends -->
                @if (_monthlySpending.Count > 0)
                {
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.h6" Class="mb-3">@L["CatUsageDlg_MonthlyActivity"]</MudText>
                        
                        <!-- Use MudBlazor chart -->
                        <MudChart ChartType="ChartType.Bar" 
                                  ChartSeries="@_chartSeries" 
                                  XAxisLabels="@_chartLabels"
                                  Width="100%" 
                                  Height="300px"
                                  ChartOptions="@_chartOptions" />

                        <!-- Monthly data table -->
                        <MudTable Items="@_monthlySpending" 
                                  Dense="true" 
                                  Hover="true" 
                                  Class="mt-4">
                            <HeaderContent>
                                <MudTh>@L["Col_Month"]</MudTh>
                                <MudTh Style="text-align: right;">@L["CatUsageDlg_Income"]</MudTh>
                                <MudTh Style="text-align: right;">@L["CatUsageDlg_Expenses"]</MudTh>
                                <MudTh Style="text-align: right;">@L["CatUsageDlg_Net"]</MudTh>
                                <MudTh Style="text-align: right;">@L["Col_Transactions"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@(new DateTime(context.Year, context.Month, 1).ToString("MMM yyyy"))</MudTd>
                                <MudTd Style="text-align: right;">
                                    <MudText Color="Color.Success">@CurrencyFormattingService.FormatCurrency(context.Income, _userSettings?.CurrencyCode ?? "USD")</MudText>
                                </MudTd>
                                <MudTd Style="text-align: right;">
                                    <MudText Color="Color.Error">@CurrencyFormattingService.FormatCurrency(context.Expense, _userSettings?.CurrencyCode ?? "USD")</MudText>
                                </MudTd>
                                <MudTd Style="text-align: right;">
                                    <MudText Color="@(context.Net >= 0 ? Color.Success : Color.Error)">
                                        @CurrencyFormattingService.FormatCurrency(context.Net, _userSettings?.CurrencyCode ?? "USD")
                                    </MudText>
                                </MudTd>
                                <MudTd Style="text-align: right;">@context.TransactionCount</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                }

                <!-- Recent Transactions -->
                @if (_transactions.Count > 0)
                {
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.h6" Class="mb-3">@L["CatUsageDlg_RecentTransactions"]</MudText>
                        <MudTable Items="@_transactions" 
                                  Dense="true" 
                                  Hover="true"
                                  FixedHeader="true"
                                  Height="400px">
                            <HeaderContent>
                                <MudTh>@L["Col_Date"]</MudTh>
                                <MudTh>@L["Col_Account"]</MudTh>
                                <MudTh>@L["Col_Payee"]</MudTh>
                                <MudTh>@L["Col_Memo"]</MudTh>
                                <MudTh Style="text-align: right;">@L["Col_Amount"]</MudTh>
                                <MudTh>@L["Col_Status"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Date.ToString("MM/dd/yyyy")</MudTd>
                                <MudTd>@context.Account?.Name</MudTd>
                                <MudTd>@(context.Payee?.Name ?? "—")</MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @(context.Memo ?? "—")
                                    </MudText>
                                </MudTd>
                                <MudTd Style="text-align: right;">
                                    <MudText Color="@(context.Amount >= 0 ? Color.Success : Color.Error)">
                                        @CurrencyFormattingService.FormatCurrency(context.Amount, _userSettings?.CurrencyCode ?? "USD")
                                    </MudText>
                                </MudTd>
                                <MudTd>
                                    @if (context.IsReconciled)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@L["Status_Reconciled"]</MudChip>
                                    }
                                    else if (context.IsCleared)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@L["Status_Cleared"]</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Status</MudChip>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                }
                else if (_stats.TransactionCount + _stats.SplitCount == 0)
                {
                    <MudAlert Severity="Severity.Info">
                        @L["CatUsageDlg_NotUsedYet"]
                    </MudAlert>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@L["Btn_Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public Category Category { get; set; } = null!;
    [Parameter] public string UserId { get; set; } = string.Empty;

    private CategoryUsageStats _stats = new();
    private List<Transaction> _transactions = [];
    private List<MonthlySpending> _monthlySpending = [];
    private bool _isLoading = true;
    private string? _errorMessage;
    private UserSettings? _userSettings;

    // Chart data
    private List<ChartSeries> _chartSeries = [];
    private string[] _chartLabels = Array.Empty<string>();
    private ChartOptions _chartOptions = new()
    {
        YAxisTicks = 5,
        YAxisFormat = "C0",
        InterpolationOption = InterpolationOption.NaturalSpline
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(UserId))
            {
                _userSettings = await SettingsService.GetSettingsAsync(UserId);
            }

            // Load statistics
            _stats = await CategoryService.GetCategoryUsageStatsAsync(Category.Id, UserId);

            // Load transactions
            _transactions = await CategoryService.GetTransactionsByCategoryAsync(Category.Id, UserId);

            // Load monthly spending
            _monthlySpending = await CategoryService.GetMonthlySpendingAsync(Category.Id, UserId, monthsBack: 12);

            // Prepare chart data
            PrepareChartData();
        }
        catch (Exception ex)
        {
            _errorMessage = string.Format(L["CatUsageDlg_LoadError"], ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void PrepareChartData()
    {
        if (_monthlySpending.Count == 0)
            return;

        // Reverse for chronological order
        var orderedData = _monthlySpending.OrderBy(m => m.Year).ThenBy(m => m.Month).ToList();

        _chartLabels = orderedData.Select(m => new DateTime(m.Year, m.Month, 1).ToString("MMM yy")).ToArray();

        _chartSeries = new List<ChartSeries>
        {
            new ChartSeries
            {
                Name = L["CatUsageDlg_Income"],
                Data = orderedData.Select(m => (double)m.Income).ToArray()
            },
            new ChartSeries
            {
                Name = L["CatUsageDlg_Expenses"],
                Data = orderedData.Select(m => (double)m.Expense).ToArray()
            }
        };
    }

    private void Close()
    {
        MudDialog.Close();
    }
}
