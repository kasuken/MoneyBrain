@using Microsoft.AspNetCore.Components
@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Application.Transactions
@using MoneyBrain.Web.Application.Transactions.Transfers
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@using MudBlazor
@inject ITransferService TransferService
@inject IAccountService AccountService
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mb-text-muted);">
                @L["TransferDlg_Description"]
            </MudText>

            <MudSelect T="int" @bind-Value="_fromAccountId" Label="@L["TransferDlg_FromAccount"]" Required="true"
                       HelperText="@L["TransferDlg_FromAccountHelper"]">
                @foreach (var account in _accounts)
                {
                    <MudSelectItem @key="account.Id" T="int" Value="@account.Id">@account.Name (@account.Type)</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int" @bind-Value="_toAccountId" Label="@L["TransferDlg_ToAccount"]" Required="true"
                       HelperText="@L["TransferDlg_ToAccountHelper"]">
                @foreach (var account in _accounts)
                {
                    <MudSelectItem @key="account.Id" T="int" Value="@account.Id">@account.Name (@account.Type)</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker @bind-Date="_date" Label="@L["Col_Date"]" Required="true" MaxDate="DateTime.Today.AddDays(30)" />

            <MudNumericField @bind-Value="_amount" Label="@L["Col_Amount"]" Required="true" Format="F2"
                             Adornment="Adornment.Start" AdornmentText="$"
                             HelperText="@L["TransferDlg_AmountHelper"]"
                             Min="0.01M" />

            <MudTextField @bind-Value="_memo" Label="@L["Col_Memo"]" Lines="2" 
                          HelperText="@L["TransferDlg_MemoHelper"]" />

            <MudTextField @bind-Value="_referenceNumber" Label="@L["TransferDlg_Reference"]" 
                          HelperText="@L["TransferDlg_ReferenceHelper"]" />

            <MudSwitch @bind-Value="_isCleared" Color="MudBlazor.Color.Success">
                @L["TransferDlg_MarkCleared"]
            </MudSwitch>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Submit" Disabled="@(!_isValid)">
            @(IsNew ? L["TransferDlg_CreateButton"] : L["TransferDlg_UpdateButton"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string? UserId { get; set; }
    [Parameter] public TransferResult? Transfer { get; set; }
    [Parameter] public bool IsNew { get; set; } = true;

    private MudForm _form = null!;
    private bool _isValid;
    private string? _errorMessage;

    private List<Account> _accounts = [];

    private int _fromAccountId;
    private int _toAccountId;
    private DateTime? _date = DateTime.Today;
    private decimal _amount;
    private string? _memo;
    private string? _referenceNumber;
    private bool _isCleared;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId))
            return;

        // Load accounts
        _accounts = (await AccountService.GetUserAccountsAsync(UserId))
            .Where(a => a.IsActive)
            .OrderBy(a => a.Name)
            .ToList();

        // If editing existing transfer
        if (!IsNew && Transfer != null)
        {
            _fromAccountId = Transfer.FromAccountId;
            _toAccountId = Transfer.ToAccountId;
            _date = Transfer.Date;
            _amount = Transfer.Amount;
            _memo = Transfer.Memo;
            _referenceNumber = Transfer.FromTransaction.ReferenceNumber;
            _isCleared = Transfer.FromTransaction.IsCleared;
        }
        else if (_accounts.Count >= 2)
        {
            _fromAccountId = _accounts[0].Id;
            _toAccountId = _accounts[1].Id;
        }
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (!_isValid)
            return;

        _errorMessage = null;

        if (_fromAccountId == _toAccountId)
        {
            _errorMessage = L["TransferDlg_SameAccountError"];
            return;
        }

        if (_amount <= 0)
        {
            _errorMessage = L["TransferDlg_AmountPositiveError"];
            return;
        }

        try
        {
            var transferDto = new TransferDto
            {
                FromAccountId = _fromAccountId,
                ToAccountId = _toAccountId,
                Amount = _amount,
                Date = _date!.Value,
                Memo = _memo,
                ReferenceNumber = _referenceNumber,
                IsCleared = _isCleared
            };

            if (IsNew)
            {
                var result = await TransferService.CreateTransferAsync(UserId!, transferDto);
                MudDialog.Close(DialogResult.Ok(result));
            }
            else if (Transfer != null)
            {
                var updated = await TransferService.UpdateTransferAsync(
                    UserId!,
                    Transfer.FromTransaction.Id,
                    transferDto);
                
                if (updated)
                {
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    _errorMessage = L["TransferDlg_UpdateFailed"];
                }
            }
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = string.Format(L["Msg_Error"], ex.Message);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
