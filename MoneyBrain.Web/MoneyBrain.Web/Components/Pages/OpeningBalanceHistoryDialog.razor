@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center align-center pa-8">
                <MudProgressCircular Indeterminate="true" />
            </div>
        }
        else if (!_adjustments.Any())
        {
            <MudAlert Severity="Severity.Info">
                @L["OpenBalHistDlg_NoHistory"]
            </MudAlert>
        }
        else
        {
            <MudTimeline TimelinePosition="TimelinePosition.Start" TimelineOrientation="TimelineOrientation.Vertical">
                @foreach (var adjustment in _adjustments)
                {
                    <MudTimelineItem Color="@GetTimelineColor(adjustment.AdjustmentAmount)" Size="Size.Small">
                        <ItemOpposite>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @adjustment.AdjustedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                            </MudText>
                        </ItemOpposite>
                        <ItemContent>
                            <MudCard Outlined="true">
                                <MudCardContent Class="py-2">
                                    <div class="d-flex justify-space-between align-center mb-2">
                                        <MudText Typo="Typo.body2" Color="@GetAdjustmentColor(adjustment.AdjustmentAmount)">
                                            @GetAdjustmentText(adjustment.AdjustmentAmount)
                                        </MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@GetChipColor(adjustment.AdjustmentAmount)">
                                            @adjustment.AdjustmentAmount.ToString("C2")
                                        </MudChip>
                                    </div>
                                    <div class="d-flex gap-4 mb-1">
                                        <MudText Typo="Typo.caption">
                                            @L["OpenBalHistDlg_From"]: <strong>@adjustment.PreviousBalance.ToString("C2")</strong>
                                        </MudText>
                                        <MudText Typo="Typo.caption">
                                            @L["OpenBalHistDlg_To"]: <strong>@adjustment.NewBalance.ToString("C2")</strong>
                                        </MudText>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(adjustment.Reason))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            <em>@adjustment.Reason</em>
                                        </MudText>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary">@L["Btn_Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Account Account { get; set; } = default!;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private List<OpeningBalanceAdjustment> _adjustments = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            var adjustments = await AccountService.GetOpeningBalanceAdjustmentsAsync(Account.Id, UserId);
            _adjustments = adjustments.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["OpenBalHistDlg_LoadError"], ex.Message), Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Close()
    {
        MudDialog.Close();
    }

    private MudBlazor.Color GetTimelineColor(decimal amount) => amount switch
    {
        > 0 => MudBlazor.Color.Success,
        < 0 => MudBlazor.Color.Error,
        _ => MudBlazor.Color.Default
    };

    private MudBlazor.Color GetAdjustmentColor(decimal amount) => amount switch
    {
        > 0 => MudBlazor.Color.Success,
        < 0 => MudBlazor.Color.Error,
        _ => MudBlazor.Color.Default
    };

    private MudBlazor.Color GetChipColor(decimal amount) => amount switch
    {
        > 0 => MudBlazor.Color.Success,
        < 0 => MudBlazor.Color.Error,
        _ => MudBlazor.Color.Default
    };

    private string GetAdjustmentText(decimal amount) => amount switch
    {
        > 0 => string.Format(L["OpenBalHistDlg_IncreasedBy"], amount.ToString("C2")),
        < 0 => string.Format(L["OpenBalHistDlg_DecreasedBy"], Math.Abs(amount).ToString("C2")),
        _ => L["OpenBalHistDlg_NoChange"]
    };
}
