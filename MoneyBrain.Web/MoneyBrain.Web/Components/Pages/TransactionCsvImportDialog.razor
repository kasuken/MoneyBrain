@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Application.Settings
@using MoneyBrain.Web.Application.Transactions
@using MoneyBrain.Web.Application.Transactions.CsvImport
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject ITransactionCsvImportService CsvImportService
@inject IAccountService AccountService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@inject ICurrencyFormattingService CurrencyFormattingService
@inject IUserSettingsService SettingsService

<MudDialog>
    <DialogContent>
        @if (_currentStep == ImportStep.Upload)
        {
            <MudText Typo="Typo.h6" Class="mb-4">@L["Import_UploadTitle"]</MudText>
            
            <MudFileUpload T="IBrowserFile" Accept=".csv" FilesChanged="OnFileSelected" MaximumFileCount="1">
                <ActivatorContent>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                        @L["Import_SelectCsvFile"]
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            
            @if (_selectedFile != null)
            {
                <MudText Class="mt-2">@L["Import_Selected"] @_selectedFile.Name (@(_selectedFile.Size / 1024) KB)</MudText>
            }
        }
        else if (_currentStep == ImportStep.Mapping)
        {
            <MudText Typo="Typo.h6" Class="mb-4">@L["Import_MapColumnsTitle"]</MudText>
            
            @if (_csvRows.Count > 0)
            {
                <MudGrid>
                    <MudItem xs="12">
                        <MudCheckBox @bind-Value="_mapping.HasHeaderRow" Label="@L["Import_FirstRowIsHeader"]" Color="Color.Primary" />
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="_mapping.DateColumn" Label="@(L["Import_DateColumn"] + " *")" Variant="Variant.Outlined" Required>
                            <MudSelectItem T="int?" Value="null">@L["Import_SelectColumn"]</MudSelectItem>
                            @for (int i = 0; i < _csvRows[0].Count; i++)
                            {
                                <MudSelectItem T="int?" Value="@i">@L["Import_Column"] @(i + 1): @GetSampleValue(i)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="_mapping.AmountColumn" Label="@(L["Import_AmountColumn"] + " *")" Variant="Variant.Outlined" Required>
                            <MudSelectItem T="int?" Value="null">@L["Import_SelectColumn"]</MudSelectItem>
                            @for (int i = 0; i < _csvRows[0].Count; i++)
                            {
                                <MudSelectItem T="int?" Value="@i">@L["Import_Column"] @(i + 1): @GetSampleValue(i)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="_mapping.PayeeColumn" Label="@L["Import_PayeeColumn"]" Variant="Variant.Outlined">
                            <MudSelectItem T="int?" Value="null">@L["Import_None"]</MudSelectItem>
                            @for (int i = 0; i < _csvRows[0].Count; i++)
                            {
                                <MudSelectItem T="int?" Value="@i">@L["Import_Column"] @(i + 1): @GetSampleValue(i)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="_mapping.CategoryColumn" Label="@L["Import_CategoryColumn"]" Variant="Variant.Outlined">
                            <MudSelectItem T="int?" Value="null">@L["Import_None"]</MudSelectItem>
                            @for (int i = 0; i < _csvRows[0].Count; i++)
                            {
                                <MudSelectItem T="int?" Value="@i">@L["Import_Column"] @(i + 1): @GetSampleValue(i)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="_mapping.MemoColumn" Label="@L["Import_MemoColumn"]" Variant="Variant.Outlined">
                            <MudSelectItem T="int?" Value="null">@L["Import_None"]</MudSelectItem>
                            @for (int i = 0; i < _csvRows[0].Count; i++)
                            {
                                <MudSelectItem T="int?" Value="@i">@L["Import_Column"] @(i + 1): @GetSampleValue(i)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="_mapping.ReferenceNumberColumn" Label="@L["Import_ReferenceColumn"]" Variant="Variant.Outlined">
                            <MudSelectItem T="int?" Value="null">@L["Import_None"]</MudSelectItem>
                            @for (int i = 0; i < _csvRows[0].Count; i++)
                            {
                                <MudSelectItem T="int?" Value="@i">@L["Import_Column"] @(i + 1): @GetSampleValue(i)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int" @bind-Value="_mapping.AccountId" Label="@(L["Import_TargetAccount"] + " *")" Variant="Variant.Outlined" Required>
                            @foreach (var account in _accounts)
                            {
                                <MudSelectItem @key="account.Id" T="int" Value="@account.Id">@account.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_mapping.DateFormat" Label="@L["Import_DateFormat"]" Variant="Variant.Outlined" 
                                      HelperText="@L["Import_DateFormatHelper"]" />
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudCheckBox @bind-Value="_mapping.InvertAmounts" Label="@L["Import_InvertAmounts"]" Color="Color.Primary" />
                    </MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudSelect T="TransactionStatus" @bind-Value="_mapping.DefaultStatus" Label="@L["Import_DefaultStatus"]" Variant="Variant.Outlined">
                            <MudSelectItem T="TransactionStatus" Value="TransactionStatus.Pending">@L["Status_Pending"]</MudSelectItem>
                            <MudSelectItem T="TransactionStatus" Value="TransactionStatus.Posted">@L["Status_Posted"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            }
        }
        else if (_currentStep == ImportStep.Preview)
        {
            <MudText Typo="Typo.h6" Class="mb-4">@L["Import_PreviewTitle"]</MudText>
            
            @if (_previewRows.Count > 0)
            {
                <MudText Class="mb-2">@L["Import_PreviewFirst10Rows"]</MudText>
                
                <MudTable Items="_previewRows.Take(10)" Dense Hover Bordered Striped>
                    <HeaderContent>
                        <MudTh>@L["Import_Row"]</MudTh>
                        <MudTh>@L["Col_Date"]</MudTh>
                        <MudTh>@L["Col_Amount"]</MudTh>
                        <MudTh>@L["Col_Payee"]</MudTh>
                        <MudTh>@L["Col_Category"]</MudTh>
                        <MudTh>@L["Col_Memo"]</MudTh>
                        <MudTh>@L["Col_Status"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["Import_Row"]">@context.RowNumber</MudTd>
                        <MudTd DataLabel="@L["Col_Date"]" Style="@(context.HasErrors && !context.Date.HasValue ? "color: red;" : "")">
                            @(context.Date?.ToString("MM/dd/yyyy") ?? L["Import_ParseError"])
                        </MudTd>
                        <MudTd DataLabel="@L["Col_Amount"]" Style="@(context.HasErrors && !context.Amount.HasValue ? "color: red;" : "")">
                            @(context.Amount.HasValue ? CurrencyFormattingService.FormatCurrency(context.Amount.Value, _userSettings?.CurrencyCode ?? "USD") : L["Import_ParseError"])
                        </MudTd>
                        <MudTd DataLabel="@L["Col_Payee"]">@context.Payee</MudTd>
                        <MudTd DataLabel="@L["Col_Category"]">@context.Category</MudTd>
                        <MudTd DataLabel="@L["Col_Memo"]">@(context.Memo?.Substring(0, Math.Min(30, context.Memo.Length)) ?? "")</MudTd>
                        <MudTd DataLabel="@L["Col_Status"]">
                            @if (context.HasErrors)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">@L["Msg_Error"]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">@L["Btn_Ok"]</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                
                @if (_previewRows.Any(r => r.HasErrors))
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-4">
                        <MudText>@L["Import_SomeRowsHaveErrors"]</MudText>
                        <ul>
                            @foreach (var row in _previewRows.Where(r => r.HasErrors).Take(5))
                            {
                                <li @key="row.RowNumber">@L["Import_Row"] @row.RowNumber: @string.Join(", ", row.Errors)</li>
                            }
                        </ul>
                    </MudAlert>
                }
                
                <MudText Class="mt-4">
                    @L["Import_TotalRows"] @_previewRows.Count | @L["Import_Valid"] @_previewRows.Count(r => !r.HasErrors) | @L["Import_ErrorsSummary"] @_previewRows.Count(r => r.HasErrors)
                </MudText>
            }
        }
        else if (_currentStep == ImportStep.Complete)
        {
            <MudText Typo="Typo.h6" Class="mb-4">@L["Import_CompleteTitle"]</MudText>
            
            @if (_importResult != null)
            {
                <MudAlert Severity="@(_importResult.Success ? Severity.Success : Severity.Warning)">
                    <MudText><strong>@L["Import_ImportedLabel"]</strong> @_importResult.ImportedCount @L["Import_TransactionsUnit"]</MudText>
                    <MudText><strong>@L["Import_SkippedLabel"]</strong> @_importResult.SkippedCount @L["Import_RowsUnit"]</MudText>
                    <MudText><strong>@L["Import_TotalLabel"]</strong> @_importResult.TotalRows @L["Import_RowsProcessed"]</MudText>
                </MudAlert>
                
                @if (_importResult.Errors.Any())
                {
                    <MudText Class="mt-4"><strong>@L["Import_ErrorsLabel"]</strong></MudText>
                    <ul>
                        @foreach (var error in _importResult.Errors.Take(10))
                        {
                            <li @key="error">@error</li>
                        }
                    </ul>
                }
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_currentStep == ImportStep.Upload)
        {
            <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
            <MudButton Color="Color.Primary" OnClick="NextToMapping" Disabled="@(_selectedFile == null)">@L["Btn_Next"]</MudButton>
        }
        else if (_currentStep == ImportStep.Mapping)
        {
            <MudButton OnClick="BackToUpload">@L["Btn_Back"]</MudButton>
            <MudButton Color="Color.Primary" OnClick="NextToPreview" Disabled="@(!_mapping.DateColumn.HasValue || !_mapping.AmountColumn.HasValue || _mapping.AccountId == 0)">
                @L["Btn_Preview"]
            </MudButton>
        }
        else if (_currentStep == ImportStep.Preview)
        {
            <MudButton OnClick="BackToMapping">@L["Btn_Back"]</MudButton>
            <MudButton Color="Color.Primary" OnClick="ImportTransactions" Disabled="_isImporting">
                @if (_isImporting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate />
                    <span class="ml-2">@L["Import_Importing"]</span>
                }
                else
                {
                    <span>@string.Format(L["Import_ImportNTransactions"], _previewRows.Count(r => !r.HasErrors))</span>
                }
            </MudButton>
        }
        else if (_currentStep == ImportStep.Complete)
        {
            <MudButton Color="Color.Primary" OnClick="Close">@L["Btn_Close"]</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string? UserId { get; set; }
    
    private enum ImportStep
    {
        Upload,
        Mapping,
        Preview,
        Complete
    }
    
    private ImportStep _currentStep = ImportStep.Upload;
    private IBrowserFile? _selectedFile;
    private string _csvContent = string.Empty;
    private List<List<string>> _csvRows = new();
    private TransactionCsvColumnMapping _mapping = new();
    private List<TransactionCsvPreviewRow> _previewRows = new();
    private TransactionCsvImportResult? _importResult;
    private List<Account> _accounts = new();
    private bool _isImporting = false;
    private UserSettings? _userSettings;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId))
            return;

        _userSettings = await SettingsService.GetSettingsAsync(UserId);
        _accounts = (await AccountService.GetUserAccountsAsync(UserId)).ToList();
        
        if (_accounts.Count > 0)
        {
            _mapping.AccountId = _accounts[0].Id;
        }
    }

    private async Task OnFileSelected(IBrowserFile? file)
    {
        _selectedFile = file;
        
        if (file != null)
        {
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10 MB max
                using var reader = new StreamReader(stream);
                _csvContent = await reader.ReadToEndAsync();
                
                _csvRows = await CsvImportService.ParseCsvAsync(_csvContent);
                
                if (_csvRows.Count == 0)
                {
                    Snackbar.Add(L["Import_CsvFileEmpty"], Severity.Warning);
                    _selectedFile = null;
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(L["Import_ErrorReadingFile"], ex.Message), Severity.Error);
                _selectedFile = null;
            }
        }
    }

    private void NextToMapping()
    {
        if (_selectedFile == null || _csvRows.Count == 0)
            return;
            
        // Try to auto-detect columns based on header row
        if (_csvRows.Count > 0 && _mapping.HasHeaderRow)
        {
            var headers = _csvRows[0];
            for (int i = 0; i < headers.Count; i++)
            {
                var header = headers[i].ToLower();
                if (header.Contains("date") && !_mapping.DateColumn.HasValue)
                    _mapping.DateColumn = i;
                else if ((header.Contains("amount") || header.Contains("total")) && !_mapping.AmountColumn.HasValue)
                    _mapping.AmountColumn = i;
                else if ((header.Contains("payee") || header.Contains("merchant") || header.Contains("description")) && !_mapping.PayeeColumn.HasValue)
                    _mapping.PayeeColumn = i;
                else if (header.Contains("category") && !_mapping.CategoryColumn.HasValue)
                    _mapping.CategoryColumn = i;
                else if ((header.Contains("memo") || header.Contains("note")) && !_mapping.MemoColumn.HasValue)
                    _mapping.MemoColumn = i;
                else if ((header.Contains("reference") || header.Contains("check")) && !_mapping.ReferenceNumberColumn.HasValue)
                    _mapping.ReferenceNumberColumn = i;
            }
        }
        
        _currentStep = ImportStep.Mapping;
    }

    private void BackToUpload()
    {
        _currentStep = ImportStep.Upload;
    }

    private async Task NextToPreview()
    {
        if (!_mapping.DateColumn.HasValue || !_mapping.AmountColumn.HasValue || _mapping.AccountId == 0)
            return;
            
        try
        {
            _previewRows = await CsvImportService.PreviewImportAsync(UserId!, _csvContent, _mapping);
            _currentStep = ImportStep.Preview;
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["Import_ErrorGeneratingPreview"], ex.Message), Severity.Error);
        }
    }

    private void BackToMapping()
    {
        _currentStep = ImportStep.Mapping;
    }

    private async Task ImportTransactions()
    {
        _isImporting = true;
        
        try
        {
            _importResult = await CsvImportService.ImportTransactionsAsync(UserId!, _csvContent, _mapping);
            
            if (_importResult.Success || _importResult.ImportedCount > 0)
            {
                Snackbar.Add(string.Format(L["Trans_ImportedCount"], _importResult.ImportedCount), Severity.Success);
            }
            
            if (_importResult.Errors.Any())
            {
                Snackbar.Add(string.Format(L["Import_RowsSkippedDueToErrors"], _importResult.SkippedCount), Severity.Warning);
            }
            
            _currentStep = ImportStep.Complete;
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["Import_ErrorImporting"], ex.Message), Severity.Error);
        }
        finally
        {
            _isImporting = false;
        }
    }

    private string GetSampleValue(int columnIndex)
    {
        var sampleRow = _mapping.HasHeaderRow && _csvRows.Count > 1 ? _csvRows[1] : _csvRows[0];
        if (columnIndex < sampleRow.Count)
        {
            var value = sampleRow[columnIndex];
            return value.Length > 20 ? value.Substring(0, 20) + "..." : value;
        }
        return "";
    }

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(_importResult?.ImportedCount ?? 0));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
