@page "/net-worth"
@using Microsoft.AspNetCore.Authorization
@using MoneyBrain.Web.Application.Reporting.NetWorth
@using MoneyBrain.Web.Application.Reporting.CsvExport
@using Microsoft.JSInterop
@using MudBlazor
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Resources
@attribute [Authorize]
@inject INetWorthService NetWorthService
@inject ICsvExportService CsvExportService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SharedResource> L
@inject ICurrencyFormattingService CurrencyFormattingService
@inject IUserSettingsService SettingsService

<PageTitle>@L["NetWorth_PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@L["NetWorth_Header"]</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="@L["Lbl_StartDate"]" 
                               @bind-Date="_startDate" 
                               @bind-Date:after="LoadDataAsync"
                               PickerVariant="PickerVariant.Dialog"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="@L["Lbl_EndDate"]" 
                               @bind-Date="_endDate"
                               @bind-Date:after="LoadDataAsync"
                               PickerVariant="PickerVariant.Dialog"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudNumericField Label="@L["NetWorth_IntervalDays"]" 
                                 @bind-Value="_intervalDays"
                                 @bind-Value:after="LoadDataAsync"
                                 Min="1"
                                 Max="365"
                                 Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="ExportToCsv"
                           Disabled="@(_history == null)"
                           FullWidth="true">
                    @L["NetWorth_ExportToCsv"]
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_history != null)
    {
        <!-- Summary Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.body2" Color="Color.Default">@L["NetWorth_CurrentNetWorth"]</MudText>
                    <MudText Typo="Typo.h5" Color="@(_history.CurrentNetWorth >= 0 ? Color.Success : Color.Error)">
                        @CurrencyFormattingService.FormatCurrency(_history.CurrentNetWorth, _userSettings?.CurrencyCode ?? "USD")
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.body2" Color="Color.Default">@L["NetWorth_TotalAssets"]</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary">@CurrencyFormattingService.FormatCurrency(_history.CurrentTotalAssets, _userSettings?.CurrencyCode ?? "USD")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.body2" Color="Color.Default">@L["NetWorth_TotalLiabilities"]</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Secondary">@CurrencyFormattingService.FormatCurrency(_history.CurrentTotalLiabilities, _userSettings?.CurrencyCode ?? "USD")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.body2" Color="Color.Default">@L["NetWorth_ChangeOverPeriod"]</MudText>
                    <MudText Typo="Typo.h5" Color="@(_history.TotalChange >= 0 ? Color.Success : Color.Error)">
                        @CurrencyFormattingService.FormatCurrency(_history.TotalChange, _userSettings?.CurrencyCode ?? "USD")
                        <MudChip T="string" Size="Size.Small" Color="@(_history.TotalChange >= 0 ? Color.Success : Color.Error)">
                            @(_history.TotalChange >= 0 ? "+" : "")@_history.PercentageChange.ToString("F1")%
                        </MudChip>
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Peak and Low Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Default">@L["NetWorth_PeakNetWorth"]</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Success">
                        @CurrencyFormattingService.FormatCurrency(_history.PeakNetWorth, _userSettings?.CurrencyCode ?? "USD")
                    </MudText>
                    @if (_history.PeakDate.HasValue)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">
                            on @_history.PeakDate.Value.ToString("MMM dd, yyyy")
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Default">@L["NetWorth_LowestNetWorth"]</MudText>
                    <MudText Typo="Typo.h6" Color="@(_history.LowestNetWorth >= 0 ? Color.Info : Color.Error)">
                        @CurrencyFormattingService.FormatCurrency(_history.LowestNetWorth, _userSettings?.CurrencyCode ?? "USD")
                    </MudText>
                    @if (_history.LowestDate.HasValue)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">
                            on @_history.LowestDate.Value.ToString("MMM dd, yyyy")
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Net Worth Trend Chart -->
        @if (_chartData.Any())
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-4">@L["NetWorth_TrendChart"]</MudText>
                <MudChart ChartType="ChartType.Line" 
                          ChartSeries="_chartSeries" 
                          XAxisLabels="_chartData.Select(d => d.DateDisplay).ToArray()"
                          Width="100%" 
                          Height="400px"
                          ChartOptions="_chartOptions" />
            </MudPaper>
        }

        <!-- Snapshot Details Table -->
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-4">@L["NetWorth_SnapshotDetails"]</MudText>
            <MudTable Items="_history.Snapshots" 
                      Hover="true" 
                      Dense="true"
                      FixedHeader="true"
                      Height="600px">
                <HeaderContent>
                    <MudTh>@L["Col_Date"]</MudTh>
                    <MudTh Style="text-align: right;">@L["NetWorth_Assets"]</MudTh>
                    <MudTh Style="text-align: right;">@L["NetWorth_Liabilities"]</MudTh>
                    <MudTh Style="text-align: right;">@L["NetWorth_NetWorth"]</MudTh>
                    <MudTh Style="text-align: right;">@L["NetWorth_Change"]</MudTh>
                    <MudTh Style="text-align: center;">@L["Lbl_Details"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Col_Date"]">@context.DateDisplay</MudTd>
                    <MudTd DataLabel="@L["NetWorth_Assets"]" Style="text-align: right;">@CurrencyFormattingService.FormatCurrency(context.TotalAssets, _userSettings?.CurrencyCode ?? "USD")</MudTd>
                    <MudTd DataLabel="@L["NetWorth_Liabilities"]" Style="text-align: right;">@CurrencyFormattingService.FormatCurrency(context.TotalLiabilities, _userSettings?.CurrencyCode ?? "USD")</MudTd>
                    <MudTd DataLabel="@L["NetWorth_NetWorth"]" Style="text-align: right;">
                        <span style="color: @(context.NetWorth >= 0 ? "green" : "red")">
                            @CurrencyFormattingService.FormatCurrency(context.NetWorth, _userSettings?.CurrencyCode ?? "USD")
                        </span>
                    </MudTd>
                    <MudTd DataLabel="@L["NetWorth_Change"]" Style="text-align: right;">
                        @if (context.ChangeFromPrevious.HasValue)
                        {
                            <span style="color: @(context.ChangeFromPrevious.Value >= 0 ? "green" : "red")">
                                @(context.ChangeFromPrevious.Value >= 0 ? "+" : "")@CurrencyFormattingService.FormatCurrency(context.ChangeFromPrevious.Value, _userSettings?.CurrencyCode ?? "USD")
                                (@(context.PercentageChange >= 0 ? "+" : "")@context.PercentageChange?.ToString("F1")%)
                            </span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["Lbl_Details"]" Style="text-align: center;">
                        <MudIconButton Icon="@(_expandedSnapshots.Contains(context) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" 
                                       OnClick="@(() => ToggleSnapshotExpansion(context))"
                                       Size="Size.Small" />
                    </MudTd>
                </RowTemplate>
                <ChildRowContent>
                    @if (_expandedSnapshots.Contains(context))
                    {
                        <MudTr>
                            <td colspan="6">
                                <MudCard Elevation="0" Class="my-2">
                                    <MudCardContent>
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                                            @L["NetWorth_AccountBalances"] - @context.DateDisplay
                                        </MudText>
                                        
                                        @if (context.AccountBalances.Any())
                                        {
                                            <MudGrid>
                                                <MudItem xs="12" md="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">@L["NetWorth_Assets"]</MudText>
                                                    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                                                        <thead>
                                                            <tr>
                                                                <th>@L["Col_Account"]</th>
                                                                <th style="text-align: right;">@L["Col_Balance"]</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var account in context.AccountBalances.Where(a => a.AccountType == "Asset"))
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        @account.AccountName
                                                                        @if (!account.IsActive)
                                                                        {
                                                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@L["Status_Inactive"]</MudChip>
                                                                        }
                                                                    </td>
                                                                    <td style="text-align: right;">@CurrencyFormattingService.FormatCurrency(account.Balance, _userSettings?.CurrencyCode ?? "USD")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </MudSimpleTable>
                                                </MudItem>
                                                <MudItem xs="12" md="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">@L["NetWorth_Liabilities"]</MudText>
                                                    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                                                        <thead>
                                                            <tr>
                                                                <th>@L["Col_Account"]</th>
                                                                <th style="text-align: right;">@L["Col_Balance"]</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var account in context.AccountBalances.Where(a => a.AccountType == "Liability"))
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        @account.AccountName
                                                                        @if (!account.IsActive)
                                                                        {
                                                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@L["Status_Inactive"]</MudChip>
                                                                        }
                                                                    </td>
                                                                    <td style="text-align: right;">@CurrencyFormattingService.FormatCurrency(account.Balance, _userSettings?.CurrencyCode ?? "USD")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </MudSimpleTable>
                                                </MudItem>
                                            </MudGrid>
                                        }
                                        else
                                        {
                                            <MudAlert Severity="Severity.Info" Dense="true">
                                                @L["NetWorth_NoAccountsFound"]
                                            </MudAlert>
                                        }
                                    </MudCardContent>
                                </MudCard>
                            </td>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            @L["NetWorth_SelectDateRange"]
        </MudAlert>
    }
    
    <HelpButton Title="@L["NetWorth_HelpTitle"]"
                Description="@L["NetWorth_HelpDescription"]"
                Features="@(new[] { 
                    L["NetWorth_HelpFeature1"].Value,
                    L["NetWorth_HelpFeature2"].Value,
                    L["NetWorth_HelpFeature3"].Value,
                    L["NetWorth_HelpFeature4"].Value,
                    L["NetWorth_HelpFeature5"].Value
                })"
                HowToUse="@(new[] {
                    L["NetWorth_HelpHowTo1"].Value,
                    L["NetWorth_HelpHowTo2"].Value,
                    L["NetWorth_HelpHowTo3"].Value,
                    L["NetWorth_HelpHowTo4"].Value,
                    L["NetWorth_HelpHowTo5"].Value
                })"
                Tips="@(new[] {
                    L["NetWorth_HelpTip1"].Value,
                    L["NetWorth_HelpTip2"].Value,
                    L["NetWorth_HelpTip3"].Value,
                    L["NetWorth_HelpTip4"].Value
                })" />
</MudContainer>

@code {
    private DateTime? _startDate = DateTime.Now.AddMonths(-12);
    private DateTime? _endDate = DateTime.Now;
    private int _intervalDays = 30;
    private bool _loading = true;
    private NetWorthHistoryDto? _history;
    private List<NetWorthSnapshotDto> _chartData = [];
    private HashSet<NetWorthSnapshotDto> _expandedSnapshots = [];
    private UserSettings? _userSettings;

    private List<ChartSeries> _chartSeries = [];
    private ChartOptions _chartOptions = new()
    {
        YAxisTicks = 1000,
        YAxisFormat = "C0",
        InterpolationOption = InterpolationOption.Straight,
        LineStrokeWidth = 3
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (!string.IsNullOrEmpty(userId))
        {
            _userSettings = await SettingsService.GetSettingsAsync(userId);
        }
        
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if (_startDate == null || _endDate == null)
            return;

        _loading = true;
        StateHasChanged();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
                return;

            _history = await NetWorthService.GetNetWorthHistoryAsync(
                userId, 
                _startDate.Value, 
                _endDate.Value,
                _intervalDays);

            PrepareChartData();
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrepareChartData()
    {
        if (_history == null)
            return;

        _chartData = _history.Snapshots
            .OrderBy(s => s.Date)
            .ToList();

        _chartSeries =
        [
            new ChartSeries
            {
                Name = L["NetWorth_NetWorth"],
                Data = _chartData.Select(d => (double)d.NetWorth).ToArray()
            },
            new ChartSeries
            {
                Name = L["NetWorth_Assets"],
                Data = _chartData.Select(d => (double)d.TotalAssets).ToArray()
            },
            new ChartSeries
            {
                Name = L["NetWorth_Liabilities"],
                Data = _chartData.Select(d => (double)d.TotalLiabilities).ToArray()
            }
        ];
    }

    private void ToggleSnapshotExpansion(NetWorthSnapshotDto snapshot)
    {
        if (_expandedSnapshots.Contains(snapshot))
            _expandedSnapshots.Remove(snapshot);
        else
            _expandedSnapshots.Add(snapshot);
    }

    private async Task ExportToCsv()
    {
        if (_history == null)
            return;

        var csvBytes = CsvExportService.ExportNetWorthToCsv(_history);
        var fileName = $"net_worth_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
        var base64 = Convert.ToBase64String(csvBytes);
        
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64);
    }
}
