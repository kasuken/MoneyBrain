@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_newName" 
                      Label="@L["PayeeDlg_PayeeName"]" 
                      Variant="Variant.Outlined"
                      Required
                      HelperText="@L["PayeeDlg_EnterNewName"]" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Confirm" Disabled="@string.IsNullOrWhiteSpace(_newName)">
            @L["PayeeDlg_Rename"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public int PayeeId { get; set; }
    [Parameter] public string CurrentName { get; set; } = string.Empty;

    private string _newName = string.Empty;

    protected override void OnInitialized()
    {
        _newName = CurrentName;
    }

    private void Confirm()
    {
        if (!string.IsNullOrWhiteSpace(_newName))
        {
            MudDialog.Close(DialogResult.Ok(_newName));
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
