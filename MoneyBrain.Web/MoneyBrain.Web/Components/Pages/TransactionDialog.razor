@using Microsoft.AspNetCore.Components
@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Application.Transactions
@using MoneyBrain.Web.Application.Transactions.Splits
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@using MudBlazor
@inject ITransactionService TransactionService
@inject IAccountService AccountService
@inject ICategoryService CategoryService
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L

<MudDialog @bind-IsVisible="_isVisible" Options="@(FullScreen ? _fullScreenOptions : _defaultOptions)">
    <DialogContent>
        @if (!IsNew && Transaction?.IsReconciled == true)
        {
            <MudAlert Severity="MudBlazor.Severity.Warning" Class="mb-4" Icon="@Icons.Material.Filled.Lock">
                <strong>@L["TxnDlg_ReconciledWarningTitle"]</strong><br/>
                @L["TxnDlg_ReconciledWarningDetails"]
            </MudAlert>
        }
        
        @if (IsNew && _accounts.FirstOrDefault(a => a.Id == _selectedAccountId)?.SubType == AccountSubType.CreditCard)
        {
            <MudAlert Severity="MudBlazor.Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.CreditCard">
                <strong>@L["TxnDlg_CreditCardTitle"]</strong><br/>
                @((MarkupString)L["TxnDlg_CreditCardInfo"].ToString())
            </MudAlert>
        }
        
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudSelect T="int" Value="_selectedAccountId" ValueChanged="@OnAccountChanged" Label="@L["Col_Account"]" Required="true" Disabled="@(!IsNew && Transaction?.IsReconciled == true)">
                @foreach (var account in _accounts)
                {
                    <MudSelectItem T="int" Value="@account.Id">@account.Name</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker @bind-Date="_date" Label="@L["Col_Date"]" Required="true" MaxDate="DateTime.Today.AddDays(30)" Disabled="@(!IsNew && Transaction?.IsReconciled == true)" />

            <MudNumericField @bind-Value="_amount" Label="@L["Col_Amount"]" Required="true" Format="F2"
                             Adornment="Adornment.Start" AdornmentText="$"
                             HelperText="@L["TxnDlg_AmountHelper"]" 
                             Disabled="@(!IsNew && Transaction?.IsReconciled == true)" />

            <MudAutocomplete T="string" @bind-Value="_payeeName" Label="@L["Col_Payee"]"
                             SearchFunc="@SearchPayees" Clearable="true" 
                             Disabled="@(!IsNew && Transaction?.IsReconciled == true)" />

            <MudSwitch @bind-Value="_useSplits" Color="MudBlazor.Color.Primary" Class="my-2" Disabled="@(!IsNew && Transaction?.IsReconciled == true)">@L["TxnDlg_SplitCategories"]</MudSwitch>

            @if (_useSplits)
            {
                <TransactionSplitEditor Splits="@_splits" 
                                       TransactionAmount="@_amount" 
                                       UserId="@UserId" 
                                       OnSplitsChanged="@OnSplitsChanged" />
            }
            else
            {
                <MudSelect T="int?" @bind-Value="_selectedCategoryId" Label="@L["Col_Category"]" Clearable="true" Disabled="@(!IsNew && Transaction?.IsReconciled == true)">
                    @foreach (var group in _categoryGroups)
                    {
                        <MudSelectItem T="int?" Value="@((int?)null)" Disabled="true">
                            <strong>@group.Name</strong>
                        </MudSelectItem>
                        @foreach (var category in group.Categories)
                        {
                            <MudSelectItem T="int?" Value="@category.Id">&nbsp;&nbsp;@category.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            }

            <MudTextField @bind-Value="_memo" Label="@L["Col_Memo"]" Lines="2" Disabled="@(!IsNew && Transaction?.IsReconciled == true)" />

            <MudTextField @bind-Value="_referenceNumber" Label="@L["TxnDlg_Reference"]" HelperText="@L["TxnDlg_ReferenceHelper"]" Disabled="@(!IsNew && Transaction?.IsReconciled == true)" />

            <MudSwitch @bind-Value="_isCleared" Color="MudBlazor.Color.Success" Disabled="@(!IsNew && Transaction?.IsReconciled == true)">@L["Status_Cleared"]</MudSwitch>

            <MudSelect T="TransactionStatus" @bind-Value="_status" Label="@L["Col_Status"]" Disabled="@(!IsNew && Transaction?.IsReconciled == true)">
                <MudSelectItem T="TransactionStatus" Value="@TransactionStatus.Pending">@L["Status_Pending"]</MudSelectItem>
                <MudSelectItem T="TransactionStatus" Value="@TransactionStatus.Posted">@L["Status_Posted"]</MudSelectItem>
            </MudSelect>
            
            <MudDivider Class="my-4" />
            
            <MudSwitch @bind-Value="_isRecurring" Color="MudBlazor.Color.Primary" Disabled="@(!IsNew && Transaction?.IsReconciled == true)">
                @L["TxnDlg_MakeRecurring"]
            </MudSwitch>
            
            @if (_isRecurring)
            {
                <MudSelect T="RecurrenceFrequency?" @bind-Value="_recurrenceFrequency" Label="@L["TxnDlg_RepeatEvery"]" Required="true" Disabled="@(!IsNew && Transaction?.IsReconciled == true)">
                    <MudSelectItem T="RecurrenceFrequency?" Value="@RecurrenceFrequency.Weekly">@L["TxnDlg_Weekly"]</MudSelectItem>
                    <MudSelectItem T="RecurrenceFrequency?" Value="@RecurrenceFrequency.Monthly">@L["TxnDlg_Monthly"]</MudSelectItem>
                    <MudSelectItem T="RecurrenceFrequency?" Value="@RecurrenceFrequency.Quarterly">@L["TxnDlg_Quarterly"]</MudSelectItem>
                    <MudSelectItem T="RecurrenceFrequency?" Value="@RecurrenceFrequency.SixMonths">@L["TxnDlg_SemiAnnually"]</MudSelectItem>
                    <MudSelectItem T="RecurrenceFrequency?" Value="@RecurrenceFrequency.Yearly">@L["TxnDlg_Yearly"]</MudSelectItem>
                </MudSelect>
                
                <MudDatePicker @bind-Date="_recurrenceStartDate" Label="@L["TxnDlg_FirstOccurrence"]" Required="true" Disabled="@(!IsNew && Transaction?.IsReconciled == true)"
                               HelperText="@L["TxnDlg_FirstOccurrenceHelper"]" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@((!IsNew && Transaction?.IsReconciled == true) ? L["Btn_Close"] : L["Btn_Cancel"])</MudButton>
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="Submit" Disabled="@(!_isValid || (!IsNew && Transaction?.IsReconciled == true))">
            @(IsNew ? L["Btn_Create"] : L["Btn_Update"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string? UserId { get; set; }
    [Parameter] public Transaction? Transaction { get; set; }
    [Parameter] public bool IsNew { get; set; } = true;
    [Parameter] public int? PreselectedAccountId { get; set; }
    [Parameter] public bool FullScreen { get; set; } = false;

    private MudForm _form = null!;
    private bool _isValid;

    private List<Account> _accounts = [];
    private List<CategoryGroup> _categoryGroups = [];
    private List<string> _payeeNames = [];

    private int _selectedAccountId;
    private DateTime? _date = DateTime.Today;
    private decimal _amount;
    private string? _payeeName;
    private int? _selectedCategoryId;
    private string? _memo;
    private string? _referenceNumber;
    private bool _isCleared;
    private TransactionStatus _status = TransactionStatus.Posted;
    private bool _useSplits;
    private List<TransactionSplitDto> _splits = [];
    private bool _isRecurring;
    private RecurrenceFrequency? _recurrenceFrequency;
    private DateTime? _recurrenceStartDate;
    private bool _isVisible = true;
    
    private DialogOptions _fullScreenOptions = new() { FullScreen = true, CloseButton = true };
    private DialogOptions _defaultOptions = new() { CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId))
            return;

        // Load accounts
        _accounts = (await AccountService.GetUserAccountsAsync(UserId)).ToList();

        // Load categories with groups
        _categoryGroups = await CategoryService.GetCategoryGroupsAsync(UserId, includeCategories: true);

        // Load payees for autocomplete
        var payees = await TransactionService.GetPayeesAsync(UserId);
        _payeeNames = payees.Select(p => p.Name).ToList();

        // If editing existing transaction
        if (!IsNew && Transaction != null)
        {
            _selectedAccountId = Transaction.AccountId;
            _date = Transaction.Date;
            _amount = Transaction.Amount;
            _payeeName = Transaction.Payee?.Name;
            _selectedCategoryId = Transaction.CategoryId;
            _memo = Transaction.Memo;
            _isRecurring = Transaction.IsRecurring;
            _recurrenceFrequency = Transaction.RecurrenceFrequency;
            _recurrenceStartDate = Transaction.RecurrenceStartDate;
            _referenceNumber = Transaction.ReferenceNumber;
            _isCleared = Transaction.IsCleared;
            _status = Transaction.Status;
            
            // Load splits if they exist
            if (Transaction.Splits?.Any() == true)
            {
                _useSplits = true;
                _splits = Transaction.Splits.Select(s => new TransactionSplitDto
                {
                    Id = s.Id,
                    CategoryId = s.CategoryId,
                    Amount = s.Amount,
                    Memo = s.Memo
                }).ToList();
            }
        }
        else if (PreselectedAccountId.HasValue)
        {
            _selectedAccountId = PreselectedAccountId.Value;
            // Set default status based on account type
            SetDefaultStatusForAccount(_selectedAccountId);
            // Set default category to last used expense category
            await SetDefaultExpenseCategoryAsync();
        }
        else if (_accounts.Any())
        {
            _selectedAccountId = _accounts.First().Id;
            // Set default status based on account type
            SetDefaultStatusForAccount(_selectedAccountId);
            // Set default category to last used expense category
            await SetDefaultExpenseCategoryAsync();
        }
    }

    private async Task SetDefaultExpenseCategoryAsync()
    {
        // Get the most recent transaction for this user
        var recentTransactions = await TransactionService.GetUserTransactionsAsync(UserId!, null, null);
        var lastTransaction = recentTransactions
            .Where(t => t.CategoryId.HasValue && t.Category?.CategoryGroup != null)
            .FirstOrDefault();

        if (lastTransaction?.Category?.CategoryGroup?.Type == CategoryType.Expense)
        {
            _selectedCategoryId = lastTransaction.CategoryId;
        }
    }

    private void SetDefaultStatusForAccount(int accountId)
    {
        var account = _accounts.FirstOrDefault(a => a.Id == accountId);
        if (account != null && account.SubType == AccountSubType.CreditCard)
        {
            // Credit card transactions default to Pending (will be posted on billing cycle day)
            _status = TransactionStatus.Pending;
        }
        else
        {
            // Other accounts default to Posted
            _status = TransactionStatus.Posted;
        }
    }

    private void OnAccountChanged(int newAccountId)
    {
        _selectedAccountId = newAccountId;
        // Update default status when account changes (only for new transactions)
        if (IsNew)
        {
            SetDefaultStatusForAccount(newAccountId);
        }
    }

    private async Task<IEnumerable<string>> SearchPayees(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return _payeeNames.Take(10);

        return _payeeNames
            .Where(p => p.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(10);
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (!_isValid)
            return;

        try
        {
            // Handle payee creation if needed
            int? payeeId = null;
            if (!string.IsNullOrWhiteSpace(_payeeName))
            {
                var payee = await TransactionService.CreateOrGetPayeeAsync(UserId!, _payeeName, _selectedCategoryId);
                payeeId = payee.Id;
            }

            if (IsNew)
            {
                if (_useSplits)
                {
                    await TransactionService.CreateTransactionWithSplitsAsync(
                        UserId!,
                        _selectedAccountId,
                        _date!.Value,
                        _amount,
                        payeeId,
                        _memo,
                        _status,
                        _isCleared,
                        _referenceNumber,
                        null,  // tags
                        _splits);
                }
                else
                {
                    await TransactionService.CreateTransactionAsync(
                        UserId!,
                        _selectedAccountId,
                        _date!.Value,
                        _amount,
                        payeeId,
                        _selectedCategoryId,
                        _memo,
                        _status,
                        _isCleared,
                        _referenceNumber,
                        null,  // tags
                        _isRecurring,
                        _recurrenceFrequency,
                        _recurrenceStartDate);
                }
            }
            else if (Transaction != null)
            {
                if (_useSplits)
                {
                    await TransactionService.UpdateTransactionWithSplitsAsync(
                        Transaction.Id,
                        UserId!,
                        _date!.Value,
                        _amount,
                        payeeId,
                        _memo,
                        _status,
                        _isCleared,
                        _referenceNumber,
                        null,  // tags
                        _splits);
                }
                else
                {
                    await TransactionService.UpdateTransactionAsync(
                        Transaction.Id,
                        UserId!,
                        _date!.Value,
                        _amount,
                        payeeId,
                        _selectedCategoryId,
                        _memo,
                        _status,
                        _isCleared,
                        _referenceNumber,
                        null,  // tags
                        _isRecurring,
                        _recurrenceFrequency,
                        _recurrenceStartDate);
                }
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (InvalidOperationException ex)
        {
            // Show error for reconciled transaction or other validation errors
            await DialogService.ShowMessageBox(
                L["TxnDlg_CannotModifyTitle"],
                ex.Message,
                yesText: L["Btn_OK"]);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private Task OnSplitsChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
