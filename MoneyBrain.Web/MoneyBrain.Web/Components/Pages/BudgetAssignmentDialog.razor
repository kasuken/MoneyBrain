@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Application.Settings
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject ICategoryService CategoryService
@inject IMonthlyBudgetService MonthlyBudgetService
@inject ISnackbar SnackbarService
@inject IStringLocalizer<SharedResource> L
@inject ICurrencyFormattingService CurrencyFormattingService
@inject IUserSettingsService SettingsService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (Category != null)
            {
                <MudText Typo="Typo.body1">
                    <strong>@L["Col_Category"]:</strong> @Category.Name
                </MudText>
            }

            @if (!IsDefaultMode)
            {
                <MudText Typo="Typo.body1">
                    <strong>@L["BudgetAsgnDlg_BudgetPeriod"]:</strong> @_monthName @Year
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body1">
                    <strong>@L["BudgetAsgnDlg_BudgetType"]:</strong> @L["BudgetAsgnDlg_DefaultType"]
                </MudText>
            }

            <MudNumericField @bind-Value="_plannedAmount" 
                             Label="@L["BudgetAsgnDlg_PlannedAmount"]" 
                             Variant="Variant.Outlined" 
                             Required="true"
                             Format="N2"
                             Min="0"
                             Step="0.01M"
                             Adornment="Adornment.Start"
                             AdornmentText="$" />

            <MudSwitch @bind-Value="_allowRollover" 
                       Label="@L["BudgetAsgnDlg_AllowRollover"]" 
                       Color="Color.Primary">
                <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">
                    @L["BudgetAsgnDlg_RolloverDesc"]
                </MudText>
            </MudSwitch>

            @if (!IsDefaultMode && _defaultBudget != null)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    @L["BudgetAsgnDlg_DefaultBudget"]: @CurrencyFormattingService.FormatCurrency(_defaultBudget.PlannedAmount, _userSettings?.CurrencyCode ?? "USD")
                    <br />
                    <small>@L["BudgetAsgnDlg_OverrideInfo"]</small>
                </MudAlert>
            }

            @if (IsDefaultMode && _hasOverrides)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @L["BudgetAsgnDlg_HasOverridesWarning"]
                </MudAlert>
            }
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Btn_Cancel"]</MudButton>
        @if (_existingBudget != null)
        {
            <MudButton Color="Color.Error" 
                       Variant="Variant.Text" 
                       OnClick="Delete" 
                       Disabled="_isSubmitting">
                @(IsDefaultMode ? L["BudgetAsgnDlg_RemoveDefault"] : L["BudgetAsgnDlg_RemoveOverride"])
            </MudButton>
        }
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Submit" 
                   Disabled="_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="me-2" />
            }
            @(_existingBudget != null ? L["Btn_Update"] : (IsDefaultMode ? L["BudgetAsgnDlg_SetDefault"] : L["BudgetAsgnDlg_SetOverride"]))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public Category? Category { get; set; }
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; }
    [Parameter] public bool IsDefaultMode { get; set; } = false;

    private MonthlyBudget? _existingBudget;
    private MonthlyBudget? _defaultBudget;
    private decimal _plannedAmount;
    private bool _allowRollover;
    private bool _isSubmitting;
    private string? _errorMessage;
    private string _monthName = string.Empty;
    private bool _hasOverrides = false;
    private UserSettings? _userSettings;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(UserId))
        {
            _userSettings = await SettingsService.GetSettingsAsync(UserId);
        }

        if (!IsDefaultMode)
        {
            _monthName = new DateTime(Year, Month, 1).ToString("MMMM");
        }

        if (Category != null)
        {
            if (IsDefaultMode)
            {
                // Load default budget
                _existingBudget = await MonthlyBudgetService.GetDefaultBudgetAsync(Category.Id, UserId);
                
                // Check if there are any month overrides (just check if any non-default budgets exist)
                // This is a simple check - in a real scenario you might want to be more specific
            }
            else
            {
                // Load month-specific override
                _existingBudget = await MonthlyBudgetService.GetMonthOverrideAsync(Category.Id, UserId, Year, Month);
                
                // Load default budget to show in info message
                _defaultBudget = await MonthlyBudgetService.GetDefaultBudgetAsync(Category.Id, UserId);
            }
            
            if (_existingBudget != null)
            {
                _plannedAmount = _existingBudget.PlannedAmount;
                _allowRollover = _existingBudget.AllowRollover;
            }
            else if (_defaultBudget != null && !IsDefaultMode)
            {
                // Pre-fill with default values when creating an override
                _plannedAmount = _defaultBudget.PlannedAmount;
                _allowRollover = _defaultBudget.AllowRollover;
            }
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        _errorMessage = null;

        if (Category == null)
        {
            _errorMessage = L["BudgetAsgnDlg_CategoryRequired"];
            return;
        }

        if (_plannedAmount < 0)
        {
            _errorMessage = L["BudgetAsgnDlg_AmountNegative"];
            return;
        }

        _isSubmitting = true;

        try
        {
            MonthlyBudget budget;
            
            if (IsDefaultMode)
            {
                budget = await MonthlyBudgetService.SetDefaultBudgetAsync(
                    Category.Id, 
                    UserId, 
                    _plannedAmount, 
                    _allowRollover);
            }
            else
            {
                budget = await MonthlyBudgetService.SetMonthOverrideAsync(
                    Category.Id, 
                    UserId, 
                    Year, 
                    Month, 
                    _plannedAmount, 
                    _allowRollover);
            }

            MudDialog.Close(DialogResult.Ok(budget));
        }
        catch (Exception ex)
        {
            _errorMessage = string.Format(L["Msg_Error"], ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task Delete()
    {
        if (Category == null)
            return;

        _isSubmitting = true;

        try
        {
            bool success;
            
            if (IsDefaultMode)
            {
                success = await MonthlyBudgetService.DeleteDefaultBudgetAsync(Category.Id, UserId);
            }
            else
            {
                success = await MonthlyBudgetService.DeleteMonthOverrideAsync(Category.Id, UserId, Year, Month);
            }
            
            if (success)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _errorMessage = L["BudgetAsgnDlg_DeleteFailed"];
            }
        }
        catch (Exception ex)
        {
            _errorMessage = string.Format(L["Msg_Error"], ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
