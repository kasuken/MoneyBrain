@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using MoneyBrain.Web.Data
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Manage_PersonalData_PageTitle"]</PageTitle>

<StatusMessage/>
<h3>@L["Manage_PersonalData_Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>@L["Manage_PersonalData_Description"]</p>
        <p>
            <strong>@L["Manage_DeleteData_Warning"]</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken/>
            <button class="btn btn-primary" type="submit">@L["Manage_PersonalData_Download"]</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">@L["Common_Delete"]</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }

}