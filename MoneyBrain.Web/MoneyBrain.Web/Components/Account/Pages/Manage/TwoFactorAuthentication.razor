@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using MoneyBrain.Web.Data
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Manage_2FA_PageTitle"]</PageTitle>

<StatusMessage/>
<h3>@L["Manage_2FA_Title"]</h3>
@if (canTrack)
{
    if (is2faEnabled)
    {
        if (recoveryCodesLeft == 0)
        {
            <div class="alert alert-danger">
                <strong>@L["Manage_2FA_NoRecoveryCodes"]</strong>
                <p>@L["Manage_2FA_GenerateCodesLink1"] <a href="Account/Manage/GenerateRecoveryCodes">@L["Manage_2FA_GenerateCodesLinkText"]</a> @L["Manage_2FA_GenerateCodesLink2"]</p>
            </div>
        }
        else if (recoveryCodesLeft == 1)
        {
            <div class="alert alert-danger">
                <strong>@L["Manage_2FA_OneRecoveryCode"]</strong>
                <p>@L["Manage_2FA_YouCan"] <a href="Account/Manage/GenerateRecoveryCodes">@L["Manage_2FA_GenerateCodesLinkText"]</a>.</p>
            </div>
        }
        else if (recoveryCodesLeft <= 3)
        {
            <div class="alert alert-warning">
                <strong>@(string.Format(L["Manage_2FA_FewRecoveryCodes"], recoveryCodesLeft))</strong>
                <p>@L["Manage_2FA_YouShould"] <a href="Account/Manage/GenerateRecoveryCodes">@L["Manage_2FA_GenerateCodesLinkText"]</a>.</p>
            </div>
        }

        if (isMachineRemembered)
        {
            <form style="display: inline-block" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                <AntiforgeryToken/>
                <button type="submit" class="btn btn-primary">@L["Manage_2FA_ForgetBrowser"]</button>
            </form>
        }

        <a href="Account/Manage/Disable2fa" class="btn btn-primary">@L["Manage_2FA_Disable"]</a>
        <a href="Account/Manage/GenerateRecoveryCodes" class="btn btn-primary">@L["Manage_2FA_ResetCodes"]</a>
    }

    <h4>@L["Manage_2FA_AuthenticatorApp"]</h4>
    @if (!hasAuthenticator)
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">@L["Manage_2FA_AddAuthenticator"]</a>
    }
    else
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">@L["Manage_2FA_SetupAuthenticator"]</a>
        <a href="Account/Manage/ResetAuthenticator" class="btn btn-primary">@L["Manage_2FA_ResetAuthenticator"]</a>
    }
}
else
{
    <div class="alert alert-danger">
        <strong>@L["Manage_2FA_PolicyNotAccepted"]</strong>
        <p>@L["Manage_2FA_PolicyNotAcceptedMessage"]</p>
    </div>
}

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            L["Manage_2FA_BrowserForgotten"],
            HttpContext);
    }

}