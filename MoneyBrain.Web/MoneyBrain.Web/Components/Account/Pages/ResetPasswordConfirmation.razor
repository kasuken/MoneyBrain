@page "/Account/ResetPasswordConfirmation"

@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Auth_ResetPwdConfirm_PageTitle"]</PageTitle>

<h1>@L["Auth_ResetPwdConfirm_Title"]</h1>
<p role="alert">
    @L["Auth_ResetPwdConfirm_Message"] <a href="Account/Login">@L["Auth_ResetPwdConfirm_ClickToLogin"]</a>
</p>