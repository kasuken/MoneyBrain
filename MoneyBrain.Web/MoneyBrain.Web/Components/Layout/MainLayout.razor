﻿@inherits LayoutComponentBase
@using MoneyBrain.Web.Components.Shared
@using MoneyBrain.Web.Services
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject NavigationManager NavigationManager
@inject IMobileDetectionService MobileDetection
@inject IStringLocalizer<SharedResource> L
@inject ILogger<MainLayout> Logger
@implements IAsyncDisposable

@* Required *@
<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="false" Class="px-4">
        @* Mobile hamburger menu button - visible on mobile via CSS, then controlled by JS *@
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                               Color="Color.Inherit" 
                               Edge="Edge.Start" 
                               OnClick="@ToggleDrawer"
                               Class="@(_isMobileInitialized ? (_isMobile ? "" : "d-none") : "d-md-none")" />
            </Authorized>
        </AuthorizeView>
        
        <NavLink href="/" class="mb-logo">
            <img src="/icons/OnlyLogo.png" alt="MoneyBrain" style="max-height: 40px;" />
        </NavLink>

        @* Desktop navigation - hidden on mobile via CSS, then controlled by JS *@
        <AuthorizeView>
            <Authorized>
                <div class="@(_isMobileInitialized ? (_isMobile ? "d-none" : "") : "d-none d-md-block")">
                    <NavMenu />
                </div>
            </Authorized>
        </AuthorizeView>
        
        <MudSpacer />
        
        <LanguageSelector />
        
        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <div class="mb-user-menu">
                            <div class="mb-user-avatar">
                                @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <MudText Typo="Typo.body2" Class="d-none d-md-block" Style="font-weight: 500;">
                                @context.User.Identity?.Name
                            </MudText>
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Href="/settings" Icon="@Icons.Material.Outlined.Settings">@L["Nav_Settings"]</MudMenuItem>
                        <MudMenuItem Href="/license" Icon="@Icons.Material.Outlined.CardMembership">@L["Nav_License"]</MudMenuItem>
                        <MudMenuItem Href="/Account/Manage" Icon="@Icons.Material.Outlined.Person">@L["Nav_Profile"]</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem>
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="/" />
                                <button type="submit" style="background: none; border: none; cursor: pointer; display: flex; align-items: center; gap: 8px; padding: 0; width: 100%;">
                                    <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                                    @L["Nav_SignOut"]
                                </button>
                            </form>
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/Account/Login" Variant="Variant.Text" Color="Color.Default" Class="me-2">
                    @L["Nav_SignIn"]
                </MudButton>
                <MudButton Href="/Account/Register" Variant="Variant.Filled" Class="mb-btn-primary d-none d-md-flex">
                    @L["Nav_GetStarted"]
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    
    @* Mobile drawer for navigation *@
    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" 
                       Elevation="1" 
                       Variant="@DrawerVariant.Temporary"
                       ClipMode="DrawerClipMode.Always">
                <MudDrawerHeader>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <img src="/icons/OnlyLogo.png" alt="MoneyBrain" style="max-height: 32px;" />
                        <MudText Typo="Typo.h6" Style="font-weight: 600;">MoneyBrain</MudText>
                    </MudStack>
                </MudDrawerHeader>
                <MudNavMenu>
                    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_Dashboard"]</MudNavLink>
                    <MudNavLink Href="/transactions" Icon="@Icons.Material.Filled.Receipt" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_Transactions"]</MudNavLink>
                    <MudNavLink Href="/budgets" Icon="@Icons.Material.Filled.PieChart" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_Budgets"]</MudNavLink>
                    <MudNavLink Href="/categories" Icon="@Icons.Material.Filled.Category" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_Categories"]</MudNavLink>
                    <MudNavLink Href="/accounts" Icon="@Icons.Material.Filled.AccountBalance" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_Accounts"]</MudNavLink>
                    <MudNavLink Href="/reconciliations" Icon="@Icons.Material.Filled.CheckCircle" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_Reconciliations"]</MudNavLink>
                    <MudNavLink Href="/payees" Icon="@Icons.Material.Filled.People" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_Payees"]</MudNavLink>
                    
                    <MudNavGroup Title="@L["Nav_Reports"]" Icon="@Icons.Material.Filled.BarChart" Expanded="false">
                        <MudNavLink Href="/cashflow" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_Cashflow"]</MudNavLink>
                        <MudNavLink Href="/category-spending" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_CategorySpending"]</MudNavLink>
                        <MudNavLink Href="/budget-comparison" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_BudgetVsActual"]</MudNavLink>
                        <MudNavLink Href="/net-worth" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_NetWorth"]</MudNavLink>
                        <MudNavLink Href="/account-balance-history" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_BalanceHistory"]</MudNavLink>
                    </MudNavGroup>
                    
                    <MudNavLink Href="/insights" Icon="@Icons.Material.Filled.Lightbulb" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_Insights"]</MudNavLink>
                    
                    <MudDivider Class="my-2" />
                    
                    <MudNavLink Href="/settings" Icon="@Icons.Material.Outlined.Settings" Match="NavLinkMatch.Prefix" OnClick="@CloseDrawer">@L["Nav_Settings"]</MudNavLink>
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>
    
    <MudMainContent Style="background-color: var(--mb-bg-primary); min-height: calc(100vh - 64px);">
        <AuthorizeView>
            <Authorized>
                <SettingsEnforcer>
                    <LicenseEnforcer>
                        @Body
                    </LicenseEnforcer>
                </SettingsEnforcer>
            </Authorized>
            <NotAuthorized>
                @Body
            </NotAuthorized>
        </AuthorizeView>
    </MudMainContent>
    <Footer />
</MudLayout>

<!-- PWA Install Prompt - Mobile Only -->
@if (_isMobile)
{
    <PwaInstallPrompt />
}

<!-- Tips Button -->
<AuthorizeView>
    <Authorized>
        <TipsButton />
    </Authorized>
</AuthorizeView>

@code {
    private bool _drawerOpen;
    private bool _isMobile;
    private bool _isMobileInitialized;
    
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1DB954",
            Secondary = "#667EEA",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1A202C",
            Background = "#F7FAFC",
            Surface = "#FFFFFF",
            TextPrimary = "#1A202C",
            TextSecondary = "#718096",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#718096",
            DrawerIcon = "#718096",
            Success = "#1DB954",
            Error = "#E53E3E",
            Warning = "#F6AD55",
            Info = "#4299E1"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"]
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px"
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            MobileDetection.OnViewportChanged += HandleViewportChange;
            
            try
            {
                await MobileDetection.InitializeAsync();
                _isMobile = MobileDetection.IsMobile;
                _isMobileInitialized = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Mobile detection initialization failed");
                _isMobileInitialized = true; // Still mark as initialized so CSS takes over
                StateHasChanged();
            }
        }
    }

    private void HandleViewportChange(bool isMobile)
    {
        _isMobile = isMobile;
        _isMobileInitialized = true;
        
        // Close drawer when switching to desktop
        if (!isMobile)
        {
            _drawerOpen = false;
        }
        
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }

    /// <summary>
    /// Returns CSS class for elements that should only be visible on mobile.
    /// </summary>
    private string GetMobileOnlyClass()
    {
        // If JS confirms desktop, hide completely
        if (_isMobileInitialized && !_isMobile)
        {
            return "d-none";
        }
        // Otherwise use CSS media query: visible on xs/sm, hidden on md+
        return "d-md-none";
    }

    /// <summary>
    /// Returns CSS class for elements that should only be visible on desktop.
    /// </summary>
    private string GetDesktopOnlyClass()
    {
        // If JS confirms mobile, hide completely
        if (_isMobileInitialized && _isMobile)
        {
            return "d-none";
        }
        // Otherwise use CSS media query: hidden on xs/sm, visible on md+
        return "d-none d-md-flex";
    }

    public async ValueTask DisposeAsync()
    {
        MobileDetection.OnViewportChanged -= HandleViewportChange;
        
        if (MobileDetection is IAsyncDisposable asyncDisposable)
        {
            await asyncDisposable.DisposeAsync();
        }
    }
}