@implements IDisposable

@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<div class="mb-header-nav ms-6">
    <a href="/dashboard" class="mb-header-nav-link @(IsActive("/dashboard") ? "active" : "")">@L["Nav_Dashboard"]</a>
    <a href="/transactions" class="mb-header-nav-link @(IsActive("/transactions") ? "active" : "")">@L["Nav_Transactions"]</a>
    <a href="/budgets" class="mb-header-nav-link @(IsActive("/budgets") ? "active" : "")">@L["Nav_Budgets"]</a>
    <a href="/tips" class="mb-header-nav-link @(IsActive("/tips") ? "active" : "")">@L["Nav_Tips"]</a>
 
    <a href="/categories" class="mb-header-nav-link @(IsActive("/categories") ? "active" : "")">@L["Nav_Categories"]</a>
    <a href="/reconciliations" class="mb-header-nav-link @(IsActive("/reconciliations") ? "active" : "")">@L["Nav_Reconciliations"]</a>
    <a href="/payees" class="mb-header-nav-link @(IsActive("/payees") ? "active" : "")">@L["Nav_Payees"]</a>

    <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" ActivationEvent="@MouseEvent.MouseOver">
        <ActivatorContent>
            <span class="mb-header-nav-link @(IsActiveInReports() ? "active" : "")" style="cursor: pointer;">@L["Nav_Reports"]</span>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Href="/cashflow">@L["Nav_Cashflow"]</MudMenuItem>
            <MudMenuItem Href="/category-spending">@L["Nav_CategorySpending"]</MudMenuItem>
            <MudMenuItem Href="/budget-comparison">@L["Nav_BudgetVsActual"]</MudMenuItem>
            <MudMenuItem Href="/net-worth">@L["Nav_NetWorth"]</MudMenuItem>
            <MudMenuItem Href="/account-balance-history">@L["Nav_BalanceHistory"]</MudMenuItem>
        </ChildContent>
    </MudMenu>

    <a href="/insights" class="mb-header-nav-link @(IsActive("/insights") ? "active" : "")">@L["Nav_Insights"]</a>

    <a href="/accounts" class="mb-header-nav-link @(IsActive("/accounts") ? "active" : "")">@L["Nav_Accounts"]</a>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private bool IsActive(string path)
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        
        // Handle root/dashboard
        if (path == "/" && string.IsNullOrEmpty(currentPath))
            return true;
        
        // Check if current path starts with the menu path
        return !string.IsNullOrEmpty(currentPath) && 
               currentPath.StartsWith(path.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
    }

    private bool IsActiveInReports()
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var reportPaths = new[] { "cashflow", "category-spending", "budget-comparison", "net-worth", "account-balance-history" };
        
        return !string.IsNullOrEmpty(currentPath) && 
               reportPaths.Any(rp => currentPath.StartsWith(rp, StringComparison.OrdinalIgnoreCase));
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
