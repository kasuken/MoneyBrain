@implements IDisposable

@inject NavigationManager NavigationManager

<div class="mb-header-nav ms-6">
    <a href="/dashboard" class="mb-header-nav-link @(IsActive("/dashboard") ? "active" : "")">Dashboard</a>
    <a href="/accounts" class="mb-header-nav-link @(IsActive("/accounts") ? "active" : "")">Accounts</a>
    <a href="/transactions" class="mb-header-nav-link @(IsActive("/transactions") ? "active" : "")">Transactions</a>
    <a href="/budgets" class="mb-header-nav-link @(IsActive("/budgets") ? "active" : "")">Budgets</a>
    
    <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" ActivationEvent="@MouseEvent.MouseOver">
        <ActivatorContent>
            <span class="mb-header-nav-link @(IsActiveInReports() ? "active" : "")" style="cursor: pointer;">Reports</span>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Href="/cashflow">Monthly Cashflow</MudMenuItem>
            <MudMenuItem Href="/category-spending">Category Spending</MudMenuItem>
            <MudMenuItem Href="/budget-comparison">Budget vs Actual</MudMenuItem>
            <MudMenuItem Href="/net-worth">Net Worth</MudMenuItem>
            <MudMenuItem Href="/account-balance-history">Balance History</MudMenuItem>
        </ChildContent>
    </MudMenu>
    
    <a href="/categories" class="mb-header-nav-link @(IsActive("/categories") ? "active" : "")">Categories</a>
    <a href="/payees" class="mb-header-nav-link @(IsActive("/payees") ? "active" : "")">Payees</a>
    <a href="/reconciliations" class="mb-header-nav-link @(IsActive("/reconciliations") ? "active" : "")">Reconciliations</a>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private bool IsActive(string path)
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        
        // Handle root/dashboard
        if (path == "/" && string.IsNullOrEmpty(currentPath))
            return true;
        
        // Check if current path starts with the menu path
        return !string.IsNullOrEmpty(currentPath) && 
               currentPath.StartsWith(path.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
    }

    private bool IsActiveInReports()
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var reportPaths = new[] { "cashflow", "category-spending", "budget-comparison", "net-worth", "account-balance-history" };
        
        return !string.IsNullOrEmpty(currentPath) && 
               reportPaths.Any(rp => currentPath.StartsWith(rp, StringComparison.OrdinalIgnoreCase));
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
