@inherits LayoutComponentBase
@using MoneyBrain.Web.Services
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Components.Shared
@using MoneyBrain.Web.Application.Tips
@inject NavigationManager NavigationManager
@inject IMobileDetectionService MobileDetection
@inject IStringLocalizer<SharedResource> L
@inject IEducationalTipService EducationalTipService
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <!-- Mobile Top App Bar with Menu -->
    <MudAppBar Elevation="1" Dense="true" Fixed="true" Class="mobile-top-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer"
                       class="hamburger-toggle"
                       aria-label="Open navigation" />
        <div class="mb-logo" style="margin-left: 8px;">
            <div class="mb-logo-icon" style="width: 32px; height: 32px; font-size: 1rem;">M</div>
            <span style="font-size: 1.1rem;">MoneyBrain</span>
        </div>
        <MudSpacer />
        <LanguageSelector />
    </MudAppBar>

    <!-- Navigation Drawer -->
    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="DrawerVariant.Temporary">
        <MudNavMenu>
            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">@L["Nav_Dashboard"]</MudNavLink>
            <MudNavLink Href="/transactions" Icon="@Icons.Material.Filled.List">@L["Nav_Transactions"]</MudNavLink>
            <MudNavLink Href="/budgets" Icon="@Icons.Material.Filled.AccountBalance">@L["Nav_Budgets"]</MudNavLink>
            <MudNavLink Href="/categories" Icon="@Icons.Material.Filled.Category">@L["Nav_Categories"]</MudNavLink>
            <MudNavLink Href="/reconciliations" Icon="@Icons.Material.Filled.CheckCircle">@L["Nav_Reconciliations"]</MudNavLink>
            <MudNavLink Href="/payees" Icon="@Icons.Material.Filled.People">@L["Nav_Payees"]</MudNavLink>
            <MudNavGroup Title="@L["Nav_Reports"]" Icon="@Icons.Material.Filled.BarChart" Expanded="false">
                <MudNavLink Href="/cashflow" Icon="@Icons.Material.Filled.TrendingUp">@L["Nav_Cashflow"]</MudNavLink>
                <MudNavLink Href="/category-spending" Icon="@Icons.Material.Filled.PieChart">@L["Nav_CategorySpending"]</MudNavLink>
                <MudNavLink Href="/budget-comparison" Icon="@Icons.Material.Filled.Compare">@L["Nav_BudgetVsActual"]</MudNavLink>
                <MudNavLink Href="/net-worth" Icon="@Icons.Material.Filled.ShowChart">@L["Nav_NetWorth"]</MudNavLink>
                <MudNavLink Href="/account-balance-history" Icon="@Icons.Material.Filled.History">@L["Nav_BalanceHistory"]</MudNavLink>
            </MudNavGroup>
            <MudNavLink Href="/insights" Icon="@Icons.Material.Filled.Lightbulb">@L["Nav_Insights"]</MudNavLink>
            <MudBadge Content="@_unseenTipsCount" Visible="@(_unseenTipsCount > 0)" Color="Color.Error" Overlap="true" Class="pulse">
                <MudNavLink Href="/tips" Icon="@Icons.Material.Filled.Lightbulb">@L["Nav_Tips"]</MudNavLink>
            </MudBadge>
            <MudNavLink Href="/accounts" Icon="@Icons.Material.Filled.AccountBalanceWallet">@L["Nav_Accounts"]</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/Account/Manage" Icon="@Icons.Material.Outlined.Person">@L["Nav_Profile"]</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">@L["Nav_Settings"]</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <!-- Mobile Bottom Navigation -->
    <MudAppBar Bottom="true" Fixed="true" Elevation="3" Class="mobile-bottom-nav">
        <MudStack Row="true" Justify="Justify.SpaceAround" AlignItems="AlignItems.Center" Style="width: 100%;">
            <MudButton Href="/mobile/transactions" 
                       Variant="Variant.Text" 
                       Color="@(IsActive("/mobile/transactions") ? Color.Primary : Color.Default)"
                       Class="mobile-nav-btn"
                       Style="flex-direction: column; min-width: 80px; height: 56px;">
                <MudIcon Icon="@Icons.Material.Filled.List" />
                <MudText Typo="Typo.caption" Style="margin-top: 2px;">Transactions</MudText>
            </MudButton>
            
            <MudButton Href="/mobile/overview" 
                       Variant="Variant.Text" 
                       Color="@(IsActive("/mobile/overview") ? Color.Primary : Color.Default)"
                       Class="mobile-nav-btn"
                       Style="flex-direction: column; min-width: 80px; height: 56px;">
                <MudIcon Icon="@Icons.Material.Filled.Dashboard" />
                <MudText Typo="Typo.caption" Style="margin-top: 2px;">Overview</MudText>
            </MudButton>
        </MudStack>
    </MudAppBar>

    <!-- Main Content with Top and Bottom Padding for Nav Bars -->
    <MudMainContent Style="background-color: var(--mb-bg-primary); min-height: 100vh; padding-top: 56px; padding-bottom: 72px;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private int _unseenTipsCount;

    private MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#4F46E5",
            Secondary = "#EC4899",
            Success = "#10B981",
            Info = "#3B82F6",
            Warning = "#F59E0B",
            Error = "#EF4444",
            AppbarBackground = "#FFFFFF",
            Background = "#F9FAFB",
            Surface = "#FFFFFF"
        }
    };

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private bool IsActive(string path)
    {
        return NavigationManager.Uri.Contains(path);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await MobileDetection.InitializeAsync();
            await LoadUnseenTipsCountAsync();
            StateHasChanged();
        }
    }

    private async Task LoadUnseenTipsCountAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            
            if (!string.IsNullOrEmpty(userId))
            {
                _unseenTipsCount = await EducationalTipService.GetUnseenTipCountAsync(userId);
            }
        }
        catch
        {
            _unseenTipsCount = 0;
        }
    }
}

<style>
    .mobile-top-bar {
        background-color: white !important;
        border-bottom: 1px solid rgba(0, 0, 0, 0.12);
        color: #1A202C !important;
    }

    .mobile-bottom-nav {
        top: auto !important;
        bottom: 0 !important;
        background-color: white !important;
        border-top: 1px solid rgba(0, 0, 0, 0.12);
        padding: 0 !important;
    }

    .mobile-nav-btn {
        padding: 8px 12px !important;
        text-transform: none !important;
        border-radius: 0 !important;
    }

    .mobile-nav-btn .mud-button-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
    }

    /* Safe area support for devices with notches */
    .mobile-bottom-nav {
        padding-bottom: env(safe-area-inset-bottom) !important;
    }

    /* Ensure touch targets are at least 44px */
    .mobile-nav-btn {
        min-height: 44px;
        min-width: 44px;
    }

    /* Hide the hamburger toggle on narrow screens (mobile) */
    @@media (max-width: 600px) {
        .mobile-top-bar .hamburger-toggle {
            display: none !important;
            visibility: hidden !important;
        }
    }
</style>
