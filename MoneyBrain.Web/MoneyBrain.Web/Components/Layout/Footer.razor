@inject IConfiguration Configuration

<footer class="app-footer">
    <div class="app-footer-content">
        <p>&copy; @DateTime.Now.Year MoneyBrain contributors. Licensed under the <a href="https://www.gnu.org/licenses/agpl-3.0.html" target="_blank" rel="noopener noreferrer">AGPL-3.0</a>.</p>
        <p><a href="@SourceCodeUrl" target="_blank" rel="noopener noreferrer">Source code</a></p>
        <p class="app-footer-version">Version @version</p>
    </div>
</footer>

@code {
    // AGPL-3.0 section 13: users of a network deployment must be offered the corresponding source.
    private string SourceCodeUrl => Configuration["SourceCodeUrl"] is { Length: > 0 } url ? url : "https://github.com/kasuken/MoneyBrain";

    private string version = typeof(Program).Assembly.GetName().Version?.ToString(3) ?? "1.0.0";
}
