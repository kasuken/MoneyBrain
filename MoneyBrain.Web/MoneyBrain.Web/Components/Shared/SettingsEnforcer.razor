@using MoneyBrain.Web.Application.Settings
@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Domain.Entities

@inject IUserSettingsService SettingsService
@inject IAccountService AccountService
@inject ICategoryService CategoryService
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider

@if (_loading)
{
    <MudContainer Class="d-flex justify-center align-center" Style="height: 100vh;">
        <MudProgressCircular Indeterminate Size="Size.Large" />
    </MudContainer>
}
else
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _loading = true;
    private bool _dialogShown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckSettingsAsync();
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task CheckSettingsAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            return;
        }

        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId))
        {
            return;
        }

        var hasSetup = await SettingsService.HasCompletedSetupAsync(userId);
        if (!hasSetup && !_dialogShown)
        {
            _dialogShown = true;
            await ShowSetupDialogAsync(userId);
        }
    }

    private async Task ShowSetupDialogAsync(string userId)
    {
        var parameters = new DialogParameters<SetupWizard>
        {
            { x => x.UserId, userId },
            { x => x.Currencies, SettingsService.GetAvailableCurrencies() },
            { x => x.TimeZones, SettingsService.GetAvailableTimeZones() },
            { x => x.OnSaveSettings, SaveSettingsAsync },
            { x => x.OnCreateAccount, CreateAccountAsync },
            { x => x.OnSeedCategories, SeedCategoriesAsync }
        };

        var options = new DialogOptions
        {
            CloseButton = false,
            BackdropClick = false,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        await DialogService.ShowAsync<SetupWizard>("Setup Wizard", parameters, options);
    }

    private async Task SaveSettingsAsync(string userId, string currencyCode, string timeZoneId, string? dateFormat)
    {
        await SettingsService.SaveSettingsAsync(userId, currencyCode, timeZoneId, dateFormat);
    }

    private async Task<Account> CreateAccountAsync(Account account)
    {
        return await AccountService.CreateAccountAsync(account);
    }

    private async Task SeedCategoriesAsync(string userId)
    {
        await CategoryService.SeedDefaultCategoriesAsync(userId);
    }
}
