@using MoneyBrain.Web.Application.Settings
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<MudDialog Options="@(new DialogOptions { CloseButton = false, BackdropClick = false })">
    <TitleContent>
        <MudText Typo="Typo.h5">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="me-2" />
            @L["SetupDlg_Welcome"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-4">
            @L["SetupDlg_ConfigurePreferences"]
        </MudText>
        
        <MudForm @ref="_form" @bind-IsValid="@_formValid">
            <MudStack Spacing="4">
                <MudSelect T="string"
                           Label="@L["Lbl_Currency"]"
                           @bind-Value="_currencyCode"
                           Required="true"
                           RequiredError="@L["SetupDlg_SelectCurrency"]"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var currency in Currencies)
                    {
                        <MudSelectItem T="string" Value="@currency.Code">
                            @currency.Code - @currency.Name (@currency.Symbol)
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string"
                           Label="@L["SetupDlg_Timezone"]"
                           @bind-Value="_timeZoneId"
                           Required="true"
                           RequiredError="@L["SetupDlg_SelectTimezone"]"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var tz in TimeZones)
                    {
                        <MudSelectItem T="string" Value="@tz.Id">
                            @tz.DisplayName
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string"
                           Label="@L["SetupDlg_DateFormat"]"
                           @bind-Value="_dateFormat"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="string" Value="@("yyyy-MM-dd")">@L["SetupDlg_DateFormatISO"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MM/dd/yyyy")">@L["SetupDlg_DateFormatUS"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("dd/MM/yyyy")">@L["SetupDlg_DateFormatEU"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("dd.MM.yyyy")">@L["SetupDlg_DateFormatDot"]</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveAsync"
                   Disabled="@(!_formValid || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
            }
            @L["Auth_Register"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<CurrencyInfo> Currencies { get; set; } = [];

    [Parameter]
    public IReadOnlyList<TimeZoneInfo> TimeZones { get; set; } = [];

    [Parameter]
    public Func<string, string, string, string?, Task> OnSave { get; set; } = null!;

    private bool _formValid;
    private bool _saving;
    private MudForm? _form;

    private string _currencyCode = "USD";
    private string _timeZoneId = TimeZoneInfo.Local.Id;
    private string _dateFormat = "yyyy-MM-dd";

    private async Task SaveAsync()
    {
        if (_form is null) return;

        await _form.Validate();
        if (!_formValid) return;

        _saving = true;
        try
        {
            await OnSave(UserId, _currencyCode, _timeZoneId, _dateFormat);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _saving = false;
        }
    }
}
