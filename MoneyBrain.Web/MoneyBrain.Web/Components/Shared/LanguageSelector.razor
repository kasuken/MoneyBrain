@inject NavigationManager NavigationManager
@using MoneyBrain.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
    <ActivatorContent>
        <MudIconButton Icon="@Icons.Material.Filled.Language" 
                       Color="Color.Default" 
                       Size="Size.Medium"
                       aria-label="@L["Lang_SelectLanguage"]" />
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem OnClick="@(() => SetCulture("en"))">
            <div class="d-flex align-center gap-2">
                <span>🇬🇧</span>
                <span>English</span>
            </div>
        </MudMenuItem>
        <MudMenuItem OnClick="@(() => SetCulture("it"))">
            <div class="d-flex align-center gap-2">
                <span>🇮🇹</span>
                <span>Italiano</span>
            </div>
        </MudMenuItem>
        <MudMenuItem OnClick="@(() => SetCulture("es"))">
            <div class="d-flex align-center gap-2">
                <span>🇪🇸</span>
                <span>Español</span>
            </div>
        </MudMenuItem>
        <MudMenuItem OnClick="@(() => SetCulture("de"))">
            <div class="d-flex align-center gap-2">
                <span>🇩🇪</span>
                <span>Deutsch</span>
            </div>
        </MudMenuItem>
    </ChildContent>
</MudMenu>

@code {
    private void SetCulture(string culture)
    {
        var uri = new Uri(NavigationManager.Uri);
        var returnUrl = uri.PathAndQuery;
        
        // Navigate to the culture controller to set the cookie
        NavigationManager.NavigateTo($"/Culture/Set?culture={culture}&returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
