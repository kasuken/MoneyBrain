@using MoneyBrain.Web.Application.Settings
@using MoneyBrain.Web.Application.Accounts
@using MoneyBrain.Web.Application.Categories
@using MoneyBrain.Web.Domain.Entities
@using MoneyBrain.Web.Domain.Enums
@using Microsoft.Extensions.Localization
@using MoneyBrain.Web.Resources
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<MudDialog Options="@(new DialogOptions { CloseButton = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <DialogContent>
        <MudStepper @ref="_stepper" 
                    @bind-ActiveIndex="_activeStep"
                    Vertical="false"
                    Class="mb-setup-wizard"
                    ActionContent="@(context => null)">
            
            <!-- Step 1: Welcome -->
            <MudStep Title="@L["Setup_StepWelcome"]" Icon="@Icons.Material.Filled.WavingHand">
                <div class="pa-4">
                    <div class="mb-logo" style="justify-content: center; margin-bottom: 2rem;">
                        <div class="mb-logo-icon" style="width: 64px; height: 64px; font-size: 1.75rem;">M</div>
                    </div>
                    <MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700; color: var(--mb-text-primary);">
                        @L["Setup_Welcome"]
                    </MudText>
                    <MudText Typo="Typo.body1" Style="color: var(--mb-text-secondary); max-width: 500px; margin: 0 auto;">
                        @L["Setup_WelcomeDescription"]
                    </MudText>
                    
                    <MudStack Row="true" Justify="Justify.Center" Class="mt-8" Spacing="6">
                        <div class="text-center">
                            <MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Class="mt-2">@L["Setup_ConfigureSettings"]</MudText>
                        </div>
                        <div class="text-center">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Class="mt-2">@L["Setup_AddAccount"]</MudText>
                        </div>
                        <div class="text-center">
                            <MudIcon Icon="@Icons.Material.Outlined.Category" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Class="mt-2">@L["Setup_SetupCategories"]</MudText>
                        </div>
                    </MudStack>
                    
                    <MudText Typo="Typo.body2" Class="mt-8 text-center" Style="color: var(--mb-text-muted);">
                        @L["Setup_Or"]
                    </MudText>
                    
                    <div class="text-center mt-3">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.AutoAwesome"
                                   OnClick="LoadDemoDataAndCompleteAsync"
                                   Disabled="@_saving"
                                   Size="Size.Medium">
                            @if (_saving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                            }
                            @L["Setup_TryDemoData"]
                        </MudButton>
                    </div>
                </div>
            </MudStep>

            <!-- Step 2: Settings -->
            <MudStep Title="@L["Setup_StepSettings"]" Icon="@Icons.Material.Filled.Settings">
                <div class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">@L["Setup_ConfigurePreferences"]</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mb-text-secondary);">
                        @L["Setup_ConfigurePreferencesDescription"]
                    </MudText>
                    
                    <MudForm @ref="_settingsForm" @bind-IsValid="@_settingsValid">
                        <MudStack Spacing="4">
                            <MudSelect T="string"
                                       Label="@L["Settings_Currency"]"
                                       @bind-Value="_currencyCode"
                                       Required="true"
                                       RequiredError="@L["Val_SelectCurrency"]"
                                       Variant="Variant.Outlined"
                                       AnchorOrigin="Origin.BottomCenter">
                                @foreach (var currency in Currencies)
                                {
                                    <MudSelectItem T="string" Value="@currency.Code">
                                        @currency.Code - @currency.Name (@currency.Symbol)
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudSelect T="string"
                                       Label="@L["Settings_Timezone"]"
                                       @bind-Value="_timeZoneId"
                                       Required="true"
                                       RequiredError="@L["Val_SelectTimezone"]"
                                       Variant="Variant.Outlined"
                                       AnchorOrigin="Origin.BottomCenter">
                                @foreach (var tz in TimeZones)
                                {
                                    <MudSelectItem T="string" Value="@tz.Id">
                                        @tz.DisplayName
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudSelect T="string"
                                       Label="@L["Settings_DateFormat"]"
                                       @bind-Value="_dateFormat"
                                       Variant="Variant.Outlined"
                                       AnchorOrigin="Origin.BottomCenter">
                                <MudSelectItem T="string" Value="@("yyyy-MM-dd")">2025-01-25 (ISO)</MudSelectItem>
                                <MudSelectItem T="string" Value="@("MM/dd/yyyy")">01/25/2025 (US)</MudSelectItem>
                                <MudSelectItem T="string" Value="@("dd/MM/yyyy")">25/01/2025 (EU)</MudSelectItem>
                                <MudSelectItem T="string" Value="@("dd.MM.yyyy")">25.01.2025</MudSelectItem>
                            </MudSelect>
                        </MudStack>
                    </MudForm>
                </div>
            </MudStep>

            <!-- Step 3: First Account -->
            <MudStep Title="@L["Setup_StepFirstAccount"]" Icon="@Icons.Material.Filled.AccountBalance">
                <div class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">@L["Setup_CreateFirstAccount"]</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mb-text-secondary);">
                        @L["Setup_CreateFirstAccountDescription"]
                    </MudText>
                    
                    <MudForm @ref="_accountForm" @bind-IsValid="@_accountValid">
                        <MudStack Spacing="3">
                            <MudTextField @bind-Value="_accountName"
                                          Label="@L["Lbl_AccountName"]"
                                          Required="true"
                                          RequiredError="@L["Val_AccountNameRequired"]"
                                          MaxLength="100"
                                          Variant="Variant.Outlined"
                                          Placeholder="@L["Setup_AccountNamePlaceholder"]" />

                            <MudStack Row="true" Spacing="3">
                                <MudSelect @bind-Value="_accountType"
                                           Label="@L["Lbl_AccountType"]"
                                           Required="true"
                                           Variant="Variant.Outlined"
                                           Style="flex: 1;">
                                    <MudSelectItem Value="@AccountType.Asset">@L["AccountType_Asset"]</MudSelectItem>
                                    <MudSelectItem Value="@AccountType.Liability">@L["AccountType_Liability"]</MudSelectItem>
                                </MudSelect>

                                <MudSelect @bind-Value="_accountSubType"
                                           Label="@L["Lbl_SubType"]"
                                           Required="true"
                                           Variant="Variant.Outlined"
                                           Style="flex: 1;">
                                    @if (_accountType == AccountType.Asset)
                                    {
                                        <MudSelectItem Value="@AccountSubType.Checking">@L["SubType_Checking"]</MudSelectItem>
                                        <MudSelectItem Value="@AccountSubType.Savings">@L["SubType_Savings"]</MudSelectItem>
                                        <MudSelectItem Value="@AccountSubType.Cash">@L["SubType_Cash"]</MudSelectItem>
                                        <MudSelectItem Value="@AccountSubType.Investment">@L["SubType_Investment"]</MudSelectItem>
                                        <MudSelectItem Value="@AccountSubType.OtherAsset">@L["SubType_OtherAsset"]</MudSelectItem>
                                    }
                                    else
                                    {
                                        <MudSelectItem Value="@AccountSubType.CreditCard">@L["SubType_CreditCard"]</MudSelectItem>
                                        <MudSelectItem Value="@AccountSubType.Loan">@L["SubType_Loan"]</MudSelectItem>
                                        <MudSelectItem Value="@AccountSubType.Mortgage">@L["SubType_Mortgage"]</MudSelectItem>
                                        <MudSelectItem Value="@AccountSubType.OtherLiability">@L["SubType_OtherLiability"]</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudStack>

                            <MudNumericField @bind-Value="_openingBalance"
                                             Label="@L["Lbl_CurrentBalance"]"
                                             Variant="Variant.Outlined"
                                             Format="N2"
                                             HelperText="@L["Setup_BalanceHelperText"]" />
                        </MudStack>
                    </MudForm>

                    @if (_createdAccounts.Count > 0)
                    {
                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Setup_AccountsAdded"]:</MudText>
                        <MudStack Spacing="2">
                            @foreach (var account in _createdAccounts)
                            {
                                <MudPaper Class="pa-3 d-flex align-center justify-space-between" Elevation="0" Style="border: 1px solid var(--mb-border);">
                                    <div class="d-flex align-center gap-3">
                                        <MudIcon Icon="@GetAccountIcon(account.SubType)" Color="Color.Primary" />
                                        <div>
                                            <MudText Typo="Typo.body1" Style="font-weight: 500;">@account.Name</MudText>
                                            <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">@account.SubType.ToString()</MudText>
                                        </div>
                                    </div>
                                    <MudText Typo="Typo.body2" Class="@(account.OpeningBalance >= 0 ? "mb-amount positive" : "mb-amount negative")">
                                        @account.OpeningBalance.ToString("C2")
                                    </MudText>
                                </MudPaper>
                            }
                        </MudStack>
                        
                        <MudButton Variant="Variant.Text" 
                                   Color="Color.Primary" 
                                   Class="mt-3"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddAnotherAccount">
                            @L["Setup_AddAnotherAccount"]
                        </MudButton>
                    }
                </div>
            </MudStep>

            <!-- Step 4: Categories -->
            <MudStep Title="@L["Setup_StepCategories"]" Icon="@Icons.Material.Filled.Category">
                <div class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">@L["Setup_SetupCategories"]</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mb-text-secondary);">
                        @L["Setup_CategoriesDescription"]
                    </MudText>
                    
                    <MudPaper Class="pa-4" Elevation="0" Style="border: 1px solid var(--mb-border); border-radius: var(--mb-radius-lg);">
                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3">
                            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Color="Color.Primary" Size="Size.Large" />
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@L["Setup_DefaultCategories"]</MudText>
                                <MudText Typo="Typo.body2" Style="color: var(--mb-text-secondary);">
                                    @L["Setup_DefaultCategoriesDescription"]
                                </MudText>
                                
                                <MudStack Row="true" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@L["Cat_Housing"]</MudChip>
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@L["Cat_Transportation"]</MudChip>
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@L["Cat_FoodDining"]</MudChip>
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@L["Cat_Utilities"]</MudChip>
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@L["Cat_Shopping"]</MudChip>
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@L["Cat_Entertainment"]</MudChip>
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@L["Cat_Healthcare"]</MudChip>
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@L["Cat_Income"]</MudChip>
                                    <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">@L["Setup_PlusMore"]</MudChip>
                                </MudStack>
                            </div>
                        </MudStack>
                    </MudPaper>
                    
                    <MudAlert Severity="Severity.Info" Class="mt-4" Dense="true">
                        <MudText Typo="Typo.body2">
                            @L["Setup_CategoriesCustomizeHint"]
                        </MudText>
                    </MudAlert>
                </div>
            </MudStep>

            <!-- Step 5: Complete -->
            <MudStep Title="@L["Setup_StepComplete"]" Icon="@Icons.Material.Filled.CheckCircle">
                <div class="text-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" 
                             Color="Color.Success" 
                             Style="font-size: 80px;" 
                             Class="mb-4" />
                    
                    <MudText Typo="Typo.h4" Class="mb-2" Style="font-weight: 700; color: var(--mb-text-primary);">
                        @L["Setup_AllSet"]
                    </MudText>
                    <MudText Typo="Typo.body1" Class="mb-6" Style="color: var(--mb-text-secondary);">
                        @L["Setup_Summary"]
                    </MudText>
                    
                    <MudPaper Class="pa-4 text-left" Elevation="0" Style="border: 1px solid var(--mb-border); border-radius: var(--mb-radius-lg); max-width: 400px; margin: 0 auto;">
                        <MudStack Spacing="3">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Outlined.Payments" Color="Color.Primary" />
                                <div>
                                    <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">@L["Settings_Currency"]</MudText>
                                    <MudText Typo="Typo.body1">@GetCurrencyDisplay()</MudText>
                                </div>
                            </div>
                            
                            <MudDivider />
                            
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Color="Color.Primary" />
                                <div>
                                    <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">@L["Settings_Timezone"]</MudText>
                                    <MudText Typo="Typo.body1">@GetTimezoneDisplay()</MudText>
                                </div>
                            </div>
                            
                            <MudDivider />
                            
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" Color="Color.Primary" />
                                <div>
                                    <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">@L["Nav_Accounts"]</MudText>
                                    <MudText Typo="Typo.body1">@L["Setup_AccountsCreated", _createdAccounts.Count]</MudText>
                                </div>
                            </div>
                            
                            <MudDivider />
                            
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Outlined.Category" Color="Color.Primary" />
                                <div>
                                    <MudText Typo="Typo.caption" Style="color: var(--mb-text-muted);">@L["Nav_Categories"]</MudText>
                                    <MudText Typo="Typo.body1">@L["Setup_CategoriesReady"]</MudText>
                                </div>
                            </div>
                        </MudStack>
                    </MudPaper>
                </div>
            </MudStep>
        </MudStepper>
    </DialogContent>
    <DialogActions>
        <MudStack Row="true" Justify="Justify.SpaceBetween" Style="width: 100%;" Class="px-2">
            <div>
                @if (_activeStep > 0 && _activeStep < 5)
                {
                    <MudButton OnClick="PreviousStepAsync"
                               Variant="Variant.Text"
                               Disabled="@_saving">
                        @L["Btn_Back"]
                    </MudButton>
                }
            </div>
            <div>
                @if (_activeStep == 4)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="mb-btn-primary"
                               OnClick="CompleteSetupAsync"
                               Disabled="@_saving">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                        }
                        @L["Setup_GetStarted"]
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="mb-btn-primary"
                               OnClick="NextStepAsync"
                               Disabled="@_saving">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate Class="me-2" />
                        }
                        @GetNextButtonText()
                    </MudButton>
                }
            </div>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<CurrencyInfo> Currencies { get; set; } = [];

    [Parameter]
    public IReadOnlyList<TimeZoneInfo> TimeZones { get; set; } = [];

    [Parameter]
    public Func<string, string, string, string?, Task> OnSaveSettings { get; set; } = null!;

    [Parameter]
    public Func<Account, Task<Account>> OnCreateAccount { get; set; } = null!;

    [Parameter]
    public Func<string, Task> OnSeedCategories { get; set; } = null!;

    [Parameter]
    public Func<string, Task> OnLoadDemoData { get; set; } = null!;

    private MudStepper? _stepper;
    private int _activeStep;
    private bool _saving;

    // Settings form
    private MudForm? _settingsForm;
    private bool _settingsValid;
    private string _currencyCode = "USD";
    private string _timeZoneId = TimeZoneInfo.Local.Id;
    private string _dateFormat = "yyyy-MM-dd";

    // Account form
    private MudForm? _accountForm;
    private bool _accountValid;
    private string _accountName = string.Empty;
    private AccountType _accountType = AccountType.Asset;
    private AccountSubType _accountSubType = AccountSubType.Checking;
    private decimal _openingBalance;
    private List<Account> _createdAccounts = new();
    private bool _addingAnother;
    private bool _categoriesSeeded = false;

    private string GetNextButtonText()
    {
        return _activeStep switch
        {
            0 => L["Setup_LetsGo"],
            1 => L["Btn_Continue"],
            2 => _createdAccounts.Count == 0 ? L["Setup_CreateAccount"] : L["Btn_Continue"],
            3 => L["Setup_FinishSetup"],
            _ => L["Btn_Next"]
        };
    }

    private Task PreviousStepAsync()
    {
        if (_activeStep > 0)
        {
            _activeStep--;
        }
        return Task.CompletedTask;
    }

    private async Task NextStepAsync()
    {
        // Validate settings form on step 1
        if (_activeStep == 1)
        {
            if (_settingsForm != null)
            {
                await _settingsForm.Validate();
                if (!_settingsValid) return;
            }
        }

        // Handle account creation on step 2
        if (_activeStep == 2)
        {
            // Save unsaved account data if form has data
            if (!string.IsNullOrWhiteSpace(_accountName))
            {
                await CreateAccountAsync();
            }
            
            // Validate at least one account exists before proceeding
            if (_createdAccounts.Count == 0)
            {
                Console.WriteLine("ERROR: Please create at least one account before continuing.");
                return;
            }
        }

        // Seed categories when moving to step 4
        if (_activeStep == 3 && !_categoriesSeeded)
        {
            _saving = true;
            try
            {
                await OnSeedCategories(UserId);
                _categoriesSeeded = true;
                Console.WriteLine("Categories seeded successfully");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error seeding categories: {ex.Message}");
                throw;
            }
            finally
            {
                _saving = false;
            }
        }

        _activeStep++;
    }

    private async Task CreateAccountAsync()
    {
        if (string.IsNullOrWhiteSpace(_accountName)) return;

        _saving = true;
        try
        {
            var account = new Account
            {
                UserId = UserId,
                Name = _accountName,
                Type = _accountType,
                SubType = _accountSubType,
                OpeningBalance = _openingBalance,
                IsActive = true
            };

            var created = await OnCreateAccount(account);
            _createdAccounts.Add(created);
            Console.WriteLine($"Account created: {created.Name}");
            
            // Reset form for another account
            ResetAccountForm();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating account: {ex.Message}");
            throw;
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetAccountForm()
    {
        _accountName = string.Empty;
        _accountType = AccountType.Asset;
        _accountSubType = AccountSubType.Checking;
        _openingBalance = 0;
        _accountValid = false;
        _addingAnother = false;
    }

    private void AddAnotherAccount()
    {
        _addingAnother = true;
        ResetAccountForm();
    }

    private async Task CompleteSetupAsync()
    {
        _saving = true;
        try
        {
            Console.WriteLine($"Completing setup for user {UserId}");
            Console.WriteLine($"Accounts created: {_createdAccounts.Count}");
            Console.WriteLine($"Settings: Currency={_currencyCode}, Timezone={_timeZoneId}, DateFormat={_dateFormat}");
            
            // Save settings (this marks setup as complete)
            await OnSaveSettings(UserId, _currencyCode, _timeZoneId, _dateFormat);
            
            Console.WriteLine("Settings saved successfully, closing wizard");
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error completing setup: {ex.Message}");
            // Re-throw to show error to user
            throw;
        }
        finally
        {
            _saving = false;
        }
    }

    private string GetCurrencyDisplay()
    {
        var currency = Currencies.FirstOrDefault(c => c.Code == _currencyCode);
        return currency != null ? $"{currency.Code} - {currency.Name}" : _currencyCode;
    }

    private string GetTimezoneDisplay()
    {
        var tz = TimeZones.FirstOrDefault(t => t.Id == _timeZoneId);
        return tz?.DisplayName ?? _timeZoneId;
    }

    private string GetAccountIcon(AccountSubType subType)
    {
        return subType switch
        {
            AccountSubType.Checking => Icons.Material.Outlined.AccountBalance,
            AccountSubType.Savings => Icons.Material.Outlined.Savings,
            AccountSubType.Cash => Icons.Material.Outlined.Payments,
            AccountSubType.Investment => Icons.Material.Outlined.TrendingUp,
            AccountSubType.CreditCard => Icons.Material.Outlined.CreditCard,
            AccountSubType.Loan => Icons.Material.Outlined.Receipt,
            AccountSubType.Mortgage => Icons.Material.Outlined.Home,
            _ => Icons.Material.Outlined.AccountBalanceWallet
        };
    }

    private async Task LoadDemoDataAndCompleteAsync()
    {
        _saving = true;
        try
        {
            // Load demo data (creates accounts, categories, transactions, etc.)
            await OnLoadDemoData(UserId);
            
            // Save default settings to mark setup as complete
            await OnSaveSettings(UserId, "USD", TimeZoneInfo.Local.Id, "yyyy-MM-dd");
            
            // Redirect to homepage with full refresh to show loaded data
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            _saving = false;
        }
    }
}
