@page "/pricing"
@layout MarketingLayout

<PageTitle>Pricing | MoneyBrain</PageTitle>

<!-- Hero -->
<section class="marketing-hero">
    <div class="marketing-hero-content">
        <h1>Simple pricing, <span class="highlight">complete freedom</span></h1>
        <p>MoneyBrain is free and open source. Self-host it on your own infrastructure and own your financial data forever.</p>
    </div>
</section>

<!-- Pricing Cards -->
<section class="marketing-pricing">
    <div class="marketing-container">
        <div class="marketing-pricing-cards">
            <div class="marketing-pricing-card featured">
                <h3>Self-Hosted</h3>
                <div class="price">Free<span> / forever</span></div>
                <p>Deploy on your own server with complete control</p>
                <ul>
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="MudBlazor.Size.Small" />
                        Unlimited accounts
                    </li>
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="MudBlazor.Size.Small" />
                        Unlimited transactions
                    </li>
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="MudBlazor.Size.Small" />
                        All features included
                    </li>
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="MudBlazor.Size.Small" />
                        Complete data ownership
                    </li>
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="MudBlazor.Size.Small" />
                        No telemetry or tracking
                    </li>
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="MudBlazor.Size.Small" />
                        Community support
                    </li>
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="MudBlazor.Size.Small" />
                        Open source code
                    </li>
                </ul>
                <MudButton Variant="Variant.Filled" Class="mb-btn-primary" FullWidth="true" Href="/Account/Register">
                    Get Started
                </MudButton>
            </div>
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="marketing-features">
    <div class="marketing-container">
        <div class="marketing-section-header">
            <h2>Frequently Asked Questions</h2>
        </div>
        
        <div class="marketing-about-content" style="max-width: 800px; margin: 0 auto;">
            <MudExpansionPanels Elevation="0" Style="border: 1px solid var(--mb-border); border-radius: var(--mb-radius-lg);">
                <MudExpansionPanel Text="Is MoneyBrain really free?">
                    <p style="color: var(--mb-text-secondary); line-height: 1.6;">
                        Yes! MoneyBrain is 100% free and open source. You can self-host it on your own server, 
                        a Raspberry Pi, or any cloud provider. There are no premium tiers, subscriptions, or hidden costs.
                    </p>
                </MudExpansionPanel>
                
                <MudExpansionPanel Text="What do I need to run MoneyBrain?">
                    <p style="color: var(--mb-text-secondary); line-height: 1.6;">
                        MoneyBrain runs on .NET 10 and uses SQLite by default. You can run it on Windows, macOS, 
                        or Linux. A basic server with 1GB RAM is enough for personal use.
                    </p>
                </MudExpansionPanel>
                
                <MudExpansionPanel Text="Does MoneyBrain sync with my bank?">
                    <p style="color: var(--mb-text-secondary); line-height: 1.6;">
                        Not automatically. This is by design—we don't connect to external services to maintain 
                        your privacy. You can import transactions via CSV from your bank's export feature.
                    </p>
                </MudExpansionPanel>
                
                <MudExpansionPanel Text="Is my data secure?">
                    <p style="color: var(--mb-text-secondary); line-height: 1.6;">
                        Your data never leaves your server. There's no cloud sync, no analytics, and no third-party 
                        access. You can optionally enable database encryption for additional security.
                    </p>
                </MudExpansionPanel>
                
                <MudExpansionPanel Text="Can multiple people use it?">
                    <p style="color: var(--mb-text-secondary); line-height: 1.6;">
                        MoneyBrain is designed for single-user or small household use. Each user has their own 
                        account with separate data. Multi-entity accounting is not currently supported.
                    </p>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="marketing-cta">
    <div class="marketing-container">
        <h2>Start your journey to financial clarity</h2>
        <p>No credit card required. No strings attached. Just you and your finances.</p>
        <MudButton Variant="Variant.Filled" Class="mb-btn-primary" Size="MudBlazor.Size.Large" Href="/Account/Register">
            Create Your Account
        </MudButton>
    </div>
</section>
