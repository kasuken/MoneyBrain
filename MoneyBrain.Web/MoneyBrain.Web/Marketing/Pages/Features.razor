@page "/features"
@layout MarketingLayout

<PageTitle>Features | MoneyBrain</PageTitle>

<!-- Hero -->
<section class="marketing-hero">
    <div class="marketing-hero-content">
        <h1>Everything you need to <span class="highlight">master your money</span></h1>
        <p>MoneyBrain gives you complete control over your finances with powerful features designed for clarity, security, and simplicity.</p>
    </div>
</section>

<!-- Core Features -->
<section class="marketing-features">
    <div class="marketing-container">
        <div class="marketing-section-header">
            <h2>Core Features</h2>
            <p>Built for people who want control without complexity</p>
        </div>
        
        <div class="marketing-features-grid">
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Multi-Account Management</h3>
                <p>Track bank accounts, credit cards, investments, loans, and more. Organize with custom groups and see your complete financial picture in one place.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Category" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Smart Categorization</h3>
                <p>Organize transactions with flexible categories and groups. Create rules to automatically categorize recurring expenses and income.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Savings" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Envelope Budgeting</h3>
                <p>Assign every dollar a job with monthly envelope budgets. Track planned vs actual spending and optionally roll over unused funds.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Transfer Tracking</h3>
                <p>First-class support for transfers between accounts. Automatically links entries and excludes from income/expense calculations.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Rule" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Automation Rules</h3>
                <p>Create deterministic rules for transaction matching. Preview changes before applying and never worry about reconciled data.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Bank Reconciliation</h3>
                <p>Match your records with bank statements. Lock reconciled transactions to maintain an accurate audit trail.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Powerful Reports</h3>
                <p>Visualize cash flow, spending by category, budget performance, and net worth over time. Export to CSV anytime.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Upload" Size="MudBlazor.Size.Large" />
                </div>
                <h3>CSV Import</h3>
                <p>Import transactions from any bank with flexible column mapping. Preview transformations before committing.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Privacy First</h3>
                <p>Self-hosted by design. Your data stays on your server with no telemetry, no cloud sync, and no third-party access.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="marketing-cta">
    <div class="marketing-container">
        <h2>Ready to take control?</h2>
        <p>Start managing your finances with complete privacy and control.</p>
        <MudButton Variant="Variant.Filled" Class="mb-btn-primary" Size="MudBlazor.Size.Large" Href="/Account/Register">
            Get Started Free
        </MudButton>
    </div>
</section>
