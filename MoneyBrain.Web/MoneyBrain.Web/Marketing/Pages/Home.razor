@page "/"
@using Microsoft.AspNetCore.Components.Web
@layout MarketingLayout

@attribute [ExcludeFromInteractiveRouting]

<PageTitle>MoneyBrain - Personal Finance Made Simple</PageTitle>

@* SEO Meta Tags *@
<HeadContent>
    <meta name="description" content="MoneyBrain is a lightweight, self-hosted personal finance app focused on correctness, predictability, and data ownership." />
    <meta name="keywords" content="personal finance, budgeting, money management, self-hosted, privacy" />
</HeadContent>

<!-- Hero Section -->
<section class="marketing-hero">
    <div class="marketing-container">
        <div class="marketing-hero-content">
        <h1>Take Control of Your<br /><span class="highlight">Financial Future</span></h1>
        <p>MoneyBrain is a lightweight, self-hosted personal finance app focused on correctness, predictability, and complete data ownership.</p>
        <div class="marketing-hero-buttons">
            <MudButton Variant="Variant.Filled" Class="mb-btn-primary" Size="MudBlazor.Size.Large" Href="/Account/Register">
                Get Started Free
            </MudButton>
            <MudButton Variant="Variant.Outlined" Class="mb-btn-outline" Size="MudBlazor.Size.Large" Href="/Account/Login">
                Sign In
            </MudButton>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="marketing-features">
    <div class="marketing-container">
        <div class="marketing-section-header">
            <h2>Everything You Need</h2>
            <p>Powerful features designed to give you complete control over your finances.</p>
        </div>
        
        <div class="marketing-features-grid">
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Multiple Accounts</h3>
                <p>Track bank accounts, credit cards, cash, investments, and loans all in one place.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Detailed Reports</h3>
                <p>Visualize your spending patterns with beautiful charts and insightful reports.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="MudBlazor.Size.Large" />
                </div>
                <h3>100% Private</h3>
                <p>Self-hosted and privacy-first. Your financial data never leaves your control.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Savings" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Smart Budgeting</h3>
                <p>Envelope-style monthly budgets that help you plan and control spending.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="MudBlazor.Size.Large" />
                </div>
                <h3>Reconciliation</h3>
                <p>Match your records with bank statements for perfect accuracy.</p>
            </div>
            
            <div class="marketing-feature-card">
                <div class="marketing-feature-icon">
                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="MudBlazor.Size.Large" />
                </div>
                <h3>CSV Import/Export</h3>
                <p>Easily import transactions from your bank or export for backup.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="marketing-cta">
    <div class="marketing-container">
        <h2>Ready to Take Control?</h2>
        <p>Join thousands of users who trust MoneyBrain for their personal finances.</p>
        <MudButton Variant="Variant.Filled" Class="mb-btn-primary" Size="MudBlazor.Size.Large" Href="/Account/Register">
            Start Your Free Account
        </MudButton>
    </div>
</section>
