@page "/about"
@layout Layout.MarketingLayout

<PageTitle>About - MoneyBrain</PageTitle>
<HeadContent>
    <meta name="description" content="Learn about MoneyBrain's mission: helping individuals take control of their finances with a lightweight, self-hosted, privacy-first personal finance system." />
    <meta name="keywords" content="about MoneyBrain, personal finance philosophy, self-hosted finance, privacy-first budgeting" />
    <meta property="og:title" content="About - MoneyBrain" />
    <meta property="og:description" content="Learn about MoneyBrain's mission and philosophy." />
</HeadContent>

<!-- Hero -->
<section class="hero-section py-5">
    <div class="container text-center">
        <h1 class="display-4 fw-bold mb-3">About MoneyBrain</h1>
        <p class="lead">A tool built for people who care about their data.</p>
    </div>
</section>

<!-- Mission -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 class="fw-bold mb-4">Our Mission</h2>
                <p class="lead">
                    Personal finance tools fall into two broken categories:
                </p>
                <div class="row g-4 my-4">
                    <div class="col-md-6">
                        <div class="card border-danger h-100">
                            <div class="card-body">
                                <h5 class="card-title text-danger">📊 Spreadsheets</h5>
                                <p class="card-text text-muted">
                                    Flexible but fragile, manual, and error-prone. One wrong formula and your entire budget is wrong.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-warning h-100">
                            <div class="card-body">
                                <h5 class="card-title text-warning">☁️ SaaS Finance Apps</h5>
                                <p class="card-text text-muted">
                                    Opaque, subscription-based, privacy-invasive, and often over-scoped with features you don't need.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="lead">
                    MoneyBrain exists because we believe there should be a third option: a <strong>lightweight, self-hosted solution</strong> 
                    that combines budgeting and proper bookkeeping without turning into enterprise accounting software.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Core Values -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Core Principles</h2>
            <p class="text-muted">The values that guide every decision we make</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="display-4 mb-3">🏠</div>
                        <h4 class="fw-bold">Self-Hosted by Default</h4>
                        <p class="text-muted mb-0">
                            Your financial data is yours. It should live where you decide, not on someone else's servers.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="display-4 mb-3">👤</div>
                        <h4 class="fw-bold">Single User Focus</h4>
                        <p class="text-muted mb-0">
                            Designed for individuals and small households, not enterprises or accountants managing multiple clients.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="display-4 mb-3">✅</div>
                        <h4 class="fw-bold">Correctness Over Cleverness</h4>
                        <p class="text-muted mb-0">
                            We prioritize getting the math right over fancy features. Your balance should always be correct.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="display-4 mb-3">🎯</div>
                        <h4 class="fw-bold">Predictable Behavior</h4>
                        <p class="text-muted mb-0">
                            Rules run the same way every time. No surprises, no hidden logic, no AI guessing what you meant.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="display-4 mb-3">📊</div>
                        <h4 class="fw-bold">Minimal UI, Data First</h4>
                        <p class="text-muted mb-0">
                            We focus on showing you your data clearly, not on flashy dashboards that hide the numbers.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="display-4 mb-3">🔒</div>
                        <h4 class="fw-bold">Privacy Without Compromise</h4>
                        <p class="text-muted mb-0">
                            No telemetry, no analytics, no external data transmission. Your finances are private.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- What We Don't Do -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 class="fw-bold mb-4 text-center">What MoneyBrain Doesn't Do</h2>
                <p class="text-muted text-center mb-4">
                    These are explicit non-goals. We believe focus is a feature.
                </p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <span class="text-danger me-2">✗</span>
                            <span>Bank syncing / PSD2 integrations</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <span class="text-danger me-2">✗</span>
                            <span>Invoicing or accounts receivable</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <span class="text-danger me-2">✗</span>
                            <span>Payroll management</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <span class="text-danger me-2">✗</span>
                            <span>Tax filing or optimization</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <span class="text-danger me-2">✗</span>
                            <span>AI-generated financial advice</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <span class="text-danger me-2">✗</span>
                            <span>Multi-entity accounting</span>
                        </div>
                    </div>
                </div>
                <p class="text-muted mt-4 text-center">
                    <em>MoneyBrain is a tool, not a financial advisor.</em>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Open Source -->
<section class="py-5 bg-light">
    <div class="container text-center">
        <h2 class="fw-bold mb-4">Open Source</h2>
        <p class="lead text-muted mb-4">
            MoneyBrain is open source. You can inspect the code, contribute improvements, or fork it for your own needs.
        </p>
        <a href="#" class="btn btn-dark btn-lg px-4">
            <span class="me-2">⭐</span> View on GitHub
        </a>
    </div>
</section>

<!-- CTA -->
<section class="cta-section text-center">
    <div class="container">
        <h2 class="display-5 fw-bold mb-4">Ready to Take Control?</h2>
        <p class="lead mb-4">Join thousands of people managing their finances the right way.</p>
        <a href="/Account/Register" class="btn btn-light btn-lg px-5">Get Started Free</a>
    </div>
</section>
