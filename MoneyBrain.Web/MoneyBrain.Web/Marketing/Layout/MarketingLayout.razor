@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="marketing-layout">
    <!-- Header -->
    <header class="marketing-header">
        <div class="marketing-header-container">
            <a href="/" class="marketing-logo">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="MudBlazor.Size.Large" />
                <span>MoneyBrain</span>
            </a>
            <nav class="marketing-nav">
                <NavLink href="/features" Match="NavLinkMatch.All">Features</NavLink>
                <NavLink href="/pricing" Match="NavLinkMatch.All">Pricing</NavLink>
                <NavLink href="/about" Match="NavLinkMatch.All">About</NavLink>
            </nav>
            <div class="marketing-auth-buttons">
                <AuthorizeView>
                    <Authorized>
                        <MudButton Variant="Variant.Filled" Class="mb-btn-primary" Href="/dashboard">
                            Go to Dashboard
                        </MudButton>
                    </Authorized>
                    <NotAuthorized>
                        <MudButton Variant="Variant.Text" Href="/Account/Login">Sign In</MudButton>
                        <MudButton Variant="Variant.Filled" Class="mb-btn-primary" Href="/Account/Register">
                            Get Started
                        </MudButton>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="marketing-main">
        @Body
    </main>

    <!-- Footer -->
    <footer class="marketing-footer">
        <div class="marketing-footer-container">
            <div class="marketing-footer-grid">
                <div class="marketing-footer-brand">
                    <div class="marketing-logo">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" />
                        <span>MoneyBrain</span>
                    </div>
                    <p>Take control of your finances with a self-hosted, privacy-first personal finance system.</p>
                </div>
                <div class="marketing-footer-links">
                    <h4>Product</h4>
                    <a href="/features">Features</a>
                    <a href="/pricing">Pricing</a>
                    <a href="https://github.com" target="_blank">Source Code</a>
                </div>
                <div class="marketing-footer-links">
                    <h4>Resources</h4>
                    <a href="/about">About</a>
                    <a href="https://github.com" target="_blank">Documentation</a>
                    <a href="https://github.com" target="_blank">Community</a>
                </div>
            </div>
            <div class="marketing-footer-bottom">
                <p>&copy; @DateTime.Now.Year MoneyBrain. Self-hosted. Privacy-first.</p>
            </div>
        </div>
    </footer>
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1DB954",
            Secondary = "#6C63FF",
            Background = "#FFFFFF",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1A1D21",
            TextPrimary = "#1A1D21",
            TextSecondary = "#718096"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "Segoe UI", "Roboto", "sans-serif"]
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px"
        }
    };
}
